/*
========================================================================================
    iProteomes
========================================================================================
    Versioned reference proteomes with hosted indices, modelled on nf-core conf/igenomes.config.
    Select one with --proteome <key>; --iproteomes_base is the root of the store (no default).
    Paths are relative to --iproteomes_base. Per entry:
      organism        organism for the SDRF bookkeeping
      fasta           protein FASTA (UniProt reviewed proteome with isoforms)
      fragpipe_fasta  optional FASTA with rev_ decoys and contaminants (Philosopher database --custom --contam), searched as given
      diann_speclib   optional DIA-NN predicted spectral library of fasta
      <key>/meta.json under --iproteomes_base records the settings diann_speclib was built with; the library is used only when the run's settings equal them
    An entry that declares an index whose path is empty or missing stops the run.
    Override with --database / --diann_speclib; disable with --iproteomes_ignore.
========================================================================================
*/

params {
    iproteomes {
        'human_uniprot_reviewed_2026_03' {
            organism       = 'Homo sapiens'
            fasta          = 'human_uniprot_reviewed_2026_03/fasta/human_uniprot_reviewed_2026_03.fasta'
            fragpipe_fasta = 'human_uniprot_reviewed_2026_03/fragpipe/human_uniprot_reviewed_2026_03_decoys_contam.fasta'
            diann_speclib  = 'human_uniprot_reviewed_2026_03/diann/human_uniprot_reviewed_2026_03.predicted.speclib'
        }
        'mouse_uniprot_reviewed_2026_03' {
            organism       = 'Mus musculus'
            fasta          = 'mouse_uniprot_reviewed_2026_03/fasta/mouse_uniprot_reviewed_2026_03.fasta'
            fragpipe_fasta = 'mouse_uniprot_reviewed_2026_03/fragpipe/mouse_uniprot_reviewed_2026_03_decoys_contam.fasta'
            diann_speclib  = 'mouse_uniprot_reviewed_2026_03/diann/mouse_uniprot_reviewed_2026_03.predicted.speclib'
        }
        'yeast_uniprot_reviewed_2026_03' {
            organism       = 'Saccharomyces cerevisiae'
            fasta          = 'yeast_uniprot_reviewed_2026_03/fasta/yeast_uniprot_reviewed_2026_03.fasta'
            fragpipe_fasta = 'yeast_uniprot_reviewed_2026_03/fragpipe/yeast_uniprot_reviewed_2026_03_decoys_contam.fasta'
            diann_speclib  = 'yeast_uniprot_reviewed_2026_03/diann/yeast_uniprot_reviewed_2026_03.predicted.speclib'
        }
    }
}
