/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    // Default: the lower-cased process name (first word of an alias). It applies to TDF2MZML,
    // MZMLINDEXING (mzml/), OPENMSPEAKPICKER (openms/), MSSTATS, IQ, DIATRACER, FPOP and METAPROTEOMICS;
    // every other process has its own block below (docs/output.md lists them all).
    // The FragPipe license acceptance marker the FragPipe modules emit is not a result: it is never published.
    publishDir = [
        path: {
            def name = task.process.tokenize(':')[-1]
            "${params.outdir}/${[MZMLINDEXING: 'mzml', OPENMSPEAKPICKER: 'openms'].get(name, name.tokenize('_')[0].toLowerCase())}"
        },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename in ['versions.yml', 'I_AGREE_FRAGPIPE_LICENSE_AGREEMENT'] ? null : filename }
    ]

    // ======================================================================
    // DIA workflow publishDir configs
    // ======================================================================

    // DECOMPRESS: the decompressed spectra are copies of the inputs, not results; only the decompression
    // log is published (as mzml/*.log for THERMORAWFILEPARSER)
    withName: '(.*:)?DECOMPRESS' {
        publishDir = [
            path: { "${params.outdir}/decompress" },
            mode: params.publish_dir_mode,
            pattern: '*.log'
        ]
    }

    // mzML named after the .raw file (default: meta.id = sample), so the DIA-NN run names match the
    // SDRF comment[data file] runs the qpx export checks against
    withName: '.*:THERMORAWFILEPARSER' {
        ext.args = '--format 2'
        ext.prefix = { raw.baseName }
        publishDir = [
            path: { "${params.outdir}/mzml" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*DIANN_INSILICOLIBRARYGENERATION' {
        publishDir = [
            path: { "${params.outdir}/proteome/diann" },
            enabled: params.save_reference,
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*DIANN_PRELIMINARYANALYSIS' {
        publishDir = [
            path: { "${params.outdir}/diann/preliminary_analysis" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*DIANN_ASSEMBLEEMPIRICALLIBRARY' {
        publishDir = [
            path: { "${params.outdir}/diann/empirical_library" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*DIANN_INDIVIDUALANALYSIS' {
        publishDir = [
            path: { "${params.outdir}/diann/individual_analysis" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*DIANN_FINALQUANTIFICATION' {
        publishDir = [
            path: { "${params.outdir}/diann/diann_quantification" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'QUANTMSUTILS_MZMLSTATISTICS' {
        publishDir = [
            path: { "${params.outdir}/quantmsutils/mzml_statistics" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'QUANTMSUTILS_DIANN2MZTAB' {
        publishDir = [
            path: { "${params.outdir}/quantmsutils/mztab" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'QUANTMSUTILS_DIANNCFG' {
        publishDir = [
            path: { "${params.outdir}/quantmsutils/config" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ======================================================================
    // DIA-NN workflow process configs (--mode diann)
    // ======================================================================

    // DIANN_INSILICOLIBRARYGENERATION - In-silico library generation
    // What makes this "In-Silico Library Generation":
    //   - Input: FASTA file + enzyme/modification config (from meta.config)
    //   - Key flags: --fasta-search --predictor --gen-spec-lib --met-excision --rt-profiling
    //   - Output: *.predicted.speclib (predicted spectral library from sequences)
    //   - No MS data input required at this stage
    withName: 'DIANN_INSILICOLIBRARYGENERATION' {
        ext.args = {[
            meta.config ?: '',
            params.diann_min_pr_mz ? "--min-pr-mz ${params.diann_min_pr_mz}" : '',
            params.diann_max_pr_mz ? "--max-pr-mz ${params.diann_max_pr_mz}" : '',
            params.diann_min_fr_mz ? "--min-fr-mz ${params.diann_min_fr_mz}" : '',
            params.diann_max_fr_mz ? "--max-fr-mz ${params.diann_max_fr_mz}" : '',
            params.allowed_missed_cleavages != null ? "--missed-cleavages ${params.allowed_missed_cleavages}" : '',
            params.min_peptide_length ? "--min-pep-len ${params.min_peptide_length}" : '',
            params.max_peptide_length ? "--max-pep-len ${params.max_peptide_length}" : '',
            params.min_precursor_charge ? "--min-pr-charge ${params.min_precursor_charge}" : '',
            params.max_precursor_charge ? "--max-pr-charge ${params.max_precursor_charge}" : '',
            params.max_mods != null ? "--var-mods ${params.max_mods}" : '',
            params.diann_library_mass_acc ? "--mass-acc ${params.diann_library_mass_acc}" : '',
            params.diann_library_ms1_acc ? "--mass-acc-ms1 ${params.diann_library_ms1_acc}" : '',
            params.diann_debug ? "--verbose ${params.diann_debug}" : '',
            "--fasta-search",
            "--predictor",
            "--gen-spec-lib",
            "--rt-profiling",
            params.met_excision ? "--met-excision" : '',
            params.additional_insilico_args ?: ''
        ].findAll { arg -> arg != '' }.join(' ').trim()}
    }

    // DIANN_PRELIMINARYANALYSIS - Preliminary analysis
    // What makes this "Preliminary Analysis":
    //   - Input: Individual MS files + predicted spectral library
    //   - Key flags: --quick-mass-acc (fast mass accuracy estimation), performance mode flags
    //   - NO --individual-mass-acc or --individual-windows (determined later from logs)
    //   - Output: *.quant files (preliminary quantification for each file)
    //   - Purpose: Generate data to automatically determine optimal mass accuracy and scan window settings
    // Note: mass_acc and scan_window are NOT set during preliminary analysis in quantms
    // when using automatic modes - they're determined from the preliminary results
    withName: 'DIANN_PRELIMINARYANALYSIS' {
        ext.args = {[
            params.diann_debug ? "--verbose ${params.diann_debug}" : '',
            params.diann_quick_mass_acc ? "--quick-mass-acc" : '',
            params.diann_performance_mode ? "--min-corr 2 --corr-diff 1 --time-corr-only" : '',
            meta.mass_acc_ms2 ? "--mass-acc ${meta.mass_acc_ms2}" : '',
            meta.mass_acc_ms1 ? "--mass-acc-ms1 ${meta.mass_acc_ms1}" : '',
            meta.scan_window ? "--window ${meta.scan_window}" : '',
            params.diann_additional_analysis_args ?: ''
        ].findAll { arg -> arg != '' }.join(' ').trim()}
    }

    // DIANN_ASSEMBLEEMPIRICALLIBRARY - Empirical library assembly
    // What makes this "Empirical Library Assembly":
    //   - Input: All MS files + predicted library + preliminary *.quant files
    //   - Key flags: --rt-profiling --gen-spec-lib
    //   - Uses --individual-mass-acc and --individual-windows (if automatic mode enabled)
    //   - Output: empirical_library.* (refined library based on actual data)
    //   - Purpose: Build experiment-specific library using preliminary results to improve identifications
    withName: 'DIANN_ASSEMBLEEMPIRICALLIBRARY' {
        ext.prefix = 'empirical_library'
        ext.args = {[
            params.diann_debug ? "--verbose ${params.diann_debug}" : '',
            "--rt-profiling",
            "--gen-spec-lib",
            "--matrices",
            params.protein_level_fdr_cutoff != null ? "--qvalue ${params.protein_level_fdr_cutoff}" : '',
            meta.mass_acc_ms2 && meta.mass_acc_ms1 ? "--mass-acc ${meta.mass_acc_ms2} --mass-acc-ms1 ${meta.mass_acc_ms1}" : "--individual-mass-acc",
            meta.scan_window ? "--window ${meta.scan_window}" : "--individual-windows",
            params.diann_additional_analysis_args ?: ''
        ].findAll { arg -> arg != '' }.join(' ').trim()}
    }

    // DIANN_INDIVIDUALANALYSIS - Individual analysis
    // What makes this "Individual Analysis":
    //   - Input: Individual MS file + empirical library + FASTA
    //   - Key flags: --no-ifs-removal --no-main-report (suppress full reports, only generate .quant)
    //   - Uses refined mass accuracy settings from empirical library log (meta.mass_acc_ms1, meta.mass_acc_ms2, meta.scan_window)
    //   - Output: *.quant files (individual quantification for each file with refined library)
    //   - Purpose: Re-analyze each file individually with optimal settings before final aggregation
    withName: 'DIANN_INDIVIDUALANALYSIS' {
        ext.args = {
            // Settings come from the empirical-library log ("Averaged recommended settings") or the user;
            // a missing value must stop the run instead of reaching DIA-NN as "null". The check is here, not in the
            // nf-core dia_proteomics_analysis subworkflow, so that subworkflow's patch does not grow.
            def missing = ['mass_acc_ms2', 'mass_acc_ms1', 'scan_window'].findAll { key -> !meta[key] }
            if (missing) {
                throw new IllegalStateException("DIA-NN ${missing} unknown for ${meta.id}: the empirical library log has no 'Averaged recommended settings' line and no manual value is set")
            }
            [
                params.diann_debug ? "--verbose ${params.diann_debug}" : '',
                "--no-ifs-removal",
                "--no-main-report",
                "--relaxed-prot-inf",
                meta.pg_level ? "--pg-level ${meta.pg_level}" : '',
                "--mass-acc ${meta.mass_acc_ms2}",
                "--mass-acc-ms1 ${meta.mass_acc_ms1}",
                "--window ${meta.scan_window}",
                params.diann_additional_analysis_args ?: ''
            ].findAll { arg -> arg != '' }.join(' ').trim()
        }
    }

    // DIANN_FINALQUANTIFICATION - Final quantification
    // What makes this "Final Quantification":
    //   - Input: All MS file names (basenames only) + empirical library + all individual *.quant files + FASTA
    //   - Key flags: --matrices (generate quantification matrices)
    //   - Outputs: diann_report.tsv, *.pr_matrix.tsv, *.pg_matrix.tsv (precursor and protein group quantification)
    //   - NOTE: The quantms FINAL_QUANTIFICATION module computes scan_window/individual-windows
    //     but does NOT pass it to the command. We match this behavior exactly.
    //   - Purpose: Aggregate all individual analyses into final cross-run normalized quantification
    withName: 'DIANN_FINALQUANTIFICATION' {
        ext.prefix = 'diann_report'
        ext.args = {[
            params.diann_debug ? "--verbose ${params.diann_debug}" : '',
            "--relaxed-prot-inf",
            params.diann_pg_level != null ? "--pg-level ${params.diann_pg_level}" : '',
            params.species_genes ? "--species-genes" : '',
            "--matrices",
            params.protein_level_fdr_cutoff != null ? "--qvalue ${params.protein_level_fdr_cutoff}" : '',
            params.diann_report_decoys ? "--report-decoys" : '',
            params.diann_export_xic ? "--xic" : '',
            params.diann_scan_window_automatic ? "--individual-windows" : (params.diann_scan_window ? "--window ${params.diann_scan_window}" : ''),
            params.diann_additional_analysis_args ?: ''
        ].findAll { arg -> arg != '' }.join(' ').trim()}
    }

    withName: 'QUANTMSUTILS_DIANN2MZTAB' {
        ext.args = {
            [
                params.max_precursor_charge ? "--charge ${params.max_precursor_charge}" : '',
                params.allowed_missed_cleavages != null ? "--missed_cleavages ${params.allowed_missed_cleavages}" : '',
                params.protein_level_fdr_cutoff != null ? "--qvalue_threshold ${params.protein_level_fdr_cutoff}" : '',
                params.enable_diann_mztab ? "--enable_diann2mztab" : '',
                meta.dia_params ? "--dia_params \"${meta.dia_params}\"" : ''
            ].findAll { arg -> arg != '' }.join(' ').trim()
        }
    }

    withName: 'OPENMSPEAKPICKER' {
        ext.args = { [
            "-debug ${params.pp_debug}",
            "-processOption ${params.peakpicking_inmemory ? 'inmemory' : 'lowmemory'}",
            params.peakpicking_ms_levels ? "-algorithm:ms_levels ${params.peakpicking_ms_levels}" : ''
        ].findAll { arg -> arg != '' }.join(' ') }
    }

    withName: 'PMULTIQC' {
        ext.args = { [
            params.export_mztab ? '--quantms_plugin' : '',
            params.skip_table_plots ? '--disable_table' : '',
            params.pmultiqc_idxml_skip ? '--ignored_idxml' : '',
            params.contaminant_string ? "--contaminant_affix ${params.contaminant_string}" : '',
            "--quantification_method ${params.quantification_method}"
        ].findAll { arg -> arg != '' }.join(' ') }
        publishDir = [
            path: { "${params.outdir}/pmultiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GENERATESDRFFROMSAMPLESHEET' {
        publishDir = [
            path: { "${params.outdir}/sdrf" },
            mode: params.publish_dir_mode
        ]
    }

    // ======================================================================
    // qpx export (.h5mu / .h5ad / QPX Parquet) of DIA-NN, FragPipe LFQ and TMT-Integrator results;
    // the workflows run it unless --skip_qpx_export
    // ======================================================================
    withName: '(.*:)?(QPXDIANN|QPXFRAGPIPE|TMTANNDATA)' {
        publishDir = [
            path: { "${params.outdir}/qpx" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.replaceFirst(/^qpx_output\//, '') }
        ]
    }

    // DIA files are named diann.*, like QPXFRAGPIPE's fragpipe.* (its aggregate meta.id).
    // --qpx_qvalue_threshold is both qpxc's report filter and qpx_export.py's pr_matrix filter
    // (Global.Q.Value and Global.PG.Q.Value <= q) of the precursors modality.
    withName: '(.*:)?QPXDIANN' {
        ext.prefix = 'diann'
        ext.args   = { "--qvalue-threshold ${params.qpx_qvalue_threshold}" }
        ext.args2  = { "--matrix-qvalue ${params.qpx_qvalue_threshold}" }
    }

    // ======================================================================
    // FragPipe workflow process configs
    // ======================================================================

    //
    // TMTLABELCHECKANALYZE - Per-sample labeling efficiency analysis
    //
    withName: '.*TMT_LABELCHECK.*:TMTLABELCHECKANALYZE' {
        ext.pass_threshold = 0.95
        ext.warn_threshold = 0.85
        ext.prob_threshold = 0.95
    }

    //
    // TMTLABELCHECKANALYZE_IONQUANT - Combined labeling efficiency analysis
    //
    withName: '.*TMT_LABELCHECK.*:TMTLABELCHECKANALYZE_IONQUANT' {
        ext.pass_threshold = 0.95
        ext.warn_threshold = 0.85
    }

    //
    // PHILOSOPHERDATABASE - FragPipe's database update (philosopher database --custom <fasta>),
    // published with --save_reference; run with --add_philosopher_decoy and/or --add_philosopher_contaminants:
    // no decoys -> --nodecoys; contaminants -> --contam --contamprefix (CmdDatabaseUpdate.java:44-53)
    //
    withName: '.*FRAGPIPE.*:PHILOSOPHERDATABASE' {
        ext.args = { [params.add_philosopher_decoy ? '' : '--nodecoys', params.add_philosopher_contaminants ? '--contam --contamprefix' : ''].findAll { a -> a }.join(' ') }
        publishDir = [
            path: { "${params.outdir}/proteome/fragpipe" },
            enabled: params.save_reference,
            mode: params.publish_dir_mode
        ]
    }

    //
    // Pipeline helpers whose output FragPipe does not keep in its work dir publish nothing:
    // CHECKDBCONFIG (FragPipe decoy check, emits its input unchanged), CHECKCENTROID (FragPipe's centroid
    // check only logs to the console), PARSEFRAGPIPEWORKFLOW (per-tool settings for the modules; the files
    // FragPipe writes from them are published by the tool steps: fragger*.params, shepherd.config,
    // tmt-integrator-conf.yml, ...)
    //
    withName: '.*:(CHECKDBCONFIG|CHECKCENTROID|PARSEFRAGPIPEWORKFLOW)' {
        publishDir = [ enabled: false ]
    }

    withName: '.*PARSEFRAGPIPEWORKFLOW' {
        // FragPipe headless --threads: overrides workflow.threads (Fragpipe.java:508-514)
        ext.args = { params.fragpipe_threads ? "--threads ${params.fragpipe_threads}" : '' }
    }

    //
    // DIAUMPIRE - DIA-Umpire SE pseudo-spectra. diaumpire_se.log, which DIA-Umpire writes in its cwd, goes to
    // diaumpire/<sample>/ next to umpire-se.params (FragPipe moves it into its work dir, CmdUmpireSe.java:151-157)
    //
    withName: '(.*:)?DIAUMPIRE' {
        publishDir = [
            path: { "${params.outdir}/diaumpire" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'diaumpire_se.log' ? "${task.ext.prefix ?: meta.id}/${filename}" : filename }
        ]
    }

    //
    // MSFRAGGER - Database search
    //
    withName: '.*MSFRAGGER.*' {
        cpus   = { 32 * task.attempt }
        memory = { 240.GB * task.attempt }
        ext.java_xmx = { (task.memory.toGiga() * 0.9) as int } // heap leaves room for JVM/native memory
        // The per-task pepindex (one copy per search task, same names) is not published, nor are the
        // chunk searches of a split database: msfragger_pep_split.py deletes their directory (:645).
        publishDir = [
            path: { "${params.outdir}/msfragger" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.pepindex') || filename == 'I_AGREE_FRAGPIPE_LICENSE_AGREEMENT' || meta.chunk_id != null ? null : filename }
        ]
    }

    // FragPipe's run-level fragger*.params, one per params set the run searches with (CmdMsfragger.java:441-552)
    withName: '.*FRAGPIPE.*:WRITE_FRAGGER_PARAMS' {
        publishDir = [
            path: { "${params.outdir}/msfragger" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // MSFRAGGERCALIBRATE - Mass calibration + parameter optimization of a split search.
    // msfragger_pep_split.py runs the calibration search in its temporary directory (calibrate() :499-504,
    // cwd=tempdir), moves each *.mzBIN_calibrated there (:595-603) and deletes the directory (main() :644-647);
    // its console text is part of FragPipe's log_*.txt. What the calibration search writes next to the input
    // (the original file, --split1) stays in FragPipe's LC-MS directory, as a single search's files do: a
    // slice-db 2 FragPipe run keeps raw_files/<stem>_uncalibrated.mzBIN (and, for .raw / .d input,
    // <stem>_uncalibrated.mzML). They are published to msfragger/ like MSFRAGGER's lcms_files.
    //
    withName: '.*MSFRAGGERCALIBRATE.*' {
        cpus   = { 32 * task.attempt }
        memory = { 240.GB * task.attempt }
        ext.java_xmx = { (task.memory.toGiga() * 0.9) as int } // heap leaves room for JVM/native memory
        publishDir = [
            path: { "${params.outdir}/msfragger" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('_uncalibrated.mzML') || filename.endsWith('_uncalibrated.mzBIN') ? filename : null }
        ]
    }

    //
    // MSFRAGGERAPPLYCALIBRATION - calibrated params and spectra of a split search: msfragger_pep_split.py keeps
    // them in its temporary directory and deletes it (:597-603, :645), so they are not published
    //
    withName: '.*MSFRAGGERAPPLYCALIBRATION' {
        publishDir = [ enabled: false ]
    }

    //
    // SORTFASTA / SPLITFASTA - the sorted FASTA and the database chunks of a split search: msfragger_pep_split.py
    // writes them into its temporary directory (sample_fasta() :614-620, set_up_directories() :109) and deletes
    // it (:654-657), so they are not published
    //
    withName: '.*FRAGPIPE.*:SORTFASTA' {
        publishDir = [ enabled: false ]
    }

    withName: '.*FRAGPIPE.*:SPLITFASTA' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        publishDir = [ enabled: false ]
    }

    //
    // MERGESPLITSEARCH - Merge pepXML + PIN across database chunks
    //
    withName: '.*MERGESPLITSEARCH.*' {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        // The merged pepXML and pin of a file are where a single search puts them (msfragger_pep_split.py:397, :462)
        publishDir = [
            path: { "${params.outdir}/msfragger" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'I_AGREE_FRAGPIPE_LICENSE_AGREEMENT' ? null : filename }
        ]
    }

    //
    // MSBOOSTER - AI-based rescoring
    //
    withName: '.*FRAGPIPE.*:MSBOOSTER' {
        // numThreads of the run (it changes MSBooster's output); resourceLimits may cap the cores, never numThreads
        cpus = { threads as int }
        publishDir = [
            path: { "${params.outdir}/msbooster" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // CRYSTALC - Chimeric artifact removal
    //
    withName: '.*FRAGPIPE.*:CRYSTALC' {
        publishDir = [
            path: { "${params.outdir}/crystalc" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // PTMPROPHET - PTM site localization
    //
    withName: '.*FRAGPIPE.*:PTMPROPHET' {
        publishDir = [
            path: { "${params.outdir}/ptmprophet" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // PHILOSOPHERPEPTIDEPROPHET - Peptide-level validation
    //
    withName: '.*FRAGPIPE.*:PHILOSOPHERPEPTIDEPROPHET' {
        publishDir = [
            path: { "${params.outdir}/peptideprophet" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // PERCOLATOR - PSM-level FDR control
    //
    withName: '.*FRAGPIPE.*:PERCOLATOR' {
        ext.args = ''
        publishDir = [
            [
                path: { "${params.outdir}/percolator" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.endsWith('_percolator.weights') ? null : filename }
            ],
            // Write sub mzML: FragPipe keeps <stem>_percolator.weights in <wd>/<group> (Percolator runs there,
            // CmdPercolator.java:180-183, :214) and the second pass finds it by walking the folder of its
            // _sub.mzML input (CmdPercolator.java:185-191), which is <wd>: fragpipe/<group>/ next to fragpipe/<stem>_sub.mzML
            [
                path: { "${params.outdir}/fragpipe" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.endsWith('_percolator.weights') ? (meta.group ? "${meta.group}/${filename.tokenize('/').last()}" : filename.tokenize('/').last()) : null }
            ]
        ]
    }

    //
    // PHILOSOPHERPROTEINPROPHET - Protein inference
    //
    withName: '.*FRAGPIPE.*:PHILOSOPHERPROTEINPROPHET' {
        publishDir = [
            path: { "${params.outdir}/proteinprophet" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // PHILOSOPHERIPROPHET / PHILOSOPHERABACUS - multi-experiment report (FragpipeRun.java:1782-1809)
    //
    withName: '.*FRAGPIPE.*:PHILOSOPHERIPROPHET' {
        publishDir = [
            path: { "${params.outdir}/iprophet" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*FRAGPIPE.*:PHILOSOPHERABACUS' {
        publishDir = [
            path: { "${params.outdir}/abacus" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // SAINTEXPRESS - run when the workflow sets saintexpress.run-saint-express=true
    // (open source; keeps the module's FragPipe image like PERCOLATOR). A skipped mode publishes
    // saintexpress-<mode>/skipped_mode.txt with FragPipe's error message (REPRINTTOSAINTINPUT).
    // Published under downstream/: it is FragPipe's Downstream-tab action (its own Run button,
    // TabDownstream.java:114-145,220), not a step of FragPipe's run (FragpipeRun.java has no SAINTexpress).
    //
    withName: '.*FRAGPIPE.*:SAINTEXPRESS' {
        publishDir = [
            path: { "${params.outdir}/downstream/saintexpress" },
            mode: params.publish_dir_mode
        ]
    }

    // REPRINTTOSAINTINPUT publishes only a skipped mode's message: SAINTEXPRESS publishes the .dat inputs
    // with its results
    withName: '.*FRAGPIPE.*:REPRINTTOSAINTINPUT' {
        publishDir = [
            path: { "${params.outdir}/downstream/saintexpress" },
            mode: params.publish_dir_mode,
            pattern: '*/skipped_mode.txt'
        ]
    }

    //
    // PHILOSOPHERFILTER - FDR filtering and report
    //
    // FragPipe writes the blank group "" to the work-dir root; in Nextflow it is staged as
    // 'workdir-root' (fragpipeGroupDir in subworkflows/local/utils_nfcore_msproteomics_pipeline/fragpipe_utils.nf). Philosopher
    // filter/report emit their result files individually, so publishing strips that directory
    // and the blank group's files land at the top of philosopher/ (FragPipe's work-dir layout).
    // When PHILOSOPHERREPORT runs after FreeQuant/Labelquant it writes the final tables, so
    // the filter then publishes only its log.
    // PHILOSOPHERFILTER_LATER is the alias for the groups after FragPipe's first group.
    // The .meta workspace is not published: FragPipe cleans it at the end (workspace --clean).
    // When matched fragments are exported, the final psm.tsv comes from EXPORTMATCHEDFRAGMENTS
    // (FragPipe rewrites psm.tsv in place).
    withName: '.*FRAGPIPE.*:PHILOSOPHERFILTER(_LATER)?' {
        // FreeQuant / LabelQuant then Report run on the workspace Filter leaves (FragpipeRun.java:2463-2471)
        ext.skip_report = { meta.report_after_quant }
        publishDir = [
            path: { "${params.outdir}/philosopher" },
            mode: params.publish_dir_mode,
            // meta.fpop_coadaptr == 'filter': FPOPCOADAPTR publishes the edited psm.tsv here instead
            saveAs: { filename ->
                def target = filename.replaceFirst('^workdir-root/', '')
                if (target.tokenize('/').contains('.meta') || (meta.report_after_quant && !target.endsWith('philosopher_filter.log'))) {
                    return null
                }
                // the final psm.tsv is published by FPOPCOADAPTR or EXPORTMATCHEDFRAGMENTS when they rewrite it
                (meta.fpop_coadaptr == 'filter' || meta.export_matched_fragments) && target.tokenize('/')[-1] == 'psm.tsv' ? null : target
            }
        ]
    }

    withName: '.*:PHILOSOPHERREPORT' {
        publishDir = [
            path: { "${params.outdir}/philosopher" },
            mode: params.publish_dir_mode,
            // meta.fpop_coadaptr == 'report' / meta.export_matched_fragments: FPOPCOADAPTR / EXPORTMATCHEDFRAGMENTS
            // publish the rewritten psm.tsv here instead
            saveAs: { filename ->
                def target = filename.replaceFirst('^workdir-root/', '')
                (meta.fpop_coadaptr == 'report' || meta.export_matched_fragments) && target.tokenize('/')[-1] == 'psm.tsv' ? null : target
            }
        ]
    }

    // PHILOSOPHERWORKSPACECLEAN hands the group dir without .meta to the later tools; its tables are
    // PHILOSOPHERFILTER's, published in philosopher/
    withName: '.*:PHILOSOPHERWORKSPACECLEAN' {
        publishDir = [enabled: false]
    }

    //
    // EXPORTMATCHEDFRAGMENTS - FragPipe "Export matched fragments" (FragAnnotator)
    // Publishes each group's annotated psm.tsv where the report's psm.tsv would be
    // (the blank group at the top of philosopher/, as in FragPipe's work dir).
    //
    withName: '.*:EXPORTMATCHEDFRAGMENTS' {
        container = { params.fragpipe_container }
        publishDir = [
            path: { "${params.outdir}/philosopher" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename == 'export_matched_fragments.log') {
                    return filename
                }
                def target = filename.replaceFirst('^results/', '').replaceFirst('^workdir-root/', '')
                // FPOP coADAPTr edits the annotated psm.tsv afterwards and publishes the final version
                target.tokenize('/')[-1] == 'psm.tsv' && !(meta.fpop_coadaptr in ['filter', 'report']) ? target : null
            }
        ]
    }

    // FreeQuant and LabelQuant only update the group's Philosopher workspace, which FragPipe removes after
    // the last Philosopher command (FragpipeRun.java:2544-2583): their results are the tables of the
    // Report that follows (philosopher/), so the intermediate workspaces are not published.
    // LabelQuant's experiment_annotation.tsv is WRITE_LABELQUANT_EXPERIMENT_ANNOTATION's (results root).
    withName: '.*:(FREEQUANT|PHILOSOPHERLABELQUANT)' {
        publishDir = [enabled: false]
    }

    // WRITETEXTFILE aliases that write tool inputs built in Groovy publish nothing
    withName: '.*:WRITE_(LABELQUANT_ANNOTATION|MSSTATS_TMT_ANNOTATION)' {
        publishDir = [enabled: false]
    }

    // the isobaric experiment_annotation.tsv FragPipe writes once in the work dir with LabelQuant
    // (CmdLabelquant.java:163-170) goes to the results root
    withName: '.*:WRITE_LABELQUANT_EXPERIMENT_ANNOTATION' {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // IONQUANT - Label-free quantification
    //
    withName: '(.*:)?IONQUANT' {
        cpus   = { 48 * task.attempt }
        memory = { 370.GB * task.attempt }
        // experiment_annotation.tsv goes to the results root, FragPipe's work dir (CmdIonquant.java:366-377)
        publishDir = [
            [
                path: { "${params.outdir}/ionquant" },
                mode: params.publish_dir_mode,
                // ionquant_root/ is the blank group's internal hand-over copy (already at the top of results_dir).
                // meta.fpop_coadaptr == 'ionquant': FPOPCOADAPTR publishes the results directory with
                // the edited psm.tsv files here instead
                saveAs: { filename ->
                    filename in ['ionquant_root', 'experiment_annotation.tsv', 'I_AGREE_FRAGPIPE_LICENSE_AGREEMENT'] || (meta.fpop_coadaptr == 'ionquant' && filename.tokenize('/')[0] == meta.id) ? null : filename
                }
            ],
            [
                path: { "${params.outdir}" },
                mode: params.publish_dir_mode,
                pattern: 'experiment_annotation.tsv'
            ]
        ]
    }

    //
    // IONQUANT_MS1 - TMT MS1 precursor intensity quantification
    //
    withName: '.*IONQUANT_MS1.*' {
        publishDir = [
            path: { "${params.outdir}/ionquant_ms1" },
            mode: params.publish_dir_mode,
            // ionquant_root/ is the blank group's internal hand-over copy (already at the top of results_dir)
            saveAs: { filename -> filename in ['ionquant_root', 'I_AGREE_FRAGPIPE_LICENSE_AGREEMENT'] ? null : filename }
        ]
    }

    //
    // IONQUANT_ISOBARIC - TMT reporter ion quantification
    //
    withName: '.*IONQUANT_ISOBARIC.*' {
        // experiment_annotation.tsv goes to the results root, FragPipe's work dir (CmdIonquant.java:366-377)
        publishDir = [
            [
                path: { "${params.outdir}/ionquant_isobaric" },
                mode: params.publish_dir_mode,
                // ionquant_root/ is the blank group's internal hand-over copy (already at the top of results_dir).
                // meta.fpop_coadaptr == 'isobaric': FPOPCOADAPTR publishes the results directory with
                // the edited psm.tsv files here instead
                saveAs: { filename ->
                    filename in ['ionquant_root', 'experiment_annotation.tsv', 'I_AGREE_FRAGPIPE_LICENSE_AGREEMENT'] || (meta.fpop_coadaptr == 'isobaric' && filename.tokenize('/')[0] == meta.id) ? null : filename
                }
            ],
            [
                path: { "${params.outdir}" },
                mode: params.publish_dir_mode,
                pattern: 'experiment_annotation.tsv'
            ]
        ]
    }

    //
    // TMTINTEGRATOR - TMT quantification and normalization
    //
    // TMT-Integrator runs in a copy of FragPipe's work dir named like the results directory, so
    // the blank group's plex is named after it as in FragPipe (TMT-Integrator takes the plex from
    // the psm.tsv folder); tmt-report/, tmt-integrator-conf.yml and MSstatsTMT_annotation.csv are
    // published at the results root, FragPipe's work-dir layout (CmdTmtIntegrator.java:105-170)
    withName: '.*FRAGPIPE.*:TMTINTEGRATOR' {
        ext.work_dir_name = { params.outdir.toString().tokenize('/')[-1] }
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.substring(filename.indexOf('/') + 1) }
        ]
    }

    // Second TMT-Integrator run for FPOP TMT, written to tmt-report-unmod (CmdTmtIntegrator.java:149-150)
    withName: '.*FRAGPIPE.*:TMTINTEGRATOR_UNMOD' {
        // same work dir as the first run; tmt-report-unmod and tmt-integrator-conf-unmod.yml (CmdTmtIntegrator.java:62, :149-152)
        ext.work_dir_name    = { params.outdir.toString().tokenize('/')[-1] }
        ext.report_dir_name  = 'tmt-report-unmod'
        ext.config_file_name = 'tmt-integrator-conf-unmod.yml'
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.substring(filename.indexOf('/') + 1) }
        ]
    }

    //
    // FPOPCOADAPTR - FragPipe edits psm.tsv / report.tsv in place, so the edited copies go to
    // the path of the task they replace (meta.fpop_source); that task's publishDir above leaves
    // them out (meta.fpop_coadaptr). The tables keep their task-relative path below the
    // module's prefix directory; the blank group's psm.tsv goes to the top, as in FragPipe.
    // 'diann' = DIANNFRAGPIPE's dia_quant/ (fix/dia-speclib-diann).
    //
    withName: '.*FRAGPIPE.*:FPOPCOADAPTR' {
        publishDir = [
            [
                path: { "${params.outdir}/" + [ionquant: 'ionquant', isobaric: 'ionquant_isobaric', report: 'philosopher', filter: 'philosopher', diann: 'dia_quant'][meta.fpop_source] },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.contains('/') ? filename.replaceFirst('^[^/]+/', '').replaceFirst('^workdir-root/', '') : null }
            ],
            [
                path: { "${params.outdir}/fpop_coadaptr" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename == 'fpop_coadaptr.log' ? filename : null }
            ]
        ]
    }

    //
    // SPECLIBGEN - Spectral library generation
    //
    withName: '.*FRAGPIPE.*:SPECLIBGEN' {
        container = { params.fragpipe_container }
        publishDir = [
            path: { "${params.outdir}/speclib" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // DIANNFRAGPIPE - DIA-NN quantification with FragPipe's bundled DIA-NN (CmdDiann)
    //
    withName: '.*FRAGPIPE.*:WRITE_DIANN_EXPERIMENT_ANNOTATION' {
        publishDir = [
            path: { "${params.outdir}/dia_quant" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*FRAGPIPE.*:DIANNFRAGPIPE' {
        container = { params.fragpipe_container }
        publishDir = [
            path: { "${params.outdir}/dia_quant" },
            mode: params.publish_dir_mode,
            // DIA-NN's unedited report.tsv is not published when FPOP coADAPTr rewrites it (meta.fpop_coadaptr)
            saveAs: { filename -> meta.fpop_coadaptr && filename == 'dia-quant-output/report.tsv' ? null : filename }
        ]
    }

    //
    // PTMSHEPHERD - PTM analysis
    //
    // ptm-shepherd-output/ and shepherd.config as in FragPipe's work dir; groups/<group>/ holds
    // the psm.tsv PTM-Shepherd rewrote (FragPipe rewrites the group's own psm.tsv in place)
    withName: '.*FRAGPIPE.*:PTMSHEPHERD' {
        publishDir = [
            path: { "${params.outdir}/ptmshepherd" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // Glyco chain: PairScans .pairs, and the group directories O-Pair / MBG rewrote
    //
    withName: '.*FRAGPIPE.*:PAIRSCANS' {
        publishDir = [
            path: { "${params.outdir}/pairscans" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.replaceFirst('^spectra/', '') }
        ]
    }

    withName: '.*FRAGPIPE.*:OPAIR' {
        publishDir = [
            path: { "${params.outdir}/opair" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'opair.log' ? "${meta.id}/opair.log" : filename }
        ]
    }

    withName: '.*FRAGPIPE.*:MBG' {
        publishDir = [
            path: { "${params.outdir}/mbg" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'mbg.log' ? "${meta.id}/mbg.log" : filename }
        ]
    }


    //
    // FRAGPIPEHEADLESS - All-in-one FragPipe execution
    //
    withName: 'FRAGPIPESAVEWORKFLOW' {
        container = { params.fragpipe_container }
        publishDir = [
            path: { "${params.outdir}/fragpipe" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'fragpipe.workflow' ? filename : null }
        ]
    }

    // Write sub mzML: FragPipe writes <wd>/<stem>_sub.mzML and the second-pass workflow and manifest
    // into its work dir (CmdWriteSubMzml.java:125, FragpipeRun.java:636-697); the manifest names fragpipe/<stem>_sub.mzML
    withName: '.*:WRITESUBMZML' {
        publishDir = [
            path: { "${params.outdir}/fragpipe" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('_sub.mzML') ? filename : null }
        ]
    }

    // fragpipe-files.fp-manifest, written into FragPipe's work dir by every run (FragpipeRun.java:371-376)
    withName: '.*:WRITE_FRAGPIPE_MANIFEST' {
        publishDir = [
            path: { "${params.outdir}/fragpipe" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FRAGPIPESECONDPASS' {
        publishDir = [
            path: { "${params.outdir}/fragpipe" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FRAGPIPESDRF' {
        publishDir = [
            path: { "${params.outdir}/fragpipe" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FRAGPIPEHEADLESS' {
        cpus   = { 90 * task.attempt }
        memory = { 760.GB * task.attempt }
        scratch = true
        publishDir = [
            path: { "${params.outdir}/fragpipe" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // TMT Label Check analysis
    //
    withName: '.*:TMTLABELCHECKANALYZE' {
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:TMTLABELCHECKANALYZE_IONQUANT' {
        publishDir = [
            path: { "${params.outdir}/qc_combined" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // MultiQC
    //
    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }
}
