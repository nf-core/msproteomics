/*
========================================================================================
    Reference Proteomes Configuration
========================================================================================
    UniProt reference proteomes (Swiss-Prot reviewed + isoforms), keyed by the
    organism name that --organism resolves to (see
    WorkflowUtils.convertOrganismToStandardName). Loaded unless
    --proteomes_ignore is set; the FASTA is downloaded from the UniProt REST API
    at runtime when --database is not given. Mirrors the nf-core igenomes pattern
    (params.genomes / conf/igenomes.config).
    These do NOT include contaminant sequences. For FragPipe workflows,
    contaminants are added automatically by Philosopher's database command.
    For DIA-NN workflows, append contaminants to your FASTA manually or
    use --database with a pre-prepared database that includes contaminants.
    --database always takes precedence over this map.
========================================================================================
*/

params {
    databases {
        'Homo sapiens' {
            proteome_id = 'UP000005640'
            taxon_id    = 9606
            database    = "${params.proteomes_base}UP000005640)"
        }
        'Mus musculus' {
            proteome_id = 'UP000000589'
            taxon_id    = 10090
            database    = "${params.proteomes_base}UP000000589)"
        }
        'Rattus norvegicus' {
            proteome_id = 'UP000002494'
            taxon_id    = 10116
            database    = "${params.proteomes_base}UP000002494)"
        }
        'Saccharomyces cerevisiae' {
            proteome_id = 'UP000002311'
            taxon_id    = 559292
            database    = "${params.proteomes_base}UP000002311)"
        }
        'Danio rerio' {
            proteome_id = 'UP000000437'
            taxon_id    = 7955
            database    = "${params.proteomes_base}UP000000437)"
        }
        'Drosophila melanogaster' {
            proteome_id = 'UP000000803'
            taxon_id    = 7227
            database    = "${params.proteomes_base}UP000000803)"
        }
        'Caenorhabditis elegans' {
            proteome_id = 'UP000001940'
            taxon_id    = 6239
            database    = "${params.proteomes_base}UP000001940)"
        }
        'Escherichia coli' {
            proteome_id = 'UP000000625'
            taxon_id    = 83333
            database    = "${params.proteomes_base}UP000000625)"
        }
    }
}
