/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Smallest real msproteomics run: FragPipe DDA LFQ (LFQ-MBR) on two ~9 MB human SILAC
    mzML subsets (Zenodo 1051552) against a 500-protein human Swiss-Prot subset.
    The licensed FragPipe tools need the FragPipe image at runtime (--fragpipe_container).

    Use as follows:
        nextflow run nf-core/msproteomics -profile test,<docker/singularity> --fragpipe_container <image> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal FragPipe DDA LFQ test to check pipeline function'

    mode              = 'fragpipe'
    fragpipe_workflow = "${projectDir}/assets/LFQ-MBR.workflow"
    fragpipe_threads  = 2  // MSBooster needs the run's thread count; the bundled workflow files do not set workflow.threads
    // Local copy of the test-datasets sheet; spectra URLs follow params.pipelines_testdata_base_path
    input             = "${projectDir}/tests/fixtures/samplesheets/test_dda_lfq.csv"
    database          = "${params.pipelines_testdata_base_path}/databases/human_sp_subset.fasta"
    // The FASTA has no decoys: FragPipe's "Add decoys" database update (CmdDatabaseUpdate.java:44-53)
    add_philosopher_decoy        = true
    add_philosopher_contaminants = true
    organism          = 'homo_sapiens'
    // 2 experiments: IonQuant writes MaxLFQ intensities only with >= 3 (qpxFragpipeExport), so no qpx export
    skip_qpx_export   = true
}
