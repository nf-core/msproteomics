/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    FragPipe LFQ tutorial dataset (https://fragpipe.nesvilab.org/docs/tutorial_lfq.html):
    PRIDE PXD024427 glioma FFPE, 3 IDHmut + 3 IDHwt Q Exactive HF DDA runs (~2.4-3 GB .raw
    each), LFQ-MBR, human UniProt reference proteome (Philosopher adds decoys and
    contaminants). The licensed FragPipe tools need --fragpipe_container at runtime.

    Use as follows:
        nextflow run nf-core/msproteomics -profile test_full,<docker/singularity> --fragpipe_container <image> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full-size FragPipe DDA LFQ test (PXD024427, FragPipe LFQ tutorial, 6 runs)'

    mode              = 'fragpipe'
    fragpipe_workflow = "${projectDir}/assets/LFQ-MBR.workflow"
    fragpipe_threads  = 2  // MSBooster needs the run's thread count; the bundled workflow files do not set workflow.threads
    input             = "${projectDir}/tests/fixtures/samplesheets/full_PXD024427.csv"
    // UniProt UP000005640 human reference proteome from nf-core/test-datasets (modules branch)
    database          = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/proteomics/database/UP000005640_9606.fasta'
    // The FASTA has no decoys: FragPipe's "Add decoys" database update (CmdDatabaseUpdate.java:44-53)
    add_philosopher_decoy        = true
    add_philosopher_contaminants = true
    organism          = 'homo_sapiens'
}
