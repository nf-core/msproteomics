/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for DDA LFQ workflow tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Uses FragPipe DDA label-free quantification with small dataset.

    Use as follows:
        nextflow run nf-core/msproteomics -profile test_dda_lfq,docker --fragpipe_container <image> --outdir <OUTDIR>

~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'DDA LFQ test profile'
    config_profile_description = 'DDA LFQ workflow test with small dataset'

    mode           = 'fragpipe'
    // Bundled FragPipe DDA LFQ (match-between-runs) workflow
    fragpipe_workflow = "${projectDir}/assets/LFQ-MBR.workflow"
    fragpipe_threads  = 2  // MSBooster needs the run's thread count; the bundled workflow files do not set workflow.threads
    // Local copy of the test-datasets sheet with FragPipe experiment/bioreplicate columns
    input          = "${projectDir}/tests/fixtures/samplesheets/test_dda_lfq.csv"
    database       = "${params.pipelines_testdata_base_path}/databases/human_sp_subset.fasta"
    // The FASTA has no decoys: FragPipe's "Add decoys" database update (CmdDatabaseUpdate.java:44-53)
    add_philosopher_decoy        = true
    add_philosopher_contaminants = true
    organism       = 'homo_sapiens'
    outdir         = 'results'
}
