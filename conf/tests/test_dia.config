/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for DIA workflow tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Uses DIA-NN with small DIA test dataset.

    Use as follows:
        nextflow run nf-core/msproteomics -profile test_dia,docker --outdir <OUTDIR>

~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'DIA test profile'
    config_profile_description = 'DIA workflow test with small dataset'

    mode           = 'diann'
    // Local copy of the test-datasets sheet; spectra URL follows params.pipelines_testdata_base_path
    input          = "${projectDir}/tests/fixtures/samplesheets/test_dia.csv"
    database       = "${params.pipelines_testdata_base_path}/databases/human_sp_subset.fasta"
    organism       = 'homo_sapiens'
    // No protein group of this subset passes DIA-NN's default 1% matrix FDR (empty pg_matrix, so the qpx export
    // has no proteins): relax DIA-NN's matrix filter (DIA-NN 1.8.1 caps --matrix-qvalue at 0.05, its log:
    // "Precursor/protein x sample matrices will be filtered at 0.05 precursor & protein-level FDR")
    diann_additional_analysis_args = '--matrix-qvalue 1'
    outdir         = 'results'
}
