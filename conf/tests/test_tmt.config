/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for TMT label check workflow tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Uses FragPipe TMT labeling efficiency check with small dataset.

    Use as follows:
        nextflow run nf-core/msproteomics -profile test_tmt,docker --outdir <OUTDIR>

~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'TMT label check test profile'
    config_profile_description = 'TMT label check workflow test with small dataset'

    mode           = 'fragpipe'
    tmt_mode       = 'labelcheck'
    tmt_type       = 'TMT6'
    // Local copy of the test-datasets sheet with FragPipe experiment/bioreplicate columns
    input          = "${projectDir}/tests/fixtures/samplesheets/test_tmt.csv"
    database       = "${params.pipelines_testdata_base_path}/databases/erwinia_carotovora.fasta"
    // The FASTA has no decoys: FragPipe's "Add decoys" database update (CmdDatabaseUpdate.java:44-53)
    add_philosopher_decoy        = true
    add_philosopher_contaminants = true
    organism       = 'erwinia_carotovora'
    outdir         = 'results'
}
