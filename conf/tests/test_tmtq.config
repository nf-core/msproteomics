/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for TMT quantification workflow tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Uses FragPipe TMT quantification with small dataset.

    Use as follows:
        nextflow run nf-core/msproteomics -profile test_tmtq,docker --outdir <OUTDIR>

~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'TMT quantification test profile'
    config_profile_description = 'TMT quantification workflow test with small dataset'

    mode           = 'fragpipe'
    tmt_mode       = 'quant'
    // Local copy of the test-datasets sheet with FragPipe experiment/bioreplicate columns
    input          = "${projectDir}/tests/fixtures/samplesheets/test_tmtq.csv"
    // Bundled TMT6 quant workflow: FragPipe 24.0 TMT10 template with tmtintegrator.channel_num=TMT-6
    // and SAINTexpress off; same file as workflows/TMT6.workflow of the msproteomics test-datasets
    // branch (an-altosian/test-datasets, pending nf-core/test-datasets PR 1953)
    fragpipe_workflow = "${projectDir}/assets/TMT6.workflow"
    fragpipe_threads  = 2  // MSBooster needs the run's thread count; the bundled workflow files do not set workflow.threads
    // Same Erwinia spectra as test_tmt, so the same Erwinia database
    database       = "${params.pipelines_testdata_base_path}/databases/erwinia_carotovora.fasta"
    // The FASTA has no decoys: FragPipe's "Add decoys" database update (CmdDatabaseUpdate.java:44-53)
    add_philosopher_decoy        = true
    add_philosopher_contaminants = true
    organism       = 'erwinia_carotovora'
    outdir         = 'results'
}
