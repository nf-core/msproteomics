nextflow_process {

    name "Test Process CHECKCENTROID"
    script "../main.nf"
    process "CHECKCENTROID"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "check_centroid"

    // argv as FragPipe 24.0 (golden manifest step 1, CmdCheckCentroid.java:52-65)
    test("check_centroid - stub") {
        tag "stub"
        options "-stub"

        when {
            process {
                """
                def mzml = file("\${workDir}/run1.mzML")
                mzml.text = "mock"
                input[0] = [[ id:'run1' ], mzml]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert new File(process.out.log.get(0).get(1)).text.trim().matches(/org\.nesvilab\.fragpipe\.util\.CheckCentroid \S+\/run1\.mzML \d+/) },
                { assert snapshot(process.out.versions_fragpipe).match() }
            )
        }
    }

    test("check_centroid - centroided mzML passes") {
        tag "integration"

        when {
            process {
                """
                input[0] = [[ id:'erwinia' ], file("\${params.pipelines_testdata_base_path}/spectra/tmt_erwinia_subset.mzML", checkIfExists: true)]
                """
            }
        }

        then {
            def log = new File(process.out.log.get(0).get(1)).readLines()
            assertAll(
                { assert process.success },
                { assert log[0].matches(/java -Duser\.home=\S+ -Xmx\d+G -cp \/fragpipe_bin\/fragpipe-24\.0\/fragpipe-24\.0\/lib\/fragpipe-24\.0\.jar:\S+\/tools\/batmass-io-1\.36\.6\.jar org\.nesvilab\.fragpipe\.util\.CheckCentroid \S+\/tmt_erwinia_subset\.mzML \d+/) },
                { assert log.any { line -> line.startsWith('Done in') } },
                { assert snapshot(process.out.versions_fragpipe).match() }
            )
        }
    }
}
