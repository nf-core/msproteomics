/*
 * Golden test config: the licensed FragPipe image is given at runtime,
 *   FRAGPIPE_CONTAINER=<image> GOLDEN_ROOT=<golden root> nf-test test <module>/tests/golden.nf.test
 */
process {
    container      = System.getenv('FRAGPIPE_CONTAINER') ?: { throw new IllegalStateException('set FRAGPIPE_CONTAINER to the licensed FragPipe 24.0 image for the golden tests') }()
    // NFT_CAP_MEM_GB lowers the memory limit on a shared host; the cpus stay at FragPipe's --threads (argv --threadNum) and
    // NFT_CAP_CPUS limits the container with docker --cpus instead
    resourceLimits = [cpus: 64, memory: "${System.getenv('NFT_CAP_MEM_GB') ?: '410'}.GB", time: 4.h]

    // resources of the golden FragPipe run (--threads 64 --ram 400: -Xmx400G = memory - 2 GB); withName beats conf/modules.config labels
    withName: 'DIATRACER' {
        cpus   = 64
        memory = 402.GB
        ext.agree_fragpipe_license_agreement = true
    }
}

docker {
    enabled    = true
    runOptions = ['-u $(id -u):$(id -g)', System.getenv('NFT_CAP_CPUS') ? "--cpus ${System.getenv('NFT_CAP_CPUS')} --memory ${System.getenv('NFT_CAP_MEM_GB')}g" : ''].findAll { opt -> opt }.join(' ')
}
