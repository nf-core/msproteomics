nextflow_process {

    name "Test Process DIAUMPIRE"
    script "../main.nf"
    process "DIAUMPIRE"

    tag "modules"
    tag "modules_local"
    tag "diaumpire"

    test("diaumpire - stub") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                def mzml_file = file("\${workDir}/test.mzML")
                mzml_file.text = "mock"
                def umpire_params = "Thread = THREADS\\nRPmax = 25\\nRFmax = 300\\nCorrThreshold = 0.2\\nDeltaApex = 0.6\\nRTOverlap = 0.3\\nAdjustFragIntensity = true\\nBoostComplementaryIon = true\\nMS1PPM = 25\\nMS2PPM = 25"

                input[0] = channel.of([[ id: 'test_diaumpire' ], mzml_file, umpire_params])
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(
                    process.out.results_dir,
                    process.out.q1_spectra,
                    process.out.q2_spectra,
                    process.out.q3_spectra,
                    process.out.mgf_spectra,
                    process.out.se_log,
                    process.out.versions_diaumpire,
                    process.out.versions_fragpipe
                ).match() }
            )
        }
    }

    test("diaumpire - integration with test data") {
        tag "integration"

        when {
            process {
                """
                // mzML is a large binary file — keep remote
                def mzml_file = file("\${params.pipelines_testdata_base_path}/spectra/dia_cptac_subset.mzML", checkIfExists: true)
                // diaumpire_se.params as PARSEFRAGPIPEWORKFLOW emits it: FragPipe 24.0's template with
                // the thread count left as the THREADS placeholder that DIAUMPIRE fills with task.cpus
                // (parse_fragpipe_workflow.py generate_diaumpire_config, default panel values)
                def template = file("\${projectDir}/modules/local/parsefragpipeworkflow/assets/diaumpire_se.params", checkIfExists: true)
                def umpire_params = template.text.readLines().collect { line -> line ==~ /^Thread *=.*/ ? 'Thread = THREADS' : line }.join('\\n')

                input[0] = channel.of([[ id: 'diaumpire_test' ], mzml_file, umpire_params])
                """
            }
        }

        then {
            def outDir = new File(process.out.results_dir[0][1].toString())
            def outFiles = outDir.listFiles().sort { it.name }
            assertAll (
                { assert process.success },
                { assert outFiles.size() > 0 },
                { assert outFiles.every { it.size() > 0 } },
                { assert snapshot(outFiles.collect { it.name }).match("file_names") },
                { assert process.out.versions_diaumpire.size() == 1 },
                { assert process.out.versions_fragpipe.size() == 1 }
            )
        }
    }
}
