/*
 * Test configuration for FPOP: FRAGPIPE_TOOLS_DIR points the integration test at a local
 * FragPipe tools/ directory when it runs without the container.
 */
process {
    withName: 'FPOP' {
        ext.fragpipe_tools_dir = System.getenv('FRAGPIPE_TOOLS_DIR') ?: '/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/tools'
    }
}
