/*
 * Golden test configuration: the licensed FragPipe image with --write-plan and --msfragger-per-file is given at runtime,
 *   GOLDEN_ROOT=<golden root> FRAGPIPE_CONTAINER=<image> nf-test test modules/local/fragpipeplan/tests/golden_more.nf.test
 * FragPipe threads as each golden run (params.plan_threads): MSBooster's numThreads is part of the plan.
 */

params.fragpipe_container = System.getenv('FRAGPIPE_CONTAINER')

process {
    container      = params.fragpipe_container
    resourceLimits = [cpus: 6, memory: 72.GB, time: 1.h]

    // golden_bundled.nf.test: FragPipe's database update as the test_dda_lfq / test_tmtq profiles run it
    withName: 'PHILOSOPHERDATABASE' {
        ext.args = '--contam --contamprefix'
    }

    withName: 'FRAGPIPEPLAN' {
        memory   = 72.GB
        ext.args = { "--threads ${params.plan_threads}" }
    }
}

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g) --cpus 6'
}
