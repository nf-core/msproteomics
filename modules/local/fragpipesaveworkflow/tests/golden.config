// Integration test (tag integration): FragPipe 24.0 runs in the licensed image passed at runtime
//   FRAGPIPE_CONTAINER=<image> nf-test test modules/local/fragpipesaveworkflow/tests/main.nf.test --tag integration
params.fragpipe_container = System.getenv('FRAGPIPE_CONTAINER')
docker.enabled    = true
docker.runOptions = '-u $(id -u):$(id -g)'
process {
    withName: 'FRAGPIPESAVEWORKFLOW' {
        container = { params.fragpipe_container }
    }
}
