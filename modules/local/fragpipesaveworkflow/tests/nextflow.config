// FragPipe install for the integration test: FRAGPIPE_HOME (a FragPipe 24.0 folder with lib/ and tools/)
// when set, else the image layout of --fragpipe_container.
process {
    withName: 'FRAGPIPESAVEWORKFLOW' {
        ext.fragpipe_tools_dir = System.getenv('FRAGPIPE_HOME') ? "${System.getenv('FRAGPIPE_HOME')}/tools" : '/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/tools'
    }
}
