nextflow_process {

    name "Test Process FRAGPIPESECONDPASS"
    script "../main.nf"
    process "FRAGPIPESECONDPASS"

    tag "modules"
    tag "modules_local"
    tag "fragpipesecondpass"

    // FragpipeRun.java:589-700: rewritten workflow lines, sub mzML manifest; databases folder of the FragPipe install
    def run_workflow = [
        '# FragPipe workflow',
        'database.db-path=/data/db.fasta',
        'database.decoy-tag=rev_',
        'msfragger.calibrate_mass=2',
        'msfragger.fragment_mass_tolerance=20',
        'msfragger.fragment_mass_units=1',
        'phi-report.print-decoys=true',
        'tab-run.write_sub_mzml=true',
        'workdir=/out/fragpipe',
        ''
    ].join('\n')
    [['stub', true], ['integration', false]].each { kind, stub ->
        test("fragpipe_second_pass - ${kind} workflow and manifest") {
            if (stub) { options "-stub" }
            tag kind

            when {
                process {
                    """
                    file("\${workDir}/fragpipe.workflow").text = [
                        '# FragPipe workflow',
                        'database.db-path=/data/db.fasta',
                        'database.decoy-tag=rev_',
                        'msfragger.calibrate_mass=2',
                        'msfragger.fragment_mass_tolerance=20',
                        'msfragger.fragment_mass_units=1',
                        'phi-report.print-decoys=true',
                        'tab-run.write_sub_mzml=true',
                        'workdir=/out/fragpipe',
                        ''
                    ].join('\\n')
                    file("\${workDir}/m.fp-manifest").text = '/in/A01.mzML\\tA\\t1\\tDDA\\n/in/B01.mzML\\tB\\t\\tDDA'
                    file("\${workDir}/a.log").text = 'MSFragger\\nNew fragment_mass_tolerance = 9.5 PPM\\n'
                    file("\${workDir}/b.log").text = 'New use_topN_peaks = 100\\nNew fragment_mass_tolerance = 30 PPM\\n'
                    input[0] = channel.of([[ id: 'fragpipe' ], file("\${workDir}/fragpipe.workflow"), file("\${workDir}/m.fp-manifest"),
                                           [file("\${workDir}/a.log"), file("\${workDir}/b.log")], '/out/fragpipe'])
                    """
                }
            }

            then {
                def wf = new File(process.out.workflow[0][1].toString())
                def manifest = new File(process.out.manifest[0][1].toString())
                assertAll(
                    { assert process.success },
                    // the stub copies the run's workflow; fragpipe_second_pass.py applies FragPipe's second-pass rules
                    { assert wf.text == (stub ? run_workflow : [
                        '# FragPipe workflow',
                        'database.db-path=/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/databases',
                        'database.decoy-tag=',
                        'msfragger.calibrate_mass=0',
                        'msfragger.fragment_mass_tolerance=9.5',
                        'msfragger.fragment_mass_units=1',
                        'phi-report.print-decoys=false',
                        'tab-run.write_sub_mzml=false',
                        'workdir=',
                        ''
                    ].join('\n')) : wf.text },
                    { assert manifest.text == '/out/fragpipe/A01_sub.mzML\tA\t1\tDDA\n/out/fragpipe/B01_sub.mzML\tB\t\tDDA\n' : manifest.text },
                    { assert snapshot(process.out.workflow, process.out.manifest, process.out.versions_python.collect { entry -> entry.take(2) }).match() }
                )
            }
        }
    }
}
