nextflow_process {

    name "Test Process FREEQUANT"
    script "../main.nf"
    process "FREEQUANT"

    tag "modules"
    tag "modules_local"
    tag "freequant"

    test("freequant - stub") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                // the group dir PHILOSOPHERFILTER left without report/clean (named like the output)
                def results_dir = file("\${workDir}/test_freequant")
                results_dir.mkdirs()
                file("\${results_dir}/.meta").mkdirs()
                file("\${results_dir}/.meta/psm.bin").text = "mock"
                def psm_file = file("\${results_dir}/psm.tsv")
                psm_file.text = "peptide\\tprotein\\nPEPTIDEK\\tPROT1"
                def mzml_dir = file("\${workDir}/spectra")
                mzml_dir.mkdirs()
                def mzml_file = file("\${workDir}/spectra/test.mzML")
                mzml_file.text = "mock"
                // FreeQuant CLI config
                def config_cli = "--ptw 0.4 --tol 10"

                input[0] = channel.of([[ id: 'test_freequant' ], results_dir, [mzml_file], config_cli])
                """
            }
        }

        then {
            def dir = new File(process.out.results_dir[0][1].toString())
            assertAll (
                { assert process.success },
                // FreeQuant runs in a copy of the group workspace (the upstream dir is not modified)
                { assert new File(dir, '.meta/psm.bin').exists() },
                { assert !java.nio.file.Files.isSymbolicLink(dir.toPath()) },
                { assert snapshot(
                    process.out.results_dir,
                    process.out.versions_philosopher,
                    process.out.versions_fragpipe
                ).match() }
            )
        }
    }

    // Freequant requires a complete Philosopher workspace (.meta/psm.bin)
    // which can only be generated by the full chain:
    // MSFragger → PeptideProphet → ProteinProphet → Philosopher Filter → FreeQuant
    // Module-level integration is tested via fragpipe_quant subworkflow tests.
    // See: subworkflows/local/fragpipe_quant/tests/main.nf.test
}
