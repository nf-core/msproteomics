nextflow_process {

    name "Test Process GENERATESDRFFROMSAMPLESHEET"
    script "../main.nf"
    process "GENERATESDRFFROMSAMPLESHEET"

    tag "modules"
    tag "modules_local"
    tag "generatesdrffromsamplesheet"

    test("generate_sdrf_from_samplesheet - stub") {
        tag "stub"
        options "-stub"

        when {
            process {
                """
                def samplesheet = file("\${workDir}/samplesheet.csv")
                samplesheet.text = "sample,file\\ntest,test.raw"

                input[0] = samplesheet
                input[1] = '{"organism": "Homo sapiens"}'
                input[2] = file("\${projectDir}/tests/fixtures/iproteomes/organisms.fasta")
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(process.out.sdrf).match() }
            )
        }
    }

    // --params is one shell word whatever the JSON holds: a single quote in a value reaches generate_sdrf.py unchanged
    test("generate_sdrf_from_samplesheet - JSON value with a single quote") {
        tag "integration"

        when {
            process {
                """
                def samplesheet = file("\${workDir}/samplesheet.csv")
                samplesheet.text = "sample,spectra\\nctrl_1,ctrl_1.mzML\\nctrl_2,ctrl_2.mzML\\n"

                input[0] = samplesheet
                input[1] = '{"organism": "Homo sapiens", "enzyme": "Trypsin/P", "fixed_mods": "Carbamidomethyl (C)", "variable_mods": "Oxidation (M)", "instrument": "O\\'Brien\\'s Orbitrap", "acquisition_method": "DDA", "precursor_mass_tolerance": "20 ppm", "fragment_mass_tolerance": "20 ppm", "dissociation_method": "HCD"}'
                input[2] = file("\${projectDir}/tests/fixtures/iproteomes/organisms.fasta")
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert path(process.out.sdrf[0]).text.contains("O'Brien's Orbitrap") },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
