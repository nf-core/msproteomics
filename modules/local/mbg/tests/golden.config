// Golden test settings for PTMSHEPHERD (test setup) and MBG: the licensed FragPipe image comes from
// FRAGPIPE_CONTAINER; resources as the golden FragPipe run (--threads 48 --ram 200).
params.fragpipe_container = System.getenv('FRAGPIPE_CONTAINER') ?: { throw new IllegalArgumentException('Set FRAGPIPE_CONTAINER to the licensed FragPipe 24.0 image for the golden test') }()
docker.enabled    = true
docker.runOptions = '-u $(id -u):$(id -g)'
process {
    resourceLimits = [cpus: 48, memory: 220.GB, time: 8.h]
    withName: 'PTMSHEPHERD|MBG' {
        cpus        = 48
        memory      = 202.GB
        stageInMode = 'copy'
        container   = { params.fragpipe_container }
    }
}
