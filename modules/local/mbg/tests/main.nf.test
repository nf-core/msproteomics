nextflow_process {

    name "Test Process MBG"
    script "../main.nf"
    process "MBG"

    tag "modules"
    tag "modules_local"
    tag "mbg"

    test("mbg - stub - group copy and fragpipe-files.fp-manifest") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                def group = file("\${workDir}/cancer")
                group.mkdirs()
                file("\${group}/psm.tsv").text = "Spectrum\\tSpectrum File\\nrun_A.1.1.2\\trun_A.pepXML\\n"
                def run_a = file("\${workDir}/run_A.mzML")
                run_a.text = "mock"
                def run_b = file("\${workDir}/run_B.mzML")
                run_b.text = "mock"
                def rows = [ ['run_A.mzML', 'cancer', null, 'DDA'], ['run_B.mzML', 'saliva', 1, 'DDA'] ]
                def argv = ['--match', '--psm', '@PSM@', '--manifest', '@MANIFEST@', '--toaddresiduals', 'HexNAc(1)', '--nopasef', 'true']
                input[0] = channel.of([ [ id: 'cancer', group: 'cancer' ], group, [ run_a, run_b ], rows, argv ])
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert file(process.out.psm_dir[0][1]).name == 'cancer' },
                // TabWorkflow.manifestSave: path, experiment, bioreplicate, data type; no final newline
                { assert path(process.out.manifest[0][1]).text == "spectra/run_A.mzML\tcancer\t\tDDA\nspectra/run_B.mzML\tsaliva\t1\tDDA" },
                { assert snapshot(process.out).match() }
            )
        }
    }

    // FragPipe stops without glycan residues (CmdMBGMatch.java:145-158); the script block stops before any tool runs
    test("mbg - argv without --toaddresiduals fails") {
        tag "stub"

        when {
            process {
                """
                def group = file("\${workDir}/cancer")
                group.mkdirs()
                file("\${group}/psm.tsv").text = "Spectrum\\tSpectrum File\\n"
                def run_a = file("\${workDir}/run_A.mzML")
                run_a.text = "mock"
                def rows = [ ['run_A.mzML', 'cancer', null, 'DDA'] ]
                def argv = ['--match', '--psm', '@PSM@', '--manifest', '@MANIFEST@']
                input[0] = channel.of([ [ id: 'cancer', group: 'cancer' ], group, [ run_a ], rows, argv ])
                """
            }
        }

        then {
            assertAll (
                { assert !process.success },
                { assert (process.stdout + process.stderr).any { line -> line.contains('no glycan residues or mods specified for MBG') } }
            )
        }
    }
}
