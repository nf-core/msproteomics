/*
 * Config for the MERGE_SPLIT_SEARCH integration test.
 *
 * The module has no container of its own (MSFragger is licensed and must be
 * user-supplied), so the test needs the FragPipe image. Pass it with the
 * FRAGPIPE_CONTAINER environment variable, e.g.
 *   FRAGPIPE_CONTAINER=docker.io/altoslabscom/fragpipe:24.0-academic \
 *     nf-test test modules/local/merge_split_search/tests/main.nf.test --tag integration --profile +docker
 */

params.fragpipe_container = System.getenv('FRAGPIPE_CONTAINER') ?: params.fragpipe_container
if (!params.fragpipe_container) {
    throw new IllegalArgumentException('MERGE_SPLIT_SEARCH integration test needs a FragPipe image: set FRAGPIPE_CONTAINER (or params.fragpipe_container)')
}

process {
    withName: 'MERGE_SPLIT_SEARCH' {
        container = { params.fragpipe_container }
    }
}
