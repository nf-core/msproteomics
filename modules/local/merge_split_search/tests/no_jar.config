/*
 * Config for the MERGE_SPLIT_SEARCH "no MSFragger jar" test.
 *
 * Runs the real script: block on the host with no container and a tools dir
 * that does not exist, so no MSFragger jar can be found.
 */

docker.enabled      = false
singularity.enabled = false
conda.enabled       = false

process {
    withName: 'MERGE_SPLIT_SEARCH' {
        ext.fragpipe_tools_dir = '/nonexistent/fragpipe-24.0/tools'
    }
}
