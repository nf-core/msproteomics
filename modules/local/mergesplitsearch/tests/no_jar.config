/*
 * Config for the MERGESPLITSEARCH "no MSFragger jar" test.
 *
 * Runs the real script: block on the host with no container and a tools dir
 * that does not exist, so the MSFragger jar in --msfragger_cmd is missing
 * (nf-core/msproteomics 5b43675).
 */

docker.enabled      = false
singularity.enabled = false
conda.enabled       = false

process {
    withName: 'MERGESPLITSEARCH' {
        ext.fragpipe_tools_dir = '/nonexistent/fragpipe-24.0/tools'
    }
}
