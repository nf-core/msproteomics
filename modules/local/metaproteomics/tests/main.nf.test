// FragPipe Metaproteomics (FP-Meta 1.0.1 DbOptimizer, FragPipe 24.0 CmdMetaproteomics.java).
// The project dir holds what FP-Meta reads from FragPipe's work dir: MSFragger <run>.pin and
// Percolator <run>_percolator_{target,decoy}_psms.tsv (Input/PercolatorPin, Input/MSFraggerPin).
nextflow_process {
    name "Test Process METAPROTEOMICS"
    script "../main.nf"
    process "METAPROTEOMICS"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "metaproteomics"

    test("metaproteomics - stub stages the project files flat") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                def fixtures = "${baseDir}/tests/fixtures/metaproteomics"
                def config_cli = [qvalue: '0.01', deltaHyperscore: '0.0', minPeptCntPerProt: '1', minUniqPeptCntPerProt: '1', minUniqPeptCnt: '3', hostName: '"Homo sapiens"', iterations: '3', cmdLineOpts: '']
                input[0] = channel.of([
                    [ id: 'fragpipe' ],
                    ['dda_silac_subset.pin', 'dda_silac_subset_percolator_target_psms.tsv', 'dda_silac_subset_percolator_decoy_psms.tsv']
                        .collect { name -> file("\${fixtures}/\${name}", checkIfExists: true) },
                    config_cli
                ])
                input[1] = file("\${fixtures}/database.fasta", checkIfExists: true)
                input[2] = []
                input[3] = []
                input[4] = 'DECOY_'
                """
            }
        }

        then {
            def log_lines = new File(process.out.results_dir[0][1].toString(), 'metaproteomics.log').readLines()
            assertAll(
                { assert process.success },
                { assert log_lines[0].trim() == 'DbOptimizer --decoyTag DECOY_ --qvalue 0.01 --hostName \\"Homo\\ sapiens\\" --iterations 3' },
                { assert log_lines.drop(1) == ['dda_silac_subset.pin', 'dda_silac_subset_percolator_decoy_psms.tsv', 'dda_silac_subset_percolator_target_psms.tsv'] },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("metaproteomics - integration DbOptimizer over Percolator and MSFragger outputs") {
        tag "integration"

        when {
            process {
                """
                def fixtures = "${baseDir}/tests/fixtures/metaproteomics"
                def config_cli = [qvalue: '0.01', deltaHyperscore: '0.0', minPeptCntPerProt: '1', minUniqPeptCntPerProt: '1', minUniqPeptCnt: '3', hostName: '"Mus musculus"', iterations: '3', cmdLineOpts: '']
                input[0] = channel.of([
                    [ id: 'fragpipe' ],
                    file("\${fixtures}/*{.pin,_psms.tsv}", checkIfExists: true),
                    config_cli
                ])
                input[1] = file("\${fixtures}/database.fasta", checkIfExists: true)
                input[2] = file("\${fixtures}/names.dmp", checkIfExists: true)
                input[3] = file("\${fixtures}/nodes.dmp", checkIfExists: true)
                input[4] = 'rev_'
                """
            }
        }

        then {
            def outputs = new File(process.out.results_dir[0][1].toString()).list().sort()
            assertAll(
                { assert process.success },
                { assert outputs == ['DbOptimizerConfig.yaml', 'inferred_most_abundant_1_species_proteomes.fasta', 'metaproteomics.log', 'species_score_matrix_final.tsv', 'taxon_lineage.tsv'] },
                { assert snapshot(outputs).match() }
            )
        }
    }
}
