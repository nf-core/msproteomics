/*
 * Golden test configuration (PXD001468/Basic-Search_submzml_secondpass): the licensed FragPipe image is given at runtime,
 *   FRAGPIPE_CONTAINER=<image> GOLDEN_ROOT=<golden root> nf-test test modules/local/msfragger/tests/golden_secondpass.nf.test
 * Resources as the golden FragPipe run (4 threads, -Xmx28G); withName overrides conf/modules.config.
 */

process {
    container      = System.getenv('FRAGPIPE_CONTAINER') ?: { throw new IllegalStateException('set FRAGPIPE_CONTAINER to the licensed FragPipe 24.0 image for the golden tests') }()
    resourceLimits = [cpus: 4, memory: 32.GB, time: 4.h]

    withName: 'MSFRAGGER' {
        cpus         = 4
        memory       = 32.GB
        ext.java_xmx = 28
    }
}

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}
