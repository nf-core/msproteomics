nextflow_process {

    name "Test Process MSSTATSLFQ"
    script "../main.nf"
    process "MSSTATSLFQ"

    tag "modules"
    tag "modules_nfcore"
    tag "msstats_lfq"

    test("msstats_lfq - stub") {
        tag "stub"
        options "-stub"

        when {
            process {
                """
                def csv_input = file("\${workDir}/msstats_input.csv")
                csv_input.text = "mock"

                input[0] = csv_input
                input[1] = 'pairwise'
                input[2] = ''
                input[3] = true
                input[4] = true
                input[5] = 'top3'
                input[6] = 'TMP'
                input[7] = 0.05
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(process.out.msstats_csv, process.out.log).match() }
            )
        }
    }
}
