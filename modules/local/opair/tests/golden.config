params.fragpipe_container = System.getenv('FRAGPIPE_CONTAINER')
docker.enabled    = true
docker.runOptions = '-u $(id -u):$(id -g)'
process {
    resourceLimits = [cpus: 48, memory: 220.GB, time: 8.h]
    withName: 'OPAIR' {
        cpus        = 48
        memory      = 202.GB
        stageInMode = 'copy'
        container   = { params.fragpipe_container }
        // deterministic O-Pair DLL given at runtime (golden.nf.test); without OPAIR_DET_DLL docker stops with
        // "bind source path does not exist: /OPAIR_DET_DLL-is-not-set" (a --mount bind never creates its source)
        containerOptions = "--mount type=bind,src=${System.getenv('OPAIR_DET_DLL') ?: '/OPAIR_DET_DLL-is-not-set'},dst=/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/tools/opair/PTMLocalization.dll,readonly"
    }
}
