nextflow_process {

    name "Test Process OPAIR"
    script "../main.nf"
    process "OPAIR"

    tag "modules"
    tag "modules_local"
    tag "opair"

    test("opair - stub - group copy and filelist_opair.txt") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                def group = file("\${workDir}/g1")
                group.mkdirs()
                file("\${group}/psm.tsv").text = "Spectrum\\tSpectrum File\\nrun_A.1.1.2\\trun_A.pepXML\\n"
                def cal_a = file("\${workDir}/run_A_calibrated.mzML")
                cal_a.text = "mock"
                def cal_b = file("\${workDir}/run_B_calibrated.mzML")
                cal_b.text = "mock"
                def pairs_a = file("\${workDir}/run_A.pairs")
                pairs_a.text = "1\\t2\\n"
                def argv = ['-b 20.0', '-c 20.0', '-z ', '-t @THREADS@', '-r @FILELIST@', '-s @PSM@', '-o @OUTDIR@']
                input[0] = channel.of([
                    [ id: 'g1', group: 'g1' ],
                    group,
                    [ cal_a, cal_b ],
                    [ pairs_a ],
                    [],
                    [ 'run_A_calibrated.mzML', 'run_B_calibrated.mzML' ],
                    argv
                ])
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert file(process.out.psm_dir[0][1]).name == 'g1' },
                { assert path("${process.out.psm_dir[0][1]}/filelist_opair.txt").readLines() == ['spectra/run_A_calibrated.mzML', 'spectra/run_B_calibrated.mzML'] },
                { assert snapshot(process.out).match() }
            )
        }
    }

    // CmdOPair.java:178-180: a user oxonium file is "-f " + its path; here it is staged as oxonium/<name>
    test("opair - stub - user oxonium file is staged and named by the -f token") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                def group = file("\${workDir}/g1")
                group.mkdirs()
                file("\${group}/psm.tsv").text = "Spectrum\\tSpectrum File\\nrun_A.1.1.2\\trun_A.pepXML\\n"
                def cal_a = file("\${workDir}/run_A_calibrated.mzML")
                cal_a.text = "mock"
                def oxo = file("\${workDir}/my_oxonium.txt")
                oxo.text = "204.0867\\tHexNAc\\n"
                def argv = ['-b 20.0', '-f @OXONIUM_FILE@', '-m 0.05', '-z ', '-t @THREADS@', '-r @FILELIST@', '-s @PSM@', '-o @OUTDIR@']
                input[0] = channel.of([
                    [ id: 'g1', group: 'g1' ],
                    group,
                    [ cal_a ],
                    [],
                    oxo,
                    [ 'run_A_calibrated.mzML' ],
                    argv
                ])
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert path("${process.out.log[0][1]}").readLines().contains('-f {TASK_DIR}/oxonium/my_oxonium.txt') },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
