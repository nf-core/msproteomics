params.fragpipe_container = System.getenv('FRAGPIPE_CONTAINER')
docker.enabled    = true
docker.runOptions = '-u $(id -u):$(id -g)'
process {
    resourceLimits = [cpus: 48, memory: 220.GB, time: 8.h]
    withName: 'PAIRSCANS' {
        cpus        = 48
        memory      = 202.GB
        container   = { params.fragpipe_container }
    }
}
