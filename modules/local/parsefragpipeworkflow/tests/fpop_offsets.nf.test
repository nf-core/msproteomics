// FragPipe 24.0 parity for FPOP, FPOP coADAPTr, Metaproteomics and detailed mass offsets
// (review items P-01..P-11, RC-34).
// The real parser runs (no -stub) on FragPipe 24.0 workflows copied verbatim into
// tests/fixtures/fragpipe_workflows/, plus two marked test copies (FPOP-quant-meta, TMT10-fpop).
//
// Expected modlist / PTM-Shepherd mass_offsets strings were produced by running FragPipe's own
// expressions under Java 17 (FragPipe 24.0 bundles JRE 17): TreeSet<Float> of var/fix mods and
// getMassOffsetSet() printed with Float.toString (FragpipeRun.java:1852-1855, CmdIonquant.java:346-357),
// and Double.toString of each MassOffset(String).mass joined with "/"
// (TabMsfragger.getRegularOffsetStringFromDetailedOffsets).
nextflow_process {

    name "Test Process PARSEFRAGPIPEWORKFLOW - FPOP, Metaproteomics, detailed mass offsets"
    script "../main.nf"
    process "PARSEFRAGPIPEWORKFLOW"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "parse_fragpipe_workflow"
    tag "stub"

    test("parse_fragpipe_workflow - FPOP, Metaproteomics and mass offsets match FragPipe 24.0") {

        when {
            process {
                """
                def names = ['FPOP', 'FPOP-quant-meta', 'Mass-Offset-CommonPTMs', 'XRNAX-MassOffset', 'Labile_ADP-ribosylation', 'TMT10-fpop']
                // FragPipe writes shepherd.config only when PTM-Shepherd runs (FragpipeRun.java:2124-2126): the
                // detailed-offset workflows that do not run it are checked with it switched on
                def with_ptms = ['FPOP', 'Labile_ADP-ribosylation'].collect { n ->
                    def f = file("\${workDir}/\${n}-ptms.workflow")
                    f.text = file("${baseDir}/tests/fixtures/fragpipe_workflows/\${n}.workflow", checkIfExists: true).readLines()
                        .collect { line -> line.startsWith('ptmshepherd.run-shepherd=') ? 'ptmshepherd.run-shepherd=true' : line }.join('\\n') + '\\n'
                    [ [ id: "\${n}-ptms".toString() ], f, ['DDA'] ]
                }
                input[0] = channel.fromList(names).map { n ->
                    [ [ id: n ], file("${baseDir}/tests/fixtures/fragpipe_workflows/\${n}.workflow", checkIfExists: true), ['DDA'] ]
                }.mix(channel.fromList(with_ptms))
                """
            }
        }

        then {
            def slurper = new groovy.json.JsonSlurper()
            def json = process.out.tool_configs_json.collectEntries { meta, path -> [meta.id, slurper.parse(new File(path.toString()))] }
            def configs = process.out.all_configs.collectEntries { meta, dir -> [meta.id, dir.toString()] }
            def shepherd = { id -> new File(configs[id], 'shepherd.config').readLines().find { line -> line.startsWith('mass_offsets = ') } }
            def tmti_unmod = new File(configs['TMT10-fpop'], 'tmtintegrator_unmod.yml').readLines()
            def tmti = new File(configs['TMT10-fpop'], 'tmtintegrator.yml').readLines()
            assertAll(
                { assert process.success },
                // P-09: IonQuant modlist includes the detailed offsets (FPOP, Labile_ADP-ribosylation)
                { assert json['FPOP'].ionquant.modmasses == '-43.9898,-43.0534,-41.02656,-30.0106,-27.9949,-25.03166,-23.016,-22.032,-10.032,-9.03676,4.9735,13.9793,15.9949,31.9898,42.0106,47.9847,57.02146'.tokenize(',') },
                // Labile_ADP-ribosylation has quantitation.run-label-free-quant=false: no label-free IonQuant
                // runs (QuantPanelLabelfree.isRunIonQuant(), RC-05), so it has no mod mass list
                { assert json['Labile_ADP-ribosylation'].ionquant.run == false && !json['Labile_ADP-ribosylation'].ionquant.containsKey('modmasses') },
                // P-10: PTM-Shepherd mass_offsets = getMassOffsets(); no shepherd.config when PTM-Shepherd does not run
                { assert !new File(configs['FPOP'], 'shepherd.config').exists() },
                { assert shepherd('FPOP-ptms') == 'mass_offsets = 0.0/-43.98979949951172/-43.05339813232422/-30.01059913635254/-27.99489974975586/-23.016000747680664/-22.031999588012695/-10.031999588012695/4.973499774932861/13.979299545288086/15.99489974975586/-41.02656173706055/31.98979949951172/-25.031660079956055/47.98469924926758/-9.036760330200195' },
                { assert shepherd('Labile_ADP-ribosylation-ptms') == 'mass_offsets = 0.0/541.0610961914062/541.0610961914062/484.0396423339844' },
                { assert shepherd('Mass-Offset-CommonPTMs') == 'mass_offsets = 541.0610961914062/484.03961181640625/406.15869140625/365.1322021484375/349.1372985839844/340.1005859375/301.98651123046875/238.22970581054688/229.01400756835938/228.11099243164062/210.19839477539062/203.07940673828125/183.035400390625/181.2082061767578/178.04769897460938/176.0321044921875/162.05279541015625/153.17689514160156/147.1663055419922/146.0579071044922/114.04290008544922/105.03140258789062/100.01599884033203/86.00039672851562/79.96630096435547/79.96630096435547/79.95680236816406/71.03710174560547/70.04190063476562/68.02619934082031/61.982601165771484/61.92179870605469/61.91350173950195/57.02149963378906/55.919700622558594/53.9193000793457/52.9114990234375/47.98469924926758/44.98509979248047/43.98979949951172/43.00579833984375/42.047000885009766/42.01060104370117/37.95589828491211/37.9468994140625/31.98979949951172/31.97209930419922/30.01059913635254/29.974199295043945/28.99020004272461/28.978900909423828/28.031299591064453/27.99489974975586/26.01569938659668/23.958099365234375/22.944900512695312/22.935400009155273/21.98189926147461/21.96940040588379/19.98979949951172/15.99489974975586/14.015700340270996/13.979299545288086/13.020400047302246/12.0/3.9948999881744385/0.984000027179718/0.0/-0.984000027179718/-2.015700101852417/-9.036700248718262/-14.015700340270996/-15.010899543762207/-17.026500701904297/-18.01059913635254/-25.031600952148438/-25.049400329589844/-28.031299591064453/-30.01059913635254/-32.00849914550781/-41.0265007019043/-43.00579833984375/-45.02149963378906/-58.029300689697266/-91.00920104980469/-116.05860137939453' },
                { assert shepherd('XRNAX-MassOffset') == 'mass_offsets = 0' },
                // P-11: PTMProphet auto mods merge the detailed offsets' residues
                { assert json['Labile_ADP-ribosylation'].ptmprophet.args.contains(' M:15.9949,n:42.0106,SKRTYHDE:541.0611,C:484.03964 ') },
                // P-04: FPOP coADAPTr masses, %.4f comma-joined (FpopCoadaptrPanel.getFpopMods)
                { assert json['FPOP'].fpop_coadaptr == [run: true, args: '15.9949,31.9898,47.9847,13.9793,-43.0534,-22.0320,-23.0159,-10.0319,4.9735,-30.0106,-27.9949,-43.9898,-25.0316,-9.0367', config_type: 'cli'] },
                // P-01: FPOP Quant arguments come from fpop.fragpipe.fpop.*
                { assert json['FPOP'].fpop.run == false },
                { assert json['FPOP-quant-meta'].fpop.args == ['combined_modified_peptide.tsv', '2', 'CTRL', 'OX', 'false', 'false'] },
                // P-05: FP-Meta values in CmdMetaproteomics order; host name quoted once, cmd-line-opts one trimmed element
                { assert json['FPOP-quant-meta'].metaproteomics.args == [qvalue: '0.01', deltaHyperscore: '0.0', minPeptCntPerProt: '1', minUniqPeptCntPerProt: '1', minUniqPeptCnt: '3', hostName: '"Homo sapiens"', iterations: '3', cmdLineOpts: '--foo 1'] },
                // P-03: FPOP TMT runs TMT-Integrator a second time with mod_tag none, min_site_prob -1
                { assert json['TMT10-fpop'].tmtintegrator_unmod.run == true },
                { assert json['FPOP'].tmtintegrator_unmod.run == false },
                { assert json['TMT10-fpop'].fpop.args == ['tmt-report/abundance_multi-site_MD.tsv', '1', '', '', 'false', 'true', 'tmt-report-unmod/abundance_peptide_MD.tsv'] },
                { assert tmti.contains('  mod_tag: M(15.9949)') && tmti.contains('  min_site_prob: 0.75') },
                { assert tmti_unmod.contains('  mod_tag: none') && tmti_unmod.contains('  min_site_prob: -1') },
                { assert tmti_unmod.findAll { line -> !(line.startsWith('  mod_tag:') || line.startsWith('  min_site_prob:')) } == tmti.findAll { line -> !(line.startsWith('  mod_tag:') || line.startsWith('  min_site_prob:')) } },
                { assert snapshot(process.out.tool_configs_json, process.out.all_configs).match() }
            )
        }
    }

    test("parse_fragpipe_workflow - FPOP TMT without TMT-Integrator fails like FragPipe") {

        when {
            process {
                """
                def workflow_file = file("\${workDir}/fpop_tmt.workflow")
                workflow_file.text = file("${baseDir}/tests/fixtures/fragpipe_workflows/FPOP.workflow").text
                    .replace('fpop.fragpipe.fpop.run-fpop=false', 'fpop.fragpipe.fpop.run-fpop=true')
                    .replace('fpop.fragpipe.fpop.fpop-tmt=false', 'fpop.fragpipe.fpop.fpop-tmt=true')
                input[0] = channel.of([[ id: 'fpop_tmt' ], workflow_file, ['DDA']])
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).any { line -> line.contains('FPOP TMT Quant was requested on Downstream tab, but TMT-Integrator is not run') } || process.stderr.any { line -> line.contains('FPOP TMT Quant was requested on Downstream tab, but TMT-Integrator is not run') } }
            )
        }
    }
}
