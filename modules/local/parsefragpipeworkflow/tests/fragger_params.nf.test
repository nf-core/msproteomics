// RC-17 / RC-18: the MSFragger params files must be byte-identical to the ones FragPipe 24.0 writes.
//
// Expected files in tests/fixtures/fragger_params/<case>/ were written by FragPipe 24.0 itself, not
// derived from the parser:
//   - every case: `fragpipe --headless` on fragpipe.workflow with a DDA, a DIA, a GPF-DIA and a
//     DDA+ file in the manifest, which makes CmdMsfragger.configure save fragger_dda.params,
//     fragger_dia.params, fragger_gpfdia.params and fragger_dda_plus.params
//     (FP/cmd/CmdMsfragger.java:444-468). Tools other than MSFragger are off in those workflows.
//     orig_glyco-N-HCD is the bundled glyco-N-HCD workflow with its own run flags: PeptideProphet is
//     on, so the DIA/DDA+ files make FragPipe switch to Percolator and output_format = pepXML_pin
//     (FP/tabs/TabWorkflow.java:1476-1513, FP/tools/pepproph/PepProphPanel.java:102-107,
//     FP/tools/percolator/PercolatorPanel.java:101-106).
//     crafted_cap512 / crafted_cap1024 are glyco-N-DIA with enzyme and deisotope values that disagree
//     with their dropdowns, with 287 and 412 workflow keys: FragPipe loads the workflow from a
//     java.util.HashMap, and the table size decides whether the enzyme dropdown listener runs before
//     or after search_enzyme_nocut_* / search_enzyme_sense_* (FP/tabs/TabMsfragger.java:699-753).
// Normalization: the database_name and
// num_threads values come from the FragPipe run inputs (FASTA path, --threads), not from the workflow.

nextflow_process {

    name "Test Process PARSEFRAGPIPEWORKFLOW - fragger.params identical to FragPipe 24.0"
    script "../main.nf"
    process "PARSEFRAGPIPEWORKFLOW"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "parse_fragpipe_workflow"
    tag "stub"

    test("parse_fragpipe_workflow - fragger params byte-identical to FragPipe for bundled workflows") {
        options "-stub"

        when {
            process {
                """
                def cases = ['DIA_SpecLib_Quant', 'glyco-N-HCD', 'Mass-Offset-CommonPTMs', 'XRNAX-MassOffset', 'Labile_ADP-ribosylation', 'glyco-N-DIA', 'crafted_cap512', 'crafted_cap1024', 'orig_glyco-N-HCD']
                input[0] = channel.fromList(cases).map { n ->
                    [ [ id: n ], file("${baseDir}/tests/fixtures/fragger_params/\${n}/fragpipe.workflow", checkIfExists: true),
                      ['DDA', 'DIA', 'GPF-DIA', 'DDA+'] ]
                }
                """
            }
        }

        then {
            def fixtures = "${baseDir}/tests/fixtures/fragger_params"
            def normalize = { String text ->
                text.replaceAll(/(?m)^database_name = [^\t\n]*/, 'database_name = <DB>')
                    .replaceAll(/(?m)^num_threads = [0-9]*/, 'num_threads = <THREADS>')
            }
            // parser output channel -> FragPipe file name (fragger_dda.params when the run has DIA files)
            def outputs = [
                'fragger_dda.params'     : process.out.msfragger_config,
                'fragger_dia.params'     : process.out.msfragger_dia_config,
                'fragger_gpfdia.params'  : process.out.msfragger_gpfdia_config,
                'fragger_dda_plus.params': process.out.msfragger_dda_plus_config,
            ]
            def compared = 0
            def mismatches = []
            outputs.each { fpName, channelOut ->
                channelOut.each { meta, path ->
                    def expectedFile = new File("${fixtures}/${meta.id}/${fpName}")
                    if (!expectedFile.exists()) {
                        expectedFile = new File("${fixtures}/${meta.id}/fragger.params")
                        if (fpName != 'fragger_dda.params' || !expectedFile.exists()) {
                            return
                        }
                    }
                    compared++
                    def actual = normalize(new File(path.toString()).getText('UTF-8'))
                    def expected = normalize(expectedFile.getText('UTF-8'))
                    if (actual != expected) {
                        def a = actual.readLines()
                        def e = expected.readLines()
                        def i = (0..<Math.max(a.size(), e.size())).find { a[it] != e[it] }
                        mismatches << "${meta.id}/${fpName} line ${i + 1}: got [${a[i]}] FragPipe [${e[i]}]"
                    }
                }
            }
            assertAll(
                { assert process.success },
                { assert compared == 36 : "compared ${compared} files" },
                { assert mismatches.isEmpty() : mismatches.join('\n') },
                { assert snapshot(
                    process.out.msfragger_config,
                    process.out.msfragger_dia_config,
                    process.out.msfragger_gpfdia_config,
                    process.out.msfragger_dda_plus_config
                ).match() }
            )
        }
    }
}
