// FragPipe 24.0 parity acceptance test for PARSEFRAGPIPEWORKFLOW.
// Written test-first: EXPECTED TO FAIL until RC-05 / RC-17 / RC-19 / RC-25 / RC-33
// of the FragPipe parity review are fixed.
//
// Inputs: 7 workflow files copied verbatim from FragPipe 24.0 (FragPipe/workflows/) into
// tests/fixtures/fragpipe_workflows/. The real parser runs (no -stub); it needs only python3.
//
// Every expected value is DERIVED here from the .workflow file with FragPipe's own rules
// (FP = FragPipe-GUI/src/main/java/org/nesvilab/fragpipe/), never from current parser output.
// .workflow files are java.util.Properties files, so they are loaded exactly as FragPipe does.
//
// No snapshot is recorded on purpose: a snapshot taken now would freeze the non-parity
// output. Add snapshot(...).match() once these assertions pass.

nextflow_process {

    name "Test Process PARSEFRAGPIPEWORKFLOW - FragPipe parity"
    script "../main.nf"
    process "PARSEFRAGPIPEWORKFLOW"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "parse_fragpipe_workflow"
    tag "parity"

    test("parse_fragpipe_workflow - FragPipe 24.0 run decisions for 7 bundled workflows") {

        when {
            process {
                """
                def names = ['Basic-Search', 'Open', 'glyco-N-LFQ', 'DIA_SpecLib_Quant', 'Nonspecific-HLA', 'TMT10', 'LFQ-MBR']
                input[0] = channel.fromList(names).map { n ->
                    [ [ id: n ], file("${baseDir}/tests/fixtures/fragpipe_workflows/\${n}.workflow", checkIfExists: true), n.startsWith('DIA') ? ['DIA'] : ['DDA'] ]
                }
                """
            }
        }

        then {
            def fixtures = "${baseDir}/tests/fixtures/fragpipe_workflows"
            def slurper  = new groovy.json.JsonSlurper()
            def truthy   = { v -> v != null && v.toString().trim().equalsIgnoreCase('true') }

            // FP/tools/crystalc/crystalc.params:9-13, loaded by FP/tools/crystalc/CrystalcPanel.java:139-148
            // (toParams() -> p.loadDefault(); GUI spinners are commented out, so these defaults are what runs).
            def crystalcDefaults = [
                precursor_charge          : '1 6',
                isotope_number            : '3',
                precursor_mass            : '20',
                precursor_isolation_window: '0.7',
                correct_isotope_error     : 'false'
            ]

            def bad = [ionquant: [], freequant: [], filter_prot: [], ptmshepherd: [], combine: [], fragger_lists: [], crystalc: []]

            process.out.tool_configs_json.each { meta, json_path ->
                def name  = meta.id
                def props = new Properties()
                new File("${fixtures}/${name}.workflow").withInputStream { props.load(it) }
                def flag  = { k -> truthy(props.getProperty(k)) }
                def cfg   = slurper.parse(new File(json_path.toString()))

                // ---- RC-05: label-free quant gate -------------------------------------------------
                // FP/tools/ionquant/QuantPanelLabelfree.java:110-116
                //   isRunIonQuant()  = isRun() && uiRadioUseIonquant ; isRunFreeQuant() = isRun() && uiRadioUseFreequant
                // FP/tools/ionquant/QuantPanelLabelfree.java:187-188  checkRun name = "quantitation.run-label-free-quant"
                def lfq        = flag.call('quantitation.run-label-free-quant')
                def expIonQ    = lfq && flag.call('ionquant.run-ionquant')
                def expFreeQ   = lfq && flag.call('freequant.run-freequant')
                if (truthy(cfg.ionquant?.run) != expIonQ)   bad.ionquant  << "${name}: ionquant.run=${cfg.ionquant?.run}, FragPipe isRunIonQuant=${expIonQ}"
                if (truthy(cfg.freequant?.run) != expFreeQ) bad.freequant << "${name}: freequant.run=${cfg.freequant?.run}, FragPipe isRunFreeQuant=${expFreeQ}"

                // ---- RC-05: filter --prot rewrite only for label-free IonQuant ---------------------
                // FP/FragpipeRun.java:1758-1761 passes quantPanelLabelfree.isRunIonQuant() to CmdPhilosopherFilter.
                // FP/cmd/CmdPhilosopherFilter.java:85-96: strip --razor; if isRunIonQuant replace/append --prot 0.01;
                //   THEN if dont-use-prot-proph-file strip --sequential and --prot.
                def ft = (props.getProperty('phi-report.filter') ?: '').replaceAll('--razor', '')
                if (expIonQ) {
                    ft = ft.replaceAll(/--prot\s+[^\s]+/, '--prot 0.01')
                    if (!ft.contains('--prot')) ft = ft + ' --prot 0.01'
                }
                if (flag.call('phi-report.dont-use-prot-proph-file')) {
                    ft = ft.replaceAll('--sequential', '').replaceAll(/--prot\s+[^\s]+/, '')
                }
                def protOf  = { String s -> def m = (s =~ /--prot\s+(\S+)/); m.find() ? m.group(1) : null }
                def expProt = protOf.call(ft)
                def actProt = protOf.call((cfg.filter?.args ?: '').toString())
                if (expProt != actProt) bad.filter_prot << "${name}: filter '--prot ${actProt}', FragPipe '--prot ${expProt}' (filter text: '${ft.trim()}')"

                // ---- RC-33: PTM-Shepherd gate ------------------------------------------------------
                // FP/FragpipeRun.java:2096  isRunShepherd = ptmshepherdPanel.isRun() || ptmsGlycanPanel.isRun()
                // FP/tools/ptmshepherd/PtmshepherdPanel.java:326,800 (run-shepherd); PTMSGlycanAssignPanel.java:117-119,151 (run_glyco_mode)
                def expPtms = flag.call('ptmshepherd.run-shepherd') || flag.call('ptmshepherd.run_glyco_mode')
                if (truthy(cfg.ptmshepherd?.run) != expPtms) bad.ptmshepherd << "${name}: ptmshepherd.run=${cfg.ptmshepherd?.run}, FragPipe isRunShepherd=${expPtms}"

                // ---- RC-25: PeptideProphet --combine -----------------------------------------------
                // FP/tools/pepproph/PepProphPanel.java:154 checkbox name "combine-pepxml"; FP/FragpipeRun.java:1593,1612
                // FP/cmd/CmdPeptideProphet.java:190-202 (--combine in cmd-opts also forces combine)
                // FP/cmd/CmdPeptideProphet.java:329  cmd.add("--combine") when combine
                if (flag.call('peptide-prophet.run-peptide-prophet')) {
                    def expCombine = flag.call('peptide-prophet.combine-pepxml') ||
                        (props.getProperty('peptide-prophet.cmd-opts') ?: '').toLowerCase().contains('--combine')
                    def ppArgs     = (cfg.peptideprophet?.args ?: '').toString()
                    def actCombine = ppArgs.contains('--combine') || truthy(cfg.peptideprophet?.combine)
                    if (actCombine != expCombine) bad.combine << "${name}: peptideprophet combine=${actCombine} (args '${ppArgs}'), FragPipe combine=${expCombine}"
                }

                // ---- RC-17: MSFragger list params in fragger.params file format --------------------
                // FP/tabs/TabMsfragger.java:293-302  mass_offsets: blank -> "0"; else TreeSet<String> of
                //   String.valueOf(Float.parseFloat(part)) over split("[\\s/]+"), joined with "/"
                // FP/tabs/TabMsfragger.java:311-313  Y_type_masses / diagnostic_fragments / remainder_fragment_masses:
                //   s.replaceAll("[\\s]+", "/")   (keys: FP/tools/fragger/MsfraggerParams.java:64-66,101)
                def fragger = [:]
                (cfg.msfragger?.args ?: '').toString().eachLine { l ->
                    // FragPipe appends "\t\t\t# <comment>" (FP/params/Props.java:259-264)
                    def m = (l =~ /^\s*([A-Za-z0-9_]+)\s*=\s*(.*?)\s*(?:\t\t\t#.*)?$/)
                    if (m.find()) fragger[m.group(1)] = m.group(2)
                }
                def mo = props.getProperty('msfragger.mass_offsets')
                def expected_lists = [
                    mass_offsets: (mo == null || mo.trim().isEmpty()) ? '0' :
                        new TreeSet<String>(mo.trim().split(/[\s\/]+/).collect { String.valueOf(Float.parseFloat(it)) }).join('/')
                ]
                ['Y_type_masses', 'diagnostic_fragments', 'remainder_fragment_masses'].each { k ->
                    def v = props.getProperty("msfragger.${k}")
                    if (v != null && !v.trim().isEmpty()) expected_lists[k] = v.replaceAll(/[\s]+/, '/')
                }
                expected_lists.each { k, v ->
                    if (fragger[k] != v) {
                        def shown = { s -> s == null ? 'null' : (s.size() > 60 ? s.take(60) + '...' : s) }
                        bad.fragger_lists << "${name}: ${k} = '${shown.call(fragger[k])}', FragPipe '${shown.call(v)}'"
                    }
                }

                // ---- RC-19: Crystal-C algorithm params ---------------------------------------------
                // FP/FragpipeRun.java:1642 crystalcPanel.isRun(); params from CrystalcPanel.toParams() (defaults above),
                // runtime paths added by FP/cmd/CmdCrystalc.java:190-196.
                def expCc = flag.call('crystalc.run-crystalc')
                if (truthy(cfg.crystalc?.run) != expCc) {
                    bad.crystalc << "${name}: crystalc.run=${cfg.crystalc?.run}, FragPipe=${expCc}"
                } else if (expCc) {
                    def cc = [:]
                    (cfg.crystalc?.args ?: '').toString().eachLine { l ->
                        // FragPipe appends "\t\t\t# <comment>" (FP/params/Props.java:259-264)
                    def m = (l =~ /^\s*([A-Za-z0-9_]+)\s*=\s*(.*?)\s*(?:\t\t\t#.*)?$/)
                        if (m.find()) cc[m.group(1)] = m.group(2)
                    }
                    crystalcDefaults.each { k, v ->
                        if (cc[k] != v) bad.crystalc << "${name}: crystalc ${k} = '${cc[k]}', FragPipe default '${v}'"
                    }
                }
            }

            assertAll(
                { assert process.success },
                { assert process.out.tool_configs_json.size() == 7 },
                { assert bad.ionquant.isEmpty()      : "RC-05 IonQuant gate mismatches:\n  " + bad.ionquant.join('\n  ') },
                { assert bad.freequant.isEmpty()     : "RC-05 FreeQuant gate mismatches:\n  " + bad.freequant.join('\n  ') },
                { assert bad.filter_prot.isEmpty()   : "RC-05 filter --prot mismatches:\n  " + bad.filter_prot.join('\n  ') },
                { assert bad.ptmshepherd.isEmpty()   : "RC-33 PTM-Shepherd gate mismatches:\n  " + bad.ptmshepherd.join('\n  ') },
                { assert bad.combine.isEmpty()       : "RC-25 PeptideProphet --combine mismatches:\n  " + bad.combine.join('\n  ') },
                { assert bad.fragger_lists.isEmpty() : "RC-17 MSFragger list-param mismatches:\n  " + bad.fragger_lists.join('\n  ') },
                { assert bad.crystalc.isEmpty()      : "RC-19 Crystal-C mismatches:\n  " + bad.crystalc.join('\n  ') }
            )
        }
    }
}
