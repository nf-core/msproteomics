    }

    // FP/FragpipeRun.java:2388-2391 runs CmdWriteSubMzml when tab-run.write_sub_mzml=true (TabRun.java:220-221,
    // :487-488); the Run tab turns "Print decoys" on (TabRun.java:240-243), so Report gets --decoys
    test("Write sub mzML runs with its threshold and report decoys") {
        options "-stub"

        when {
            process {
                """
                def wf = file("\${workDir}/write_sub_mzml.workflow")
                wf.text = file("${baseDir}/tests/fixtures/fragpipe_workflows/LFQ-MBR.workflow", checkIfExists: true).text
                    .replace('tab-run.write_sub_mzml=false', 'tab-run.write_sub_mzml=true')
                input[0] = [ [ id: 'sub' ], wf, ['DDA'] ]
                """
            }
        }

        then {
            def json = new groovy.json.JsonSlurper().parse(new File(process.out.tool_configs_json[0][1].toString()))
            assertAll(
                { assert process.success },
                { assert json.writesubmzml == [run: true, args: '', config_type: 'cli', prob_threshold: '0.5'] },
                { assert json.filter.report_args.tokenize().contains('--decoys') },
                { assert snapshot(json.writesubmzml, json.filter.report_args).match() }
            )
        }
    }

    // CmdWriteSubMzml.java:77-80: FragPipe stops for DIA, GPF-DIA, DIA-Lib or DDA+ files
    test("Write sub mzML with DIA files fails like FragPipe") {
        options "-stub"

        when {
            process {
                """
                def wf = file("\${workDir}/write_sub_mzml_dia.workflow")
                wf.text = file("${baseDir}/tests/fixtures/fragpipe_workflows/LFQ-MBR.workflow", checkIfExists: true).text
                    .replace('tab-run.write_sub_mzml=false', 'tab-run.write_sub_mzml=true')
                input[0] = [ [ id: 'sub_dia' ], wf, ['DDA', 'DIA'] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).join('\n').contains('ERROR: Write sub mzML was enabled but there are non-DDA data types.') }
            )
        }
    }

    test("audit B - MSBooster with an open search fails") {
        options "-stub"

        when {
            process {
                """
                // FP/cmd/CmdMSBooster.java:107-111: Da units, lower < -3 and upper > 3 (TabMsfragger.isOpenSearch)
                def wf = file("\${workDir}/msbooster_with_an_open_search_fails.workflow")
                wf.text = file("${baseDir}/tests/fixtures/fragpipe_workflows/LFQ-MBR.workflow", checkIfExists: true).text
                    .replace('msfragger.precursor_mass_lower=-20', 'msfragger.precursor_mass_lower=-150')
                    .replace('msfragger.precursor_mass_units=1', 'msfragger.precursor_mass_units=0')
                    .replace('msfragger.precursor_mass_upper=20', 'msfragger.precursor_mass_upper=500')
                input[0] = [ [ id: 'refused' ], wf, ['DDA'] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).join('\n').contains("ERROR: MSBooster is incompatible with open search. Please disable MSBooster.") },
                { assert snapshot((process.stdout + process.stderr).collect { l -> l.trim() }.findAll { l -> l.startsWith('ERROR: ') }.unique()).match() }
            )
        }
    }

