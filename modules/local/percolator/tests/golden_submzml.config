/*
 * Golden test config for PERCOLATOR on PXD001468/Basic-Search_submzml: the licensed FragPipe image is given
 * at runtime, FRAGPIPE_CONTAINER=<image> GOLDEN_ROOT=<golden root> nf-test test modules/local/percolator/tests/golden_submzml.nf.test
 */
process {
    container      = System.getenv('FRAGPIPE_CONTAINER') ?: { throw new IllegalStateException('set FRAGPIPE_CONTAINER to the licensed FragPipe 24.0 image for the golden tests') }()
    resourceLimits = [cpus: 4, memory: 16.GB, time: 4.h]

    // the 4 threads of the golden FragPipe run; withName beats conf/modules.config labels
    withName: 'PERCOLATOR' {
        cpus     = 4
        memory   = 16.GB
        ext.args = ''
    }
}

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}
