nextflow_process {

    name "Test Process IPROPHET"
    script "../main.nf"
    process "IPROPHET"

    tag "modules"
    tag "modules_nfcore"
    tag "iprophet"

    test("iprophet - stub") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                ['interact-a.pep.xml', 'interact-b.pep.xml'].each { n -> file("\${workDir}/\${n}").text = 'mock' }
                input[0] = channel.of([[ id: 'fragpipe' ], [file("\${workDir}/interact-a.pep.xml"), file("\${workDir}/interact-b.pep.xml")],
                    ['A/interact-a.pep.xml', 'B/interact-b.pep.xml'], '--decoy rev_ --nonsp --output combined'])
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                // CmdIprophet.java:44-53
                { assert new File(process.out.results_dir.get(0).get(1), 'iprophet.log').readLines()[0] == '/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/tools/Philosopher/philosopher-v5.1.3-RC9 iprophet --decoy rev_ --nonsp --output combined --threads 2 {CWD}/A/interact-a.pep.xml {CWD}/B/interact-b.pep.xml' },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
