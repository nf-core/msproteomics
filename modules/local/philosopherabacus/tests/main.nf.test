nextflow_process {

    name "Test Process PHILOSOPHERABACUS"
    script "../main.nf"
    process "PHILOSOPHERABACUS"

    tag "modules"
    tag "modules_nfcore"
    tag "philosopher"
    tag "philosopher/abacus"

    test("philosopher_abacus - stub") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                ['A', 'B'].each { g -> file("\${workDir}/ws\${g}/.meta").mkdirs() }
                file("\${workDir}/combined.prot.xml").text = 'mock'
                input[0] = channel.of([[ id: 'fragpipe' ], [file("\${workDir}/wsA/.meta"), file("\${workDir}/wsB/.meta")], ['A', 'B'],
                    file("\${workDir}/combined.prot.xml"), [], '--picked --razor --reprint --tag rev_ --protein', 16])
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                // CmdPhilosopherAbacus.java:106-134: options, --labels --plex, group dirs
                { assert new File(process.out.results_dir.get(0).get(1), 'abacus.log').readLines()[0] == '/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/tools/Philosopher/philosopher-v5.1.3-RC9 abacus --picked --razor --reprint --tag rev_ --protein --labels --plex 16 A B' },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("philosopher_abacus - stub one group fails like FragPipe") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                file("\${workDir}/wsA/.meta").mkdirs()
                file("\${workDir}/combined.prot.xml").text = 'mock'
                input[0] = channel.of([[ id: 'fragpipe' ], [file("\${workDir}/wsA/.meta")], ['A'],
                    file("\${workDir}/combined.prot.xml"), [], '--razor --reprint --tag rev_', 0])
                """
            }
        }

        then {
            assertAll (
                { assert process.failed }
            )
        }
    }
}
