nextflow_process {

    name "Test Process PHILOSOPHERFILTER"
    script "../main.nf"
    process "PHILOSOPHERFILTER"

    tag "modules"
    tag "modules_local"
    tag "philosopherfilter"

    test("philosopher_filter - stub first group") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                ['interact-a.pep.xml', 'combined.prot.xml', 'db.fasta'].each { n -> file("\${workDir}/\${n}").text = 'mock' }
                input[0] = channel.of([[ id: 'A', group: 'A' ], file("\${workDir}/interact-a.pep.xml"), file("\${workDir}/combined.prot.xml"),
                    [], 'A', '--sequential --picked --prot 0.01', false, ''])
                input[1] = file("\${workDir}/db.fasta")
                input[2] = 'DECOY_'
                """
            }
        }

        then {
            def log_lines = new File(process.out.log.get(0).get(1).toString()).readLines()
            assertAll (
                { assert process.success },
                { assert log_lines[0] == 'cwd A' },
                // CmdPhilosopherDbAnnotate.java:58-74, first group only
                { assert log_lines[1] == '/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/tools/Philosopher/philosopher-v5.1.3-RC9 database --annotate {WORKDIR}/db.fasta --prefix DECOY_' },
                // CmdPhilosopherFilter.java:79-115: options, --tag, --pepxml <group dir>, --protxml, --razor
                { assert log_lines[2] == '/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/tools/Philosopher/philosopher-v5.1.3-RC9 filter --sequential --picked --prot 0.01 --tag DECOY_ --pepxml {WORKDIR}/A --protxml {WORKDIR}/combined.prot.xml --razor' },
                { assert log_lines[3] == '/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/tools/Philosopher/philosopher-v5.1.3-RC9 report' },
                // the workspace output holds a file: object storage has no object for an empty directory
                // (Tower stub runs: Missing output file(s) `<group>/.meta`)
                { assert new File(process.out.workspace[0][1].toString()).list().size() > 0 },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("philosopher_filter - stub later group reads the first group's workspace") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                ['interact-b.pep.xml', 'combined.prot.xml', 'db.fasta'].each { n -> file("\${workDir}/\${n}").text = 'mock' }
                file("\${workDir}/wsA/.meta").mkdirs()
                input[0] = channel.of([[ id: 'B', group: 'B' ], file("\${workDir}/interact-b.pep.xml"), file("\${workDir}/combined.prot.xml"),
                    file("\${workDir}/wsA/.meta"), 'A', '--sequential --prot 0.01', false, '--decoys'])
                input[1] = file("\${workDir}/db.fasta")
                input[2] = 'rev_'
                """
            }
        }

        then {
            def log_lines = new File(process.out.log.get(0).get(1).toString()).readLines()
            assertAll (
                { assert process.success },
                // CmdPhilosopherFilter.java:103-113: --dbbin and --probin point at the first group; no DbAnnotate
                { assert log_lines[1] == '/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/tools/Philosopher/philosopher-v5.1.3-RC9 filter --sequential --prot 0.01 --tag rev_ --pepxml {WORKDIR}/B --dbbin {WORKDIR}/A --protxml {WORKDIR}/combined.prot.xml --probin {WORKDIR}/A --razor' },
                { assert log_lines[2] == '/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/tools/Philosopher/philosopher-v5.1.3-RC9 report --decoys' },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("philosopher_filter - stub without ProteinProphet") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                ['interact-a.pep.xml', 'db.fasta'].each { n -> file("\${workDir}/\${n}").text = 'mock' }
                input[0] = channel.of([[ id: 'workdir-root', group: '' ], file("\${workDir}/interact-a.pep.xml"), [],
                    [], '', '--picked', true, ''])
                input[1] = file("\${workDir}/db.fasta")
                input[2] = 'rev_'
                """
            }
        }

        then {
            def log_lines = new File(process.out.log.get(0).get(1).toString()).readLines()
            assertAll (
                { assert process.success },
                // FragpipeRun.java:1716-1719 + CmdPhilosopherFilter.java:107-115: no --protxml / --razor; blank group in the work dir
                { assert log_lines[0] == 'cwd .' },
                { assert log_lines[2] == '/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/tools/Philosopher/philosopher-v5.1.3-RC9 filter --picked --tag rev_ --pepxml {WORKDIR}' },
                { assert process.out.proteins.size() == 0 },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
