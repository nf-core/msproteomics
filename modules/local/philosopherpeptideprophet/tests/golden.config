/*
 * Golden test config: the licensed FragPipe image is given at runtime,
 *   FRAGPIPE_CONTAINER=<image> GOLDEN_ROOT=<golden root> nf-test test <module>/tests/golden.nf.test
 */
process {
    container      = System.getenv('FRAGPIPE_CONTAINER') ?: { throw new IllegalStateException('set FRAGPIPE_CONTAINER to the licensed FragPipe 24.0 image for the golden tests') }()
    resourceLimits = [cpus: 32, memory: 72.GB, time: 4.h]

    // resources of the golden FragPipe run (--ram 64 --threads 32); withName beats conf/modules.config labels
    withName: 'PHILOSOPHERPEPTIDEPROPHET' {
        cpus   = 32
        memory = 64.GB
    }
}

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}
