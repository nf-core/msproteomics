// Golden differential test: PHILOSOPHERPEPTIDEPROPHET vs FragPipe 24.0 (steps PeptideProphet --combine and RewritePepxml, group saliva).
// Inputs are FragPipe's own: the MSFragger pepXML, database and uncalibrated mzML of PXD030670 SALIVA-1.
// Compares the argv of both steps and interact.pep.xml (tests/tools/golden_step_check.py).
// Run: FRAGPIPE_CONTAINER=<licensed image> GOLDEN_ROOT=<golden root> nf-test test modules/local/philosopherpeptideprophet/tests/golden.nf.test
nextflow_process {

    name "Golden PHILOSOPHERPEPTIDEPROPHET vs FragPipe 24.0"
    script "../main.nf"
    process "PHILOSOPHERPEPTIDEPROPHET"
    config "./golden.config"

    tag "golden"
    tag "philosopherpeptideprophet"

    test("PXD030670 SALIVA-1 - PeptideProphet --combine and RewritePepxml reproduce FragPipe") {

        when {
            params {
                golden_set = "${System.getenv('GOLDEN_ROOT')}/PXD030670/glyco-N-LFQ-report_perfile"
            }
            process {
                """
                assert System.getenv('GOLDEN_ROOT') : 'set GOLDEN_ROOT to the golden data root'
                def golden = file(params.golden_set, checkIfExists: true)
                def wf = [:]
                golden.resolve('files/work/fragpipe.workflow').readLines().findAll { it.contains('=') && !it.startsWith('#') }.each {
                    def kv = it.split('=', 2); wf[kv[0]] = kv[1]
                }
                assert wf['peptide-prophet.combine-pepxml'] == 'true'
                input[0] = channel.of([
                    [ id: 'saliva', group: 'saliva' ],
                    file("\${golden}/files/work/saliva/SALIVA-1.pepXML", checkIfExists: true),
                    file("\${golden}/files/input/SALIVA-1_uncalibrated.mzML", checkIfExists: true),
                    ['SALIVA-1_uncalibrated.mzML'],
                    wf['peptide-prophet.cmd-opts'],
                    true
                ])
                input[1] = file("\${golden}/files/db/human_decoys.fasta", checkIfExists: true)
                input[2] = wf['database.decoy-tag']
                """
            }
        }

        then {
            def golden   = new File(params.golden_set)
            def manifest = new groovy.json.JsonSlurper().parse(new File(golden, 'manifest.json'))
            def pp  = manifest.steps.find { s -> s.cmd_name == 'PeptideProphet' && s.cwd == '{WORKDIR}/saliva' }
            def rw  = manifest.steps.find { s -> s.cmd_name == 'RewritePepxml' && s.cwd == '{WORKDIR}/saliva' }
            def outDir  = new File(process.out.results_dir[0][1].toString())
            def taskDir = outDir.parentFile
            def lines   = new File(outDir, 'peptideprophet.log').readLines()
            def ppCmd = new File(outputDir, 'pp.cmd');   ppCmd.text = lines[0]
            def rwCmd = new File(outputDir, 'rw.cmd');   rwCmd.text = lines.find { l -> l.startsWith('java') && l.contains('RewritePepxml') }
            def report = new File(outputDir, 'golden_report.json')
            def cmd = [
                'python3', "${baseDir}/tests/tools/golden_step_check.py",
                '--golden', golden.path,
                '--steps', "${pp.step_index}", "${rw.step_index}",
                // FragPipe runs --combine in {WORKDIR}/saliva; the module in <task>/saliva, the task dir standing for {WORKDIR}
                '--actual-cwd', "${taskDir.path}/saliva",
                '--actual-workdir', taskDir.path,
                '--actual-outdir', outDir.path,
                '--actual-argv', "${pp.step_index}=${ppCmd.path}",
                '--actual-argv', "${rw.step_index}=${rwCmd.path}",
                '--ignore-actual', 'peptideprophet.log',
                '--json', report.path
            ]
            def proc = cmd.execute()
            def stdout = new StringBuffer(), stderr = new StringBuffer()
            proc.waitForProcessOutput(stdout, stderr)
            println stdout
            println stderr
            // work-dir-relative layout (golden_step_check compares cwd-relative): FragPipe's stylesheet is {WORKDIR}/saliva/interact.pep.xsl
            def href = new File(outDir, 'interact.pep.xml').readLines()[1]
            assertAll(
                { assert process.success },
                { assert proc.exitValue() == 0 : "golden comparison failed, see ${report.path}:\n${stdout}${stderr}" },
                { assert href.contains("href=\"${taskDir.path}/saliva/interact.pep.xsl\"") : href }
            )
        }
    }
}
