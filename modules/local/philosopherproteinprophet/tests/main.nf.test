nextflow_process {

    name "Test Process PHILOSOPHERPROTEINPROPHET"
    script "../main.nf"
    process "PHILOSOPHERPROTEINPROPHET"

    tag "modules"
    tag "modules_local"
    tag "philosopherproteinprophet"

    test("proteinprophet - stub") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                ['interact-a.pep.xml', 'interact-b.pep.xml'].each { n -> file("\${workDir}/\${n}").text = 'mock' }
                input[0] = channel.of([[ id: 'combined' ], [file("\${workDir}/interact-a.pep.xml"), file("\${workDir}/interact-b.pep.xml")],
                    ['G1/interact-a.pep.xml', 'interact-b.pep.xml'], '--maxppmdiff 2000000'])
                input[1] = file("\${baseDir}/tests/fixtures/test.fasta", checkIfExists: true)
                """
            }
        }

        then {
            def dir = process.out.results_dir.get(0).get(1)
            assertAll (
                { assert process.success },
                // CmdProteinProphet.java:240-246: options, --output combined, then the filelist
                { assert new File(dir, 'proteinprophet.log').readLines()[0] == '/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/tools/Philosopher/philosopher-v5.1.3-RC9 proteinprophet --maxppmdiff 2000000 --output combined {CWD}/filelist_proteinprophet.txt' },
                // CmdProteinProphet.java:150-166: absolute FragPipe locations in the given order
                { assert new File(dir, 'filelist_proteinprophet.txt').readLines() == ['{CWD}/G1/interact-a.pep.xml', '{CWD}/interact-b.pep.xml'] },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("proteinprophet - stub keeps a user --output") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                file("\${workDir}/interact-a.pep.xml").text = 'mock'
                input[0] = channel.of([[ id: 'combined' ], file("\${workDir}/interact-a.pep.xml"), ['interact-a.pep.xml'], '--output mine'])
                input[1] = file("\${baseDir}/tests/fixtures/test.fasta", checkIfExists: true)
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert new File(process.out.protxml.get(0).get(1).toString()).name == 'mine.prot.xml' },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
