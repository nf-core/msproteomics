nextflow_process {

    name "Test Process PHILOSOPHERREPORT"
    script "../main.nf"
    process "PHILOSOPHERREPORT"

    tag "modules"
    tag "modules_nfcore"
    tag "philosopher"
    tag "philosopher/report"

    test("philosopher_report - stub") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                // the group's FREEQUANT / LABELQUANT dir (workspace in .meta/), named like the output
                def results_dir = file("\${workDir}/test")
                results_dir.mkdirs()
                file("\${results_dir}/.meta").mkdirs()
                file("\${results_dir}/test_annotation.txt").text = "126 Bridge"

                input[0] = channel.of([[ id: 'test' ], results_dir, "--msstats"])
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                // report runs in a copy of the group dir; the workspace is cleaned afterwards
                { assert process.out.results_files[0][1].collect { f -> new File(f.toString()).name }.sort() == ['peptide.tsv', 'protein.tsv', 'psm.tsv', 'test_annotation.txt'] },
                { assert snapshot(
                    process.out.results_files,
                    process.out.psms,
                    process.out.peptides,
                    process.out.proteins,
                    process.out.ions,
                    process.out.versions_philosopher,
                    process.out.versions_fragpipe
                ).match() }
            )
        }
    }

    // ---------------------------------------------------------------------------
    // Integration test notes
    // ---------------------------------------------------------------------------
    // Integration tests for PHILOSOPHERREPORT require the FragPipe container
    // (the FragPipe image given by FRAGPIPE_CONTAINER) which includes the Philosopher binary.
    // Philosopher is not available in any public container.
    //
    // Required mock data for proper integration testing:
    //   - results_dir: directory with .meta/ workspace binaries from
    //     PHILOSOPHERFILTER (skip_report=true) + FREEQUANT or LABELQUANT,
    //     containing updated quantification data in .meta/ binaries
    //   - FASTA file: protein database with decoy prefix (rev_) and contaminants
    //     as prepared by PHILOSOPHERDATABASE (re-annotated in this module)
    //   - report_cli: report flags (e.g., "--msstats")
    //
    // This module is the final reporting step after FreeQuant or LabelQuant
    // has updated .meta/ binaries with quantification intensities. Full
    // integration is validated via TMT and DDA LFQ subworkflow-level tests.
    // ---------------------------------------------------------------------------
}
