nextflow_process {

    name "Test Process PHILOSOPHERWORKSPACECLEAN"
    script "../main.nf"
    process "PHILOSOPHERWORKSPACECLEAN"

    tag "modules"
    tag "modules_local"
    tag "philosopherworkspaceclean"

    test("philosopher_workspace_clean - stub") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                // the group dir PHILOSOPHERFILTER left after filter + report (named like the output)
                def results_dir = file("\${workDir}/test")
                results_dir.mkdirs()
                file("\${results_dir}/.meta").mkdirs()
                file("\${results_dir}/.meta/meta.bin").text = "mock"
                file("\${results_dir}/psm.tsv").text = "Spectrum\\tPeptide\\nrun.1.1.2\\tPEPTIDEK"

                input[0] = channel.of([[ id: 'test' ], results_dir])
                """
            }
        }

        then {
            def dir = new File(process.out.results_dir[0][1].toString())
            assertAll (
                { assert process.success },
                // the clean runs in a copy of the group dir: the upstream workspace stays for its other readers
                { assert !new File(dir, '.meta').exists() },
                { assert new File("${workDir}/test/.meta/meta.bin").exists() },
                { assert snapshot(
                    process.out.results_dir,
                    process.out.versions_philosopher,
                    process.out.versions_fragpipe
                ).match() }
            )
        }
    }

    // Integration: the workspace clean runs in every group of the FragPipe subworkflow
    // integration tests (FRAGPIPE_PHILOSOPHER_QUANT) with the FragPipe image passed at runtime.
}
