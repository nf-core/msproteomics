nextflow_process {

    name "Test Process PLANTOTOOLCONFIGS"
    script "../main.nf"
    process "PLANTOTOOLCONFIGS"

    tag "modules"
    tag "modules_local"
    tag "plan_to_tool_configs"

    test("plan_to_tool_configs - TMT6 test_tmtq work dir") {
        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([[ id: 'plan' ], file("\${projectDir}/tests/fixtures/fragpipe_plans/TMT6_test_tmtq", checkIfExists: true)])
                """
            }
        }

        then {
            def configs = new groovy.json.JsonSlurper().parse(new File(process.out.tool_configs_json[0][1].toString()))
            assertAll(
                { assert process.success },
                { assert configs.findAll { tool, c -> c.run }.keySet().sort() == ['database', 'filter', 'ionquant_isobaric', 'ionquant_ms1', 'msbooster', 'msfragger', 'percolator', 'proteinprophet', 'tmtintegrator'] },
                { assert configs.percolator.args == '--only-psms --no-terminate --post-processing-tdc' },
                { assert path(process.out.msbooster_config[0][1]).text != '' },
                { assert snapshot(process.out.msfragger_config.collect { m, f -> file(f).name }, process.out.msfragger_dia_config, process.out.versions_python).match() }
            )
        }
    }

    test("plan_to_tool_configs - DIA golden work dir writes fragger_dia.params and the MSBooster params") {
        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([[ id: 'plan' ], file("\${projectDir}/tests/fixtures/fragpipe_plans/DIA_SpecLib_Quant_perfile", checkIfExists: true)])
                """
            }
        }

        then {
            def configs = new groovy.json.JsonSlurper().parse(new File(process.out.tool_configs_json[0][1].toString()))
            assertAll(
                { assert process.success },
                { assert configs.diann.run && configs.speclibgen.run && configs.msbooster.run },
                { assert process.out.msfragger_config == [] },
                { assert path(process.out.msbooster_config[0][1]).text.contains('useRT = true') },
                { assert snapshot(process.out.msfragger_dia_config.collect { m, f -> file(f).name }, process.out.versions_python).match() }
            )
        }
    }
}
