nextflow_process {

    name "Test Process PMULTIQC"
    script "../main.nf"
    process "PMULTIQC"

    tag "modules"
    tag "modules_nfcore"
    tag "pmultiqc"

    test("pmultiqc - stub") {
        tag "stub"
        options "-stub"

        when {
            process {
                """
                def stats = file("\${workDir}/sample1_ms_info.parquet")
                stats.text = "mock"
                def config_file = file("\${workDir}/multiqc_config.yml")
                config_file.text = "mock"

                input[0] = [ [ id:'experiment' ], [ stats ], config_file ]
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
