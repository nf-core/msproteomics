// Golden test settings for PTMSHEPHERD: the licensed FragPipe image comes from FRAGPIPE_CONTAINER;
// 48 cpus and 202 GB (-Xmx200G) as the golden FragPipe run (--threads 48 --ram 200).
params.fragpipe_container = System.getenv('FRAGPIPE_CONTAINER') ?: { throw new IllegalArgumentException('Set FRAGPIPE_CONTAINER to the licensed FragPipe 24.0 image for the golden test') }()
docker.enabled    = true
docker.runOptions = '-u $(id -u):$(id -g)'
process {
    resourceLimits = [cpus: 48, memory: 220.GB, time: 8.h]
    withName: 'PTMSHEPHERD' {
        cpus        = 48
        memory      = 202.GB
        container   = { params.fragpipe_container }
    }
}
