// Golden test: PTMSHEPHERD vs FragPipe 24.0 step "PTMShepherd" (PXD030670 glyco-N-LFQ).
// Needs GOLDEN_ROOT (golden data) and FRAGPIPE_CONTAINER (licensed image).
// Inputs are FragPipe's own, exactly: the group psm.tsv FragPipe handed to PTM-Shepherd in this run
// (files/preptms, copied by a java wrapper just before the step), the run's .raw files and database, and
// the PTM-Shepherd settings the pipeline's parser builds from the run's fragpipe.workflow. Expected: the run's ptm-shepherd-output and the
// psm.tsv FragPipe handed on to MBG (files/prembg). Checked: argv equals FragPipe's (-Xmx comes from task
// memory), shepherd.config, every ptm-shepherd-output file and both psm.tsv byte-identical after
// replacing the run directories. No column is excluded.

nextflow_process {

    name "Golden PTMSHEPHERD vs FragPipe 24.0"
    script "../main.nf"
    process "PTMSHEPHERD"
    config "./golden.config"

    tag "golden"
    tag "ptmshepherd"

    setup {
        run("PARSEFRAGPIPEWORKFLOW") {
            script "../../parsefragpipeworkflow/main.nf"
            process {
                """
                assert System.getenv('GOLDEN_ROOT') : 'set GOLDEN_ROOT to the golden data root'
                input[0] = channel.of([ [ id: 'ptms' ], file(System.getenv('GOLDEN_ROOT') + '/PXD030670/glyco-N-preptms_perfile/files/work/fragpipe.workflow', checkIfExists: true), ['DDA'] ])
                """
            }
        }
    }

    test("PXD030670 glyco-N-LFQ - PTM-Shepherd reproduces FragPipe") {

        when {
            process {
                """
                def root = System.getenv('GOLDEN_ROOT')
                def run  = "\${root}/PXD030670/glyco-N-preptms_perfile/files"
                def groups = ['cancer', 'saliva'].collect { g ->
                    def d = file("\${workDir}/\${g}")
                    d.mkdirs()
                    file("\${run}/preptms/\${g}.psm.tsv", checkIfExists: true).copyTo(file("\${d}/psm.tsv"))
                    d
                }
                // the settings block the parser builds (fragpipe_ptm: tool_configs ptmshepherd args + newline);
                // the module adds the database and dataset lines itself
                input[0] = PARSEFRAGPIPEWORKFLOW.out.tool_configs_json.map { _m, json ->
                    def cfg = new groovy.json.JsonSlurper().parseText(json.text).ptmshepherd.args + '\\n'
                    [ [ id: 'ptms' ], groups, [['cancer', 'cancer'], ['saliva', 'saliva']],
                      [ file("\${run}/input/CANCER-3.raw", checkIfExists: true), file("\${run}/input/SALIVA-1.raw", checkIfExists: true) ], cfg, [] ]
                }
                input[1] = file("\${run}/db/human_decoys.fasta", checkIfExists: true)
                """
            }
        }

        then {
            def root   = System.getenv('GOLDEN_ROOT')
            def golden = new File("${root}/PXD030670/glyco-N-preptms_perfile")
            def work   = new File(golden, 'files/work')
            def steps  = new groovy.json.JsonSlurper().parse(new File(golden, 'manifest.json')).steps
            def step   = steps.find { s -> s.cmd_name == 'PTMShepherd' }
            def outDir = new File(process.out.results_dir[0][1].toString())
            def task   = outDir.parentFile
            // argv: FragPipe's elements vs the ones printed to ptmshepherd.log (printf %q; the quotes around the config path
            // are literal characters of the element, CmdPtmshepherd.java:163 passes it through a ProcessBuilder; -Xmx is task memory, a user decision; -Duser.home=<task dir> is
            // added to every Java launch because the container user has no passwd entry, bin/golden_step_check.py)
            def actualLine = new File(task, 'ptmshepherd.log').readLines()[0]
            // FragPipe install root (fragpipe*) of the module's jar path (<root>/tools/..., fragpipeTools()), as bin/golden_step_check.py fragpipe_root
            def fp   = (actualLine =~ /(?i)(\/[^\s:]*\/fragpipe[^\/\s:]*)\/(?:tools|lib)\//)[0][1]
            def norm = { String t -> t.replace('{FRAGPIPE}', fp).replace('{WORKDIR}', '<WORK>') }
            def expected = step.argv.collect { t -> norm.call(t) }.findAll { t -> !t.startsWith('-Xmx') && !t.startsWith('-Duser.home=') }
            // the log is printf %q of the exact argv: bash reads it back element by element, literal quotes kept
            def reader = new ProcessBuilder('bash', '-c', 'eval "args=( $(head -n 1 ptmshepherd.log) )"; printf "%s\\n" "${args[@]}"').directory(task).start()
            def readerOut = reader.inputStream.text
            assert reader.waitFor() == 0 : "reading the argv back from ptmshepherd.log failed: ${reader.errorStream.text}"
            def actual = readerOut.readLines().collect { t -> t.replace(task.path, '<WORK>') }.findAll { t -> !t.startsWith('-Xmx') && !t.startsWith('-Duser.home=') }  // -Duser.home: every java launch sets it (no passwd entry in the image)
            // the golden run's own directories, from its manifest
            def roots  = new groovy.json.JsonSlurper().parse(new File(golden, 'manifest.json')).roots
            def paths = [[ roots['{WORKDIR}'], '<WORK>' ], [ roots['{LCMS_DIR}'], '<LCMS>' ], [ roots['{DB_DIR}'], '<DB>' ]]
            def text = { File f, boolean isGolden ->
                def s = f.getText('ISO-8859-1')
                if (isGolden) { paths.each { p -> s = s.replace(p[0], p[1]) } }
                else { s = s.replace(task.path + '/spectra', '<LCMS>').replace(task.path + '/human_decoys.fasta', '<DB>/human_decoys.fasta').replace(task.path + '/groups/', '<WORK>/').replace(task.path, '<WORK>') }
                s
            }
            def results = []
            results << (expected == actual ? 'MATCH\targv' : "DIFF\targv\n  FragPipe: ${expected}\n  module:   ${actual}")
            def lines = []
            lines << "${text.call(new File(work, 'shepherd.config'), true) == text.call(new File(task, 'shepherd.config'), false) ? 'MATCH' : 'DIFF'}\tshepherd.config".toString()
            new File(work, 'ptm-shepherd-output').listFiles().sort().each { f ->
                def act = new File(outDir, f.name)
                def status = !act.exists() ? 'MISSING' : text.call(f, true) == text.call(act, false) ? 'MATCH' : 'DIFF'
                lines << "${status}\tptm-shepherd-output/${f.name}".toString()
            }
            ['cancer', 'saliva'].each { g ->
                def act = new File(task, "groups/${g}/psm.tsv")
                def status = !act.exists() ? 'MISSING' : new File(golden, "files/prembg/${g}.psm.tsv").bytes == act.bytes ? 'MATCH' : 'DIFF'
                lines << "${status}\t${g}/psm.tsv".toString()
            }
            results += lines
            println(results.join('\n'))
            assertAll(
                { assert process.success },
                { assert results.findAll { r -> !r.startsWith('MATCH') } == [] : results.join('\n') }
            )
        }
    }
}
