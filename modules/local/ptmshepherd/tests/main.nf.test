nextflow_process {

    name "Test Process PTMSHEPHERD"
    script "../main.nf"
    process "PTMSHEPHERD"

    tag "modules"
    tag "modules_local"
    tag "ptmshepherd"

    test("ptmshepherd - stub - shepherd.config layout and rewritten group copies") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                // Two FragPipe groups: the blank group (staged as workdir-root) and 'control'
                def root = file("\${workDir}/workdir-root")
                root.mkdirs()
                file("\${root}/psm.tsv").text = "Spectrum\\tPeptide\\nroot.1.1.2\\tPEPTIDEK\\n"
                def control = file("\${workDir}/control")
                control.mkdirs()
                file("\${control}/psm.tsv").text = "Spectrum\\tPeptide\\nctrl.1.1.2\\tPEPTIDER\\n"
                def mzml = file("\${workDir}/ctrl.mzML")
                mzml.text = "mock"
                // Property block as PARSEFRAGPIPEWORKFLOW writes it (sorted, run-time tokens)
                def props = "glyco_residue_list = @TOOLS_DIR@/Glycan_Databases/glycan_residues.txt\\nrun_glyco_mode = true\\nthreads = @THREADS@\\n"
                def fasta = file("\${workDir}/db.fasta")
                fasta.text = ">sp|P1|A\\nPEPTIDEK\\n"

                input[0] = channel.of([
                    [ id: 'fragpipe' ],
                    [ root, control ],
                    [ ['workdir-root', 'dataset01'], ['control', 'control'] ],
                    [ mzml ],
                    props,
                    []
                ])
                input[1] = channel.value(fasta)
                """
            }
        }

        then {
            def config = path(process.out.config[0][1]).readLines()
            assertAll (
                { assert process.success },
                // createConfig(): database, dataset lines in group order, blank line, properties
                { assert config[0] == 'database = db.fasta' },
                { assert config[1] == 'dataset = dataset01 groups/workdir-root/psm.tsv spectra' },
                { assert config[2] == 'dataset = control groups/control/psm.tsv spectra' },
                { assert config[3] == '' },
                { assert config[4] == 'glyco_residue_list = /fragpipe_bin/fragpipe-24.0/fragpipe-24.0/lib/../tools/Glycan_Databases/glycan_residues.txt' },
                { assert config.any { line -> line ==~ /threads = [0-9]+/ } },
                { assert process.out.psm_dirs[0][1].collect { d -> file(d).name }.sort() == ['control', 'workdir-root'] },
                { assert process.out.glyco_masses.size() == 1 },
                { assert snapshot(
                    process.out.psm_dirs,
                    process.out.results_dir,
                    process.out.glyco_masses,
                    process.out.config,
                    process.out.versions_ptmshepherd,
                    process.out.versions_fragpipe
                ).match() }
            )
        }
    }

    test("ptmshepherd - stub - custom annotation file is staged and named by the config") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                def root = file("\${workDir}/workdir-root")
                root.mkdirs()
                file("\${root}/psm.tsv").text = "Spectrum\\tPeptide\\nroot.1.1.2\\tPEPTIDEK\\n"
                def mzml = file("\${workDir}/ctrl.mzML")
                mzml.text = "mock"
                def annotation = file("\${workDir}/my_annotations.tsv")
                annotation.text = "mass\\tname\\n79.966\\tPhospho\\n"
                def fasta = file("\${workDir}/db.fasta")
                fasta.text = ">sp|P1|A\\nPEPTIDEK\\n"

                // annotation-custom=true, annotation_file=<path>: the parser writes the @ANNOTATION_FILE@ token
                input[0] = channel.of([
                    [ id: 'fragpipe' ],
                    [ root ],
                    [ ['workdir-root', 'dataset01'] ],
                    [ mzml ],
                    "annotation_file = @ANNOTATION_FILE@\\nthreads = @THREADS@\\n",
                    annotation
                ])
                input[1] = channel.value(fasta)
                """
            }
        }

        then {
            def config = path(process.out.config[0][1]).readLines()
            assertAll (
                { assert process.success },
                { assert config.contains('annotation_file = annotation/my_annotations.tsv') : config },
                { assert !config.any { line -> line.contains('@ANNOTATION_FILE@') } : config },
                { assert path(process.out.config[0][1]).parent.resolve('annotation/my_annotations.tsv').toFile().text.contains('Phospho') },
                { assert snapshot(process.out.config).match() }
            )
        }
    }
}
