// QPXDIANN on the synthetic DIA-NN outputs in tests/fixtures/qpx/diann_{multi,single}.
// Real tests (tag qpx) run qpxc + bin/qpx_export.py in the qpx image: the summary TSV is
// snapshotted, the .h5mu / .h5ad only checked for content (their bytes carry timestamps).

nextflow_process {

    name "Test Process QPXDIANN"
    script "../main.nf"
    process "QPXDIANN"

    tag "modules"
    tag "modules_local"
    tag "qpxdiann"

    test("qpxdiann - multi-run - stub") {
        tag "stub"
        options "-stub"

        when {
            process {
                """
                def d = "\${projectDir}/tests/fixtures/qpx/diann_multi"
                input[0] = [[id: 'experiment'], file("\${d}/report.tsv", checkIfExists: true), file("\${d}/pg_matrix.tsv", checkIfExists: true), file("\${d}/diann.log.txt", checkIfExists: true)]
                input[1] = file("\${d}/sdrf.tsv", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("qpxdiann - multi-run") {
        tag "qpx"
        tag "integration"

        when {
            process {
                """
                def d = "\${projectDir}/tests/fixtures/qpx/diann_multi"
                input[0] = [[id: 'experiment'], file("\${d}/report.tsv", checkIfExists: true), file("\${d}/pg_matrix.tsv", checkIfExists: true), file("\${d}/diann.log.txt", checkIfExists: true)]
                input[1] = file("\${d}/sdrf.tsv", checkIfExists: true)
                """
            }
        }

        then {
            def summary = path(process.out.summary[0][1]).readLines()
            assertAll(
                { assert process.success },
                { assert path(process.out.h5mu[0][1]).toFile().length() > 0 },
                { assert path(process.out.h5ad[0][1]).toFile().length() > 0 },
                { assert process.out.qpx_dataset[0][1].collect { f -> file(f).name }.contains('diann.pg.parquet') },
                { assert snapshot(summary, process.out.findAll { key, _value -> key.startsWith('versions_') }).match() }
            )
        }
    }

    test("qpxdiann - single run") {
        tag "qpx"
        tag "integration"

        when {
            process {
                """
                def d = "\${projectDir}/tests/fixtures/qpx/diann_single"
                input[0] = [[id: 'experiment'], file("\${d}/report.tsv", checkIfExists: true), file("\${d}/pg_matrix.tsv", checkIfExists: true), file("\${d}/diann.log.txt", checkIfExists: true)]
                input[1] = file("\${d}/sdrf.tsv", checkIfExists: true)
                """
            }
        }

        then {
            def summary = path(process.out.summary[0][1]).readLines()
            assertAll(
                { assert process.success },
                { assert summary.contains('count.proteins.n_obs\t1') : summary },
                { assert path(process.out.h5ad[0][1]).toFile().length() > 0 },
                { assert snapshot(summary).match() }
            )
        }
    }

    // Guard G2: an empty pg_matrix (no protein group passed DIA-NN's matrix FDR) leaves no proteins modality
    test("qpxdiann - empty pg_matrix fails") {
        tag "qpx"
        tag "integration"

        when {
            process {
                """
                def d = "\${projectDir}/tests/fixtures/qpx/diann_single"
                def pg_matrix = file("\${workDir}/pg_matrix.tsv")
                pg_matrix.text = file("\${d}/pg_matrix.tsv").readLines()[0] + "\\n"
                input[0] = [[id: 'experiment'], file("\${d}/report.tsv", checkIfExists: true), pg_matrix, file("\${d}/diann.log.txt", checkIfExists: true)]
                input[1] = file("\${d}/sdrf.tsv", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.exitStatus == 3 },
                { assert process.stderr.any { line -> line.contains("ERROR: G2: no 'proteins' modality") } : process.stderr }
            )
        }
    }

    // Guard G6: the report's runs must be the SDRF's runs
    test("qpxdiann - SDRF runs that DIA-NN did not quantify fail") {
        tag "qpx"
        tag "integration"

        when {
            process {
                """
                def d = "\${projectDir}/tests/fixtures/qpx/diann_single"
                input[0] = [[id: 'experiment'], file("\${d}/report.tsv", checkIfExists: true), file("\${d}/pg_matrix.tsv", checkIfExists: true), file("\${d}/diann.log.txt", checkIfExists: true)]
                input[1] = file("\${projectDir}/tests/fixtures/qpx/diann_multi/sdrf.tsv", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.stderr.any { line -> line.contains('ERROR: G') } : process.stderr }
            )
        }
    }
}
