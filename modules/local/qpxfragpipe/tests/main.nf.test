// QPXFRAGPIPE on the synthetic IonQuant outputs in tests/fixtures/qpx/fragpipe_*.
// Real tests (tag qpx) run the qpx image: the summary TSV is snapshotted, the .h5mu / .h5ad
// only checked for content (their bytes carry timestamps).

nextflow_process {

    name "Test Process QPXFRAGPIPE"
    script "../main.nf"
    process "QPXFRAGPIPE"

    tag "modules"
    tag "modules_local"
    tag "qpxfragpipe"

    test("qpxfragpipe - stub") {
        tag "stub"
        options "-stub"

        when {
            process {
                """
                def d = "\${projectDir}/tests/fixtures/qpx/fragpipe_annotation"
                input[0] = [[id: 'fragpipe'], file("\${d}/combined_protein.tsv", checkIfExists: true), file("\${d}/combined_ion.tsv", checkIfExists: true), file("\${d}/experiment_annotation.tsv", checkIfExists: true)]
                input[1] = file("\${d}/sdrf.tsv", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    // FragPipe's experiment_annotation.tsv names IonQuant's experiments <experiment>_<bioreplicate>
    test("qpxfragpipe - experiment annotation") {
        tag "qpx"
        tag "integration"

        when {
            process {
                """
                def d = "\${projectDir}/tests/fixtures/qpx/fragpipe_annotation"
                input[0] = [[id: 'fragpipe'], file("\${d}/combined_protein.tsv", checkIfExists: true), file("\${d}/combined_ion.tsv", checkIfExists: true), file("\${d}/experiment_annotation.tsv", checkIfExists: true)]
                input[1] = file("\${d}/sdrf.tsv", checkIfExists: true)
                """
            }
        }

        then {
            def summary = path(process.out.summary[0][1]).readLines()
            assertAll(
                { assert process.success },
                { assert summary.contains('count.proteins.n_obs\t3') : summary },
                { assert path(process.out.h5mu[0][1]).toFile().length() > 0 },
                { assert path(process.out.h5ad[0][1]).toFile().length() > 0 },
                { assert snapshot(summary, process.out.findAll { key, _value -> key.startsWith('versions_') }).match() }
            )
        }
    }

    // No MaxLFQ / Total intensity columns: the precheck (guard G3) fails the task before qpxc
    test("qpxfragpipe - no MaxLFQ intensities fails") {
        tag "qpx"
        tag "integration"

        when {
            process {
                """
                def d = "\${projectDir}/tests/fixtures/qpx/fragpipe_no_maxlfq"
                def annotation = file("\${workDir}/experiment_annotation.tsv")
                annotation.text = "file\\tsample\\tsample_name\\tcondition\\treplicate\\n" +
                    (1..3).collect { i -> "/in/R\${i}_DDA_S\${i}.mzML\\tDDA_S\${i}\\tDDA_S\${i}\\tEXP\\t1\\n" }.join('')
                input[0] = [[id: 'fragpipe'], file("\${d}/combined_protein.tsv", checkIfExists: true), file("\${d}/combined_ion.tsv", checkIfExists: true), annotation]
                input[1] = file("\${d}/sdrf.tsv", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.stdout.any { line -> line.contains('terminated with an error exit status (3)') } : process.stdout },
                { assert process.stdout.any { line -> line.contains('ERROR: G3: combined_protein.tsv has no MaxLFQ Intensity / Total Intensity column') && line.contains('--skip_qpx_export') } : process.stdout }
            )
        }
    }
}
