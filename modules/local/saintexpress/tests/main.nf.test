nextflow_process {

    name "Test Process SAINTEXPRESS"
    script "../main.nf"
    process "SAINTEXPRESS"

    tag "modules"
    tag "modules_local"
    tag "saintexpress"

    test("saintexpress - stub") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                def dats = ['inter.dat', 'bait.dat', 'prey.dat'].collect { name -> def f = file("\${workDir}/\${name}"); f.text = 'mock'; f }
                input[0] = channel.of([[ id: 'fragpipe' ], dats, 'spc', '-R3 -L100', '-f -x'])
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                // CmdSaintExpress.java:84-90: binary of the mode, -R, -L, cmd-opts as one argument
                { assert new File(process.out.results_dir.get(0).get(1), 'saintexpress.log').readLines()[0] == '/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/tools/SAINTexpress/SAINTexpress-spc -R3 -L100 -f -x' },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("saintexpress - integration int mode from a REPRINT table") {
        tag "integration"

        setup {
            run("REPRINTTOSAINTINPUT") {
                script "../../reprinttosaintinput/main.nf"
                process {
                    """
                    def tsv = file("\${workDir}/reprint.int.tsv")
                    // bait row: BAIT is a test IP, CONTROL_A a control (type C, CmdSaintExpress.java:121-129)
                    def rows = ['PROTID\\tGENEID\\tB1_INT\\tB2_INT\\tC1_INT\\tC2_INT', 'na\\tna\\tBAIT\\tBAIT\\tCONTROL_A\\tCONTROL_A']
                    (1..20).each { i -> rows << "P\${i}\\tG\${i}\\t\${1000 * i}.0\\t\${900 * i}.0\\t\${i % 3 == 0 ? 0 : 10 * i}.0\\t\${5 * i}.0".toString() }
                    tsv.text = rows.join('\\n') + '\\n'
                    input[0] = channel.of([[ id: 'fragpipe' ], tsv, 'int'])
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = REPRINTTOSAINTINPUT.out.saint_input.map { meta, dats, mode -> [meta, dats, mode, '-R10 -L100', ''] }
                """
            }
        }

        then {
            assertAll (
                { assert process.success },
                { assert snapshot(process.out.results_list, process.out.versions_saintexpress, process.out.versions_fragpipe).match() }
            )
        }
    }

    // No control IP and two IPs (the TMT18 label-check shape: C02, D02 both test baits): FragPipe 24.0's
    // SAINTexpress-int aborts (exit 134, "terminate called after throwing an instance of 'char const*'"),
    // as in FragPipe's Downstream Run; the task fails, names the step and keeps SAINTexpress's output
    test("saintexpress - integration int mode without control IPs fails and names the Downstream step") {
        tag "integration"

        when {
            process {
                """
                def bait = file("\${workDir}/bait.dat")
                bait.text = 'IP1\\tB1\\tT\\nIP2\\tB2\\tT\\n'
                def inter = file("\${workDir}/inter.dat")
                inter.text = ['IP1', 'IP2'].withIndex().collectMany { ip, i -> ['P1', 'P2', 'P3'].collect { p -> "\${ip}\\tB\${i + 1}\\t\${p}\\t\${(i + 1) * 1000 + 7}" } }.join('\\n') + '\\n'
                def prey = file("\${workDir}/prey.dat")
                prey.text = 'P1\\t100\\tG1\\nP2\\t200\\tG2\\nP3\\t300\\tG3\\n'
                input[0] = channel.of([[ id: 'fragpipe' ], [inter, bait, prey], 'int', '-R3 -L100', ''])
                """
            }
        }

        then {
            // the task's exit status, output and error are in Nextflow's error report
            def report = process.errorReport
            assertAll (
                { assert process.failed },
                { assert report.contains('terminated with an error exit status (134)') },
                { assert report.contains("SAINTexpress-int, FragPipe's optional Downstream step (TabDownstream.java:114-145), exited 134") },
                { assert report.contains('L is larger than the number of control IPs.') }
            )
        }
    }
}
