nextflow_process {

    name "Test Process TMTINTEGRATOR"
    script "../main.nf"
    process "TMTINTEGRATOR"

    tag "modules"
    tag "modules_local"
    tag "tmtintegrator"

    // tmt-integrator-conf.yml FragPipe's plan gives for the bundled TMT10 workflow
    def tmt10_yaml = '''tmtintegrator:
  abn_type: 0
  add_Ref: 1
  aggregation_method: 0
  allow_overlabel: true
  allow_unlabeled: false
  best_psm: true
  channel_num: 10
  glyco_qval: -1
  groupby: -1
  is_tmt_35: false
  label_masses: 229.16293
  log2transformed: true
  max_pep_prob_thres: 0.9
  min_ntt: 0
  min_pep_prob: 0.9
  min_percent: 0.05
  min_purity: 0.5
  min_resolution: 0
  min_site_prob: -1
  min_snr: 0
  mod_tag: none
  ms1_int: true
  outlier_removal: true
  output: @TMT_REPORT_DIR@
  print_RefInt: false
  prot_exclude: none
  prot_norm: 1
  psm_norm: false
  ref_d_tag: Pool
  ref_tag: Bridge
  unique_gene: 0
  unique_pep: false
  use_glycan_composition: false
'''

    // FragPipe's work-dir layout: the blank group's psm.tsv at the work-dir top, named groups below,
    // one psm.tsv argument per group with the blank group first (CmdTmtIntegrator.java:288-296)
    test("tmtintegrator - stub blank and named groups in the FragPipe work-dir layout") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                def config_file = file("\${workDir}/tmtintegrator.yml")
                config_file.text = '''${tmt10_yaml}'''
                def dirs = ['workdir-root', 'g2', 'g1'].collect { name ->
                    def d = file("\${workDir}/\${name}")
                    d.mkdirs()
                    file("\${d}/psm.tsv").text = "peptide\\tprotein\\nPEPTIDEK\\tPROT1"
                    file("\${d}/protein.tsv").text = "protein\\nPROT1"
                    d
                }
                input[1] = config_file.text
                def msstats = file("\${workDir}/MSstatsTMT_annotation.csv")
                msstats.text = 'Run,Fraction,TechRepMixture,Mixture,Channel,BioReplicate,Condition\\nf1,1,1,g1,126,s_A,A\\n'
                input[0] = [[id: 'fragpipe'], dirs, 'workdir-root', msstats]
                """
            }
        }

        then {
            def report = new File(process.out.results_dir[0][1].toString())
            def wd = report.parentFile
            def task = wd.parentFile
            // the stub logs the config and the psm.tsv arguments (tmtIntegratorCommands)
            def psms = new File(task, 'tmt-integrator.log').text.trim().tokenize(' ').drop(2).collect { p -> p.replace(task.absolutePath, '<task>') }
            def conf = new File(process.out.config[0][1].toString()).readLines()
            assertAll(
                { assert process.success },
                { assert wd.name == 'fragpipe' },
                { assert psms == ['<task>/fragpipe/psm.tsv', '<task>/fragpipe/g1/psm.tsv', '<task>/fragpipe/g2/psm.tsv'] },
                { assert conf.contains("  output: ${report.absolutePath}".toString()) },
                { assert new File(process.out.msstats_annotation[0][1].toString()).readLines()[1] == 'f1,1,1,g1,126,s_A,A' },
                { assert snapshot(
                    psms,
                    process.out.abundance,
                    process.out.ratio,
                    process.out.msstats_annotation,
                    process.out.versions_tmtintegrator,
                    process.out.versions_fragpipe
                ).match() }
            )
        }
    }

    test("tmtintegrator - stub refuses a config that is not FragPipe's planned one") {
        options "-stub"
        tag "stub"

        when {
            process {
                """
                def config_file = file("\${workDir}/tmtintegrator.yml")
                config_file.text = 'tmtintegrator:\\n  channel_num: 10\\n'
                def d = file("\${workDir}/g1")
                d.mkdirs()
                file("\${d}/psm.tsv").text = "peptide\\nPEPTIDEK"
                input[0] = [[id: 'fragpipe'], [d], '', []]
                input[1] = config_file.text
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert (process.stdout + process.stderr).any { line -> line.contains("is not FragPipe's planned tmt-integrator-conf.yml") } }
            )
        }
    }
}
