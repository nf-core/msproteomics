/*
 * Test configuration for FILE_PREPARATION subworkflow tests
 */

process {
    cpus   = 1
    memory = 2.GB
    time   = 1.h

    withName: 'THERMORAWFILEPARSER' {
        container = 'quay.io/biocontainers/thermorawfileparser:2.0.0.dev--h9ee0642_1'
        ext.args = '--format 1'
    }
}

params {
    outdir = 'results'
    publish_dir_mode = 'copy'
}

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}
