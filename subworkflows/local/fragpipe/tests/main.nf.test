nextflow_workflow {

    name "Test Workflow FRAGPIPE"
    script "../main.nf"
    workflow "FRAGPIPE"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "fragpipe_wf"

    test("fragpipe_wf - stub test with LFQ workflow") {
        options "-stub"
        tag "stub"

        when {
            workflow {
                """
                // Create a test mzML file
                def mzml_file = file("\${workDir}/test_sample.mzML")
                mzml_file.text = '<?xml version="1.0" encoding="UTF-8"?><mzML></mzML>'

                // Create a test FASTA file
                def fasta_file = file("\${workDir}/test.fasta")
                fasta_file.text = '>sp|P00000|TEST_HUMAN Test protein\\nMKWVTFISLLLFSSAYSRGVFRRDTHKSEIAHR'

                // Create a test workflow file
                def workflow_file = file("\${workDir}/LFQ-MBR.workflow")
                workflow_file.text = '''
msfragger.calibrate_mass = 2
msfragger.precursor_mass_lower = -20
msfragger.precursor_mass_upper = 20
msfragger.run-msfragger = true
msbooster.run-msbooster = true
ionquant.mbr = 1
ionquant.maxlfq = 1
ionquant.run-ionquant = true
quantitation.run-label-free-quant = true
msfragger.table.var-mods = 15.9949,M,true,3
phi-report.filter = --sequential --prot 0.01 --picked
phi-report.run-report = true
percolator.run-percolator = true
protein-prophet.run-protein-prophet = true
database.decoy-tag = rev_
'''.trim()

                // Create input channels
                input[0] = channel.of([[ id: 'test_sample', group: 'test_sample', data_type: 'DDA' ], mzml_file])
                input[1] = channel.of([[ id: 'test_db' ], fasta_file])
                input[2] = channel.of([[ id: 'fragpipe_config' ], workflow_file])
                input[3] = Channel.empty()  // ch_decoy_db (not used)
                input[4] = channel.value([])  // ch_annotation (not used)
                input[5] = []               // ch_manifest (not used)
                input[6] = channel.value([[], []])  // ch_taxon_files: FragPipe's tools/metaproteomics dumps

                """
            }
        }

        then {
            assertAll (
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.mzml,
                    workflow.out.pepxml,
                    workflow.out.pin,
                    workflow.out.validated_pepxml,
                    workflow.out.protxml,
                    workflow.out.psms,
                    workflow.out.peptides,
                    workflow.out.proteins,
                    workflow.out.results_dir,
                    workflow.out.combined_protein,
                    workflow.out.combined_peptide,
                    workflow.out.combined_ion,
                    // file names only: filelist_ionquant.txt holds the absolute --specdir (CmdIonquant)
                    workflow.out.ionquant_dir.collect { item -> [item[0], new File(item[1].toString()).list().sort()] },
                    workflow.out.tmt_abundance
                ).match() }
            )
        }
    }

    test("fragpipe_wf - stub - export matched fragments with Report off is a no-op like FragPipe") {
        options "-stub"
        tag "stub"

        when {
            workflow {
                """
                // Create a test mzML file
                def mzml_file = file("\${workDir}/test_sample.mzML")
                mzml_file.text = '<?xml version="1.0" encoding="UTF-8"?><mzML></mzML>'

                // Create a test FASTA file
                def fasta_file = file("\${workDir}/test.fasta")
                fasta_file.text = '>sp|P00000|TEST_HUMAN Test protein\\nMKWVTFISLLLFSSAYSRGVFRRDTHKSEIAHR'

                // Create a test workflow file
                def workflow_file = file("\${workDir}/LFQ-MBR.workflow")
                workflow_file.text = '''
msfragger.calibrate_mass = 2
msfragger.precursor_mass_lower = -20
msfragger.precursor_mass_upper = 20
msfragger.run-msfragger = true
msbooster.run-msbooster = true
ionquant.mbr = 1
ionquant.maxlfq = 1
ionquant.run-ionquant = false
quantitation.run-label-free-quant = false
msfragger.table.var-mods = 15.9949,M,true,3
phi-report.filter = --sequential --prot 0.01 --picked
phi-report.run-report = false
tab-run.export_matched_fragments = true
percolator.run-percolator = true
protein-prophet.run-protein-prophet = true
database.decoy-tag = rev_
'''.trim()

                // Create input channels
                input[0] = channel.of([[ id: 'test_sample', group: 'test_sample', data_type: 'DDA' ], mzml_file])
                input[1] = channel.of([[ id: 'test_db' ], fasta_file])
                input[2] = channel.of([[ id: 'fragpipe_config' ], workflow_file])
                input[3] = Channel.empty()  // ch_decoy_db (not used)
                input[4] = channel.value([])  // ch_annotation (not used)
                input[5] = []               // ch_manifest (not used)
                input[6] = channel.value([[], []])  // ch_taxon_files: FragPipe's tools/metaproteomics dumps

                """
            }
        }

        then {
            // FragPipe's dry run still lists ExportMatchedFragments with Report off (FragpipeRun.java:2411-2416, graph edge
            // :2490), but without Filter and Report there is no psm.tsv: FragmentsExportMainClass prints "Error Parsing File"
            // and exits 0 with no output (checked with --dry-run and the command on an edited golden workflow)
            def tasks = workflow.trace.tasks().collect { task -> task.name.replaceAll(/ \(.*\)$/, '').tokenize(':')[-1] }
            assertAll (
                { assert workflow.success },
                { assert !tasks.contains('PHILOSOPHERREPORT') : tasks },
                { assert !tasks.contains('EXPORTMATCHEDFRAGMENTS') : tasks },
                { assert snapshot(tasks.unique().sort()).match() }
            )
        }
    }

    test("fragpipe_wf - stub FPOP workflow runs FPOP Quant, coADAPTr and Metaproteomics on the final tables") {
        options "-stub"
        tag "stub"

        when {
            params {
                outdir = "$outputDir"
                // symlinks show which task each published file comes from
                publish_dir_mode = 'symlink'
            }
            workflow {
                """
                def fasta_file = file("\${workDir}/test.fasta")
                fasta_file.text = '>sp|P00000|TEST_HUMAN Test protein\\nMKWVTFISLLLFSSAYSRGVFRRDTHKSEIAHR'
                def mzml_a = file("\${workDir}/fpop_a.mzML")
                mzml_a.text = '<?xml version="1.0" encoding="UTF-8"?><mzML></mzML>'
                def mzml_b = file("\${workDir}/fpop_b.mzML")
                mzml_b.text = '<?xml version="1.0" encoding="UTF-8"?><mzML></mzML>'

                // FragPipe 24.0 FPOP.workflow with FPOP Quant and Metaproteomics switched on
                input[0] = channel.of(
                    [[ id: 'fpop_a', group: 'CTRL_1', data_type: 'DDA' ], mzml_a],
                    [[ id: 'fpop_b', group: 'OX_1', data_type: 'DDA' ], mzml_b]
                )
                input[1] = channel.of([[ id: 'test_db' ], fasta_file])
                input[2] = channel.of([[ id: 'fragpipe_config' ], file("${baseDir}/tests/fixtures/fragpipe_workflows/FPOP-quant-meta.workflow", checkIfExists: true)])
                input[3] = Channel.empty()  // ch_decoy_db (not used)
                input[4] = channel.value([])        // ch_annotation (not used)
                input[5] = []               // ch_manifest (not used)
                input[6] = channel.value([[], []])  // ch_taxon_files: FragPipe's tools/metaproteomics dumps
                """
            }
        }

        then {
            def meta_inputs = new File(workflow.out.taxonomy_results[0][1].toString(), 'metaproteomics.log').readLines().drop(1)
            // Published psm.tsv files: FragPipe edits them in place, so only coADAPTr's copies are published
            def out = java.nio.file.Paths.get(outputDir.toString())
            def coadaptr_task = java.nio.file.Paths.get(workflow.out.fpop_psms[0][1][0].toString()).parent.parent.parent.parent
            def published_psms = []
            java.nio.file.Files.walk(out).withCloseable { stream ->
                published_psms = stream.collect(java.util.stream.Collectors.toList())
                    .findAll { f -> f.fileName.toString() == 'psm.tsv' && f.toString().contains('/ionquant/') }
                    .collect { f -> [out.relativize(f).toString(), java.nio.file.Files.readSymbolicLink(f).startsWith(coadaptr_task)] }
                    .sort()
            }
            assertAll (
                { assert workflow.success },
                // FPOP Quant reads IonQuant's combined_modified_peptide.tsv with the workflow's labels
                { assert new File(workflow.out.fpop_results[0][1].toString(), 'fpop.log').text.trim() == 'FragPipe_FPOP_Analysis.py combined_modified_peptide.tsv 2 CTRL OX false false' },
                // coADAPTr edits the IonQuant psm.tsv of every group
                { assert workflow.out.fpop_psms[0][1].collect { f -> new File(f.toString()).parentFile.name }.sort() == ['CTRL_1', 'OX_1'] },
                // the IonQuant results directory is published from FPOPCOADAPTR only, at ionquant/
                { assert published_psms == [['ionquant/fragpipe/CTRL_1/psm.tsv', true], ['ionquant/fragpipe/OX_1/psm.tsv', true]] },
                { assert java.nio.file.Files.exists(out.resolve('ionquant/fragpipe/combined_modified_peptide.tsv')) },
                { assert java.nio.file.Files.exists(out.resolve('fpop_coadaptr/fpop_coadaptr.log')) },
                // Metaproteomics sees the MSFragger .pin and Percolator PSM tables of every run
                { assert meta_inputs.findAll { f -> f.endsWith('.pin') }.size() == 2 },
                { assert meta_inputs.findAll { f -> f.endsWith('_percolator_target_psms.tsv') }.size() == 2 },
                // FragPipe deletes the decoy TSVs after Percolator unless keep-tsv-files is on, metaproteomics or not
                // (CmdPercolator.java:232-239), so FP-Meta finds none
                { assert meta_inputs.findAll { f -> f.endsWith('_percolator_decoy_psms.tsv') }.size() == 0 },
                { assert snapshot(workflow.out.fpop_results, workflow.out.fpop_psms, workflow.out.taxonomy_results).match() }
            )
        }
    }

    test("fragpipe_wf - stub test with TMT workflow") {
        options "-stub"
        tag "stub"

        when {
            workflow {
                """
                // Create a test mzML file
                def mzml_file = file("\${workDir}/test_sample.mzML")
                mzml_file.text = '<?xml version="1.0" encoding="UTF-8"?><mzML></mzML>'

                // Create a test FASTA file
                def fasta_file = file("\${workDir}/test.fasta")
                fasta_file.text = '>sp|P00000|TEST_HUMAN Test protein\\nMKWVTFISLLLFSSAYSRGVFRRDTHKSEIAHR'

                // Create a test workflow file
                def workflow_file = file("\${workDir}/TMT16.workflow")
                workflow_file.text = '''
msfragger.calibrate_mass = 2
msfragger.precursor_mass_lower = -20
msfragger.precursor_mass_upper = 20
msfragger.run-msfragger = true
msbooster.run-msbooster = true
tmtintegrator.run-tmtintegrator = true
msfragger.table.var-mods = 15.9949,M,true,3
phi-report.filter = --sequential --prot 0.01 --picked
phi-report.run-report = true
percolator.run-percolator = true
protein-prophet.run-protein-prophet = true
database.decoy-tag = rev_
'''.trim()

                // Create input channels
                // TMT annotation (TMT-Integrator runs): one plex = the FragPipe group test_sample
                def annotation_file = file("\${workDir}/tmt_annotation.tsv")
                annotation_file.text = "plex\\tchannel\\tsample\\tsample_name\\tcondition\\treplicate\\ntest_sample\\t126\\tBridge\\tBridge\\tref\\t1\\ntest_sample\\t127N\\tS1\\tS1\\tc\\t1\\n"
                input[0] = channel.of([[ id: 'test_sample', group: 'test_sample', data_type: 'DDA' ], mzml_file])
                input[1] = channel.of([[ id: 'test_db' ], fasta_file])
                input[2] = channel.of([[ id: 'fragpipe_config' ], workflow_file])
                input[3] = Channel.empty()  // ch_decoy_db (not used)
                input[4] = channel.value(annotation_file)  // ch_annotation
                input[5] = []               // ch_manifest (not used)
                input[6] = channel.value([[], []])  // ch_taxon_files: FragPipe's tools/metaproteomics dumps

                """
            }
        }

        then {
            assertAll (
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.mzml,
                    workflow.out.pepxml,
                    workflow.out.pin,
                    workflow.out.validated_pepxml,
                    workflow.out.protxml,
                    workflow.out.psms,
                    workflow.out.peptides,
                    workflow.out.proteins,
                    workflow.out.results_dir,
                    workflow.out.combined_protein,
                    workflow.out.combined_peptide,
                    workflow.out.combined_ion,
                    // file names only: filelist_ionquant.txt holds the absolute --specdir (CmdIonquant)
                    workflow.out.ionquant_dir.collect { item -> [item[0], new File(item[1].toString()).list().sort()] },
                    workflow.out.tmt_abundance
                ).match() }
            )
        }
    }

