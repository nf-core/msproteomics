nextflow_workflow {

    name "Test Subworkflow FRAGPIPE_CONVERT"
    script "../main.nf"
    workflow "FRAGPIPE_CONVERT"
    config "./test.config"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "fragpipe_convert"

    test("fragpipe_convert - stub with mzML input") {
        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                def mzml = file("\${workDir}/sample.mzML")
                mzml.text = "mock"

                // Empty tool configs - no DIA preprocessing
                def tool_configs = [:]

                input[0] = channel.of([ [ id:'sample1', group: '', experiment: null, bioreplicate: null, data_type: 'DDA' ], mzml ])
                input[1] = channel.value(groovy.json.JsonOutput.toJson(tool_configs))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out.mzml).match() }
            )
        }
    }

    // RC-09: FragPipe hands .raw straight to MSFragger (CmdMsfragger.java:390-403), no conversion.
    test("fragpipe_convert - stub RAW input passes through unconverted") {
        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                def raw = file("\${workDir}/sample.raw")
                raw.text = "mock"

                def tool_configs = [:]

                input[0] = channel.of([ [ id:'sample1', group: '', experiment: null, bioreplicate: null, data_type: 'DDA' ], raw ])
                input[1] = channel.value(groovy.json.JsonOutput.toJson(tool_configs))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().size() == 0 : "no conversion task may run: ${workflow.trace.tasks()*.name}" },
                { assert workflow.out.mzml.collect { item -> file(item[1]).name } == ['sample.raw'] },
                { assert snapshot(workflow.out.mzml).match() }
            )
        }
    }

    // RC-15: every LC-MS format MSFragger reads natively is FragPipe input
    // (CmdMsfragger.java:764-766: .mgf, .mzml, .mzxml, .mzbin, .raw, .d), case-insensitive.
    test("fragpipe_convert - stub mzXML, MGF, mzBIN, RAW and .d pass through") {
        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                def names = ['a.mzXML', 'b.mgf', 'c.mzBIN', 'd.RAW', 'e.mzML']
                def files = names.collect { n -> def f = file("\${workDir}/" + n); f.text = 'mock'; f }
                def d = file("\${workDir}/f.d"); d.mkdirs()
                files << d

                input[0] = channel.fromList(files.collect { f -> [ [ id: f.baseName, group: '', experiment: null, bioreplicate: null, data_type: 'DDA' ], f ] })
                input[1] = channel.value(groovy.json.JsonOutput.toJson([:]))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().size() == 0 },
                { assert workflow.out.mzml.collect { item -> file(item[1]).name }.sort() == ['a.mzXML', 'b.mgf', 'c.mzBIN', 'd.RAW', 'e.mzML', 'f.d'] }
            )
        }
    }

    // RC-15: anything MSFragger cannot read stops the run instead of silently dropping the sample.
    test("fragpipe_convert - stub unsupported LC-MS file fails") {
        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                def wiff = file("\${workDir}/sample.wiff")
                wiff.text = "mock"
                input[0] = channel.of([ [ id:'sample1', group: '', experiment: null, bioreplicate: null, data_type: 'DDA' ], wiff ])
                input[1] = channel.value(groovy.json.JsonOutput.toJson([:]))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).join('\\n').contains('unsupported LC-MS file sample.wiff') }
            )
        }
    }

    // RC-09: DIA-Umpire reads .raw itself (CmdUmpireSe.java:129-141, -Dlibs.thermo.dir).
    test("fragpipe_convert - stub DIA-Umpire gets the RAW file") {
        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                def raw = file("\${workDir}/run_dia.raw")
                raw.text = "mock"
                input[0] = channel.of([ [ id:'run_dia', group: 'g', experiment: 'g', bioreplicate: null, data_type: 'DIA' ], raw ])
                input[1] = channel.value(groovy.json.JsonOutput.toJson([diaumpire: [run: true, args: 'Thread = THREADS', q_tiers: ['Q1']]]))
                """
            }
        }

        then {
            def umpire = workflow.trace.tasks().findAll { t -> t.name.contains('DIAUMPIRE') }
            assertAll(
                { assert workflow.success },
                { assert umpire.size() == 1 },
                { assert workflow.out.mzml.collect { item -> file(item[1]).name } == ['run_dia_Q1.mzML'] }
            )
        }
    }

    // RC-10/RC-11: DIA-Umpire runs only on files that are not DDA, DIA-Quant or DDA+, and its
    // enabled Q1/Q2/Q3 pseudo-MS/MS files replace the DIA file in the LC-MS list, typed DDA with
    // the source group as experiment (CmdUmpireSe.java:59-78, FragpipeRun.java:1380-1382).
    test("fragpipe_convert - stub DIA-Umpire replaces DIA files by their enabled Q tiers") {
        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                def dia = file("\${workDir}/run_dia.mzML")
                def dda = file("\${workDir}/run_dda.mzML")
                def quant = file("\${workDir}/run_quant.mzML")
                def ddaplus = file("\${workDir}/run_ddaplus.mzML")
                [dia, dda, quant, ddaplus].each { f -> f.text = "mock" }
                def tool_configs = [diaumpire: [run: true, args: 'Thread = 7', q_tiers: ['Q1', 'Q3']]]
                input[0] = channel.of(
                    [ [ id:'run_dia', group: 'control_1', experiment: 'control', bioreplicate: 1, data_type: 'DIA' ], dia ],
                    [ [ id:'run_dda', group: 'control_1', experiment: 'control', bioreplicate: 1, data_type: 'DDA' ], dda ],
                    [ [ id:'run_quant', group: 'control_1', experiment: 'control', bioreplicate: 1, data_type: 'DIA-Quant' ], quant ],
                    [ [ id:'run_ddaplus', group: 'control_1', experiment: 'control', bioreplicate: 1, data_type: 'DDA+' ], ddaplus ]
                )
                input[1] = channel.value(groovy.json.JsonOutput.toJson(tool_configs))
                """
            }
        }

        then {
            def files = workflow.out.mzml.collect { meta, f -> [file(f).name, meta.id, meta.group, meta.experiment, meta.data_type] }.sort { row -> row[0] }
            assertAll(
                { assert workflow.success },
                { assert files == [
                    ['run_dda.mzML', 'run_dda', 'control_1', 'control', 'DDA'],
                    ['run_ddaplus.mzML', 'run_ddaplus', 'control_1', 'control', 'DDA+'],
                    ['run_dia_Q1.mzML', 'run_dia_Q1', 'control_1_1', 'control_1', 'DDA'],
                    ['run_dia_Q3.mzML', 'run_dia_Q3', 'control_1_1', 'control_1', 'DDA'],
                    ['run_quant.mzML', 'run_quant', 'control_1', 'control', 'DIA-Quant']
                ] : files },
                { assert snapshot(files).match() }
            )
        }
    }

    // RC-10/RC-13: diaTracer runs only on DIA / DIA-Lib / GPF-DIA .d files and its _diatracer.mzML
    // replaces the .d, typed DDA (CmdDiaTracer.java:131-145); other .d files are searched as they are.
    test("fragpipe_convert - stub diaTracer replaces DIA .d files only") {
        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                def dia = file("\${workDir}/run_dia.d")
                def dda = file("\${workDir}/run_dda.d")
                [dia, dda].each { d -> d.mkdirs(); file("\${d}/analysis.tdf").text = "mock" }
                def tool_configs = [diatracer: [run: true, args: '--deltaApexIM 0.01']]
                input[0] = channel.of(
                    [ [ id:'run_dia', group: '', experiment: null, bioreplicate: null, data_type: 'DIA' ], dia ],
                    [ [ id:'run_dda', group: '', experiment: null, bioreplicate: null, data_type: 'DDA+' ], dda ]
                )
                input[1] = channel.value(groovy.json.JsonOutput.toJson(tool_configs))
                """
            }
        }

        then {
            def files = workflow.out.mzml.collect { meta, f -> [file(f).name, meta.id, meta.group, meta.data_type] }.sort { row -> row[0] }
            assertAll(
                { assert workflow.success },
                { assert files == [
                    ['run_dda.d', 'run_dda', '', 'DDA+'],
                    ['run_dia_diatracer.mzML', 'run_dia_diatracer', '', 'DDA']
                ] : files },
                { assert snapshot(files).match() }
            )
        }
    }
}
