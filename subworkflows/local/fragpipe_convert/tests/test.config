/*
 * Test configuration for FRAGPIPE_CONVERT subworkflow tests
 */

process {
    cpus   = 2
    memory = 8.GB
    time   = 1.h

    withName: 'DIAUMPIRE' {
        ext.args = ''
    }

    withName: 'DIATRACER' {
        ext.args = ''
    }
}

params {
    outdir = 'results'
    publish_dir_mode = 'copy'
}
