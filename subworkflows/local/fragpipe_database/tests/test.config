/*
 * Test configuration for FRAGPIPE_DATABASE subworkflow tests
 */

process {
    cpus   = 2
    memory = 8.GB
    time   = 1.h

    // The licensed FragPipe image is given at runtime: FRAGPIPE_CONTAINER=<image> nf-test test ...
    withName: 'PHILOSOPHERDATABASE' {
        container = System.getenv('FRAGPIPE_CONTAINER')
        ext.args  = '--contam --contamprefix'
    }
}

params {
    outdir = 'results'
    publish_dir_mode = 'copy'
}
