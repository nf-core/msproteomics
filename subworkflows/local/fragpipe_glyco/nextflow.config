/*
 * Configuration for FRAGPIPE_GLYCO subworkflow
 *
 * Includes: PAIRSCANS, OPAIR, MBG (PTMSHEPHERD: see ../fragpipe_ptm/nextflow.config)
 */

process {
    withName: 'PAIRSCANS' {
        cpus   = { 4 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: 'MBG' {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: 'OPAIR' {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
}

params {
    outdir = 'results'
    publish_dir_mode = 'copy'
}
