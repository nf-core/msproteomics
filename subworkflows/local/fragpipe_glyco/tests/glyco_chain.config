/*
 * FragPipe golden comparison of the glyco chain (PTM-Shepherd glycan assignment -> AppendFile -> MBG -> IonQuant).
 * The FragPipe image is not hardcoded: FRAGPIPE_CONTAINER names it (the licensed image FragPipe ran in).
 */
params {
    fragpipe_container = System.getenv('FRAGPIPE_CONTAINER')
}

docker.enabled    = true
docker.runOptions = '-u $(id -u):$(id -g)'

process {
    // the FragPipe reference ran with --threads 48 --ram 200 (overrides conf/test.config limits)
    resourceLimits = [cpus: 48, memory: 220.GB, time: 8.h]
    cpus   = 48
    memory = 200.GB
    time   = 4.h
    withName: '.*:(PTMSHEPHERD|MBG|IONQUANT|PAIRSCANS|OPAIR)' {
        cpus   = 48
        memory = 202.GB
        stageInMode = 'copy'  // real .raw files in the task dir; never write next to source data
        container = { params.fragpipe_container }
        ext.agree_fragpipe_license_agreement = true
    }
}
