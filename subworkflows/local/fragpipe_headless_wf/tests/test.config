/*
 * Test configuration for FRAGPIPE_HEADLESS_WF subworkflow tests
 */

// Resources come from the test profile's resourceLimits (conf/test.config), which fit the CI runner
process {
    withName: 'PHILOSOPHERDATABASE' {
        ext.args = '--contam --contamprefix'
    }

    // FRAGPIPEHEADLESS inherits process.container (licensed FragPipe)
    // because it requires licensed tools (MSFragger, IonQuant, etc.)
}

params {
    outdir = 'results'
    publish_dir_mode = 'copy'
}
