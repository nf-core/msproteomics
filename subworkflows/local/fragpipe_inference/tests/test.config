/*
 * Test configuration for FRAGPIPE_INFERENCE subworkflow tests
 */

process {
    cpus   = 2
    memory = 8.GB
    time   = 1.h

    withName: 'PHILOSOPHERPROTEINPROPHET' {
        ext.args = ''
    }

    withName: 'PHILOSOPHERFILTER' {
        ext.args = ''
    }
}

params {
    outdir = 'results'
    publish_dir_mode = 'copy'
}

process {
    withName: 'PHILOSOPHERFILTER_LATER|PHILOSOPHERIPROPHET|PHILOSOPHERABACUS' {
        ext.args = ''
    }
}
