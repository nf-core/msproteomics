nextflow_workflow {

    name "Test Subworkflow FRAGPIPE_QUANT"
    script "../main.nf"
    workflow "FRAGPIPE_QUANT"
    config "./test.config"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "fragpipe_quant"

    // Two named groups, label-free IonQuant: FragPipe's experiment_annotation.tsv from the LC-MS list
    // (ToolingUtils.generateLFQExperimentAnnotation) and --ionmobility 1 for a Bruker .d input
    test("fragpipe_quant - stub label-free ionquant writes the experiment annotation") {
        options "-stub"
        tag "stub"

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                def lfq = '--perform-ms1quant 1 --perform-isoquant 0 --isotol 20.0 --isolevel 2 --isotype tmt10 --ionmobility 0 --site-reports 1 --msstats 1 --minexps 1 --mbr 0 --maxlfq 1'
                def groups = ['g1', 'g2'].collect { g ->
                    def d = file("\${workDir}/\${g}")
                    d.mkdirs()
                    file("\${d}/psm.tsv").text = "peptide\\tprotein\\nPEPTIDEK\\tPROT1"
                    d
                }
                def spectra = ['a', 'b'].collect { n -> def f = file("\${workDir}/\${n}.mzML"); f.text = 'mock'; f }
                def tool_configs = [
                    ionquant: [run: true, args: lfq, modmasses: ['15.9949']],
                    tmtintegrator: [run: false, args: ''],
                    freequant: [run: false, args: '']
                ]
                input[0] = channel.of([[ id: 'g1', group: 'g1' ], groups[0]], [[ id: 'g2', group: 'g2' ], groups[1]])
                input[1] = channel.of([[ id: 'a', group: 'g1' ], spectra[0]], [[ id: 'b', group: 'g2' ], spectra[1]])
                input[2] = channel.of(
                    [[ id: 'a', experiment: 'g1', bioreplicate: null, data_type: 'DDA', group: 'g1' ], spectra[0]],
                    [[ id: 'b', experiment: 'g2', bioreplicate: null, data_type: 'DDA', group: 'g2' ], file('/data/b.d')]
                )
                input[3] = channel.value([])
                input[4] = channel.value(groovy.json.JsonOutput.toJson(tool_configs))
                input[5] = []                  // ch_glyco_masses (no AppendFile)
                input[6] = [ id: 'fragpipe' ]
                """
            }
        }

        then {
            def dir = new File(workflow.out.ionquant_dir[0][1].toString())
            def annotation = new File(workflow.out.experiment_annotation[0][1].toString()).readLines()
            assertAll(
                { assert workflow.success },
                { assert annotation[0] == 'file\tsample\tsample_name\tcondition\treplicate' },
                { assert annotation.drop(1).collect { line -> line.split('\t').drop(1).join(' ') } == ['g1 g1 g1 1', 'g2 g2 g2 1'] },
                { assert new File(dir, 'ionquant.log').text.contains('--ionmobility 1 --site-reports 1') },
                { assert snapshot(
                    workflow.out.combined_protein,
                    workflow.out.experiment_annotation.collect { item -> [item[0], new File(item[1].toString()).name] },
                    workflow.out.ionquant_dir.collect { item -> [item[0], new File(item[1].toString()).list().sort()] },
                    workflow.out.tmt_dir
                ).match() }
            )
        }
    }

    // TMT workflow with label-free quant on: FragPipe runs IonQuant, then the TMT MS1 pass, then the
    // isobaric pass in one work dir (FragpipeRun.java:2477-2479), each reading the psm.tsv the
    // previous pass rewrote; TMT-Integrator reads the isobaric output; the isobaric experiment
    // annotation replaces the label-free one (written later in FragPipe's configuration)
    test("fragpipe_quant - stub label-free and TMT IonQuant passes run in FragPipe order") {
        options "-stub"
        tag "stub"

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                def head = '--isotol 20.0 --isolevel 2 --ionmobility 0'
                def root = file("\${workDir}/workdir-root")
                root.mkdirs()
                file("\${root}/psm.tsv").text = "peptide\\tprotein\\nPEPTIDEK\\tPROT1"
                file("\${root}/protein.tsv").text = "protein\\nPROT1"
                def g2 = file("\${workDir}/p2")
                g2.mkdirs()
                file("\${g2}/psm.tsv").text = "peptide\\tprotein\\nPEPTIDEK\\tPROT1"
                file("\${g2}/protein.tsv").text = "protein\\nPROT1"
                def spectra = ['a', 'b'].collect { n -> def f = file("\${workDir}/\${n}.mzML"); f.text = 'mock'; f }
                def annotation = file("\${workDir}/tmt_annotation.tsv")
                annotation.text = "plex\\tchannel\\tsample\\tsample_name\\tcondition\\treplicate\\n\\t126\\t_126\\t_126\\t_126\\t1\\np2\\t126\\tp2_126\\tp2_126\\tp2_126\\t1\\n"
                def tool_configs = [
                    ionquant: [run: true, args: "--perform-ms1quant 1 --perform-isoquant 0 \${head} --isotype tmt10 --site-reports 1 --msstats 1 --minexps 1 --mbr 0", modmasses: []],
                    ionquant_ms1: [run: true, args: "--perform-ms1quant 1 --perform-isoquant 0 \${head} --isotype tmt10 --site-reports 0 --msstats 0 --minexps 1 --mbr 0", modmasses: []],
                    ionquant_isobaric: [run: true, args: "--perform-ms1quant 0 --perform-isoquant 1 \${head} --isotype TMT-10 --site-reports 0 --msstats 0 --minexps 1 --mbr 0", modmasses: []],
                    tmtintegrator: [run: true, args: file("\${baseDir}/subworkflows/local/fragpipe_quant/tests/tmt10_tmtintegrator_conf.txt", checkIfExists: true).text  /* the plan's tmt-integrator-conf.yml text */, extraction_tool: 0, philosopher_msstats: false],
                    freequant: [run: false, args: '']
                ]
                input[0] = channel.of([[ id: 'workdir-root', group: '' ], root], [[ id: 'p2', group: 'p2' ], g2])
                input[1] = channel.of([[ id: 'a', group: '' ], spectra[0]], [[ id: 'b', group: 'p2' ], spectra[1]])
                input[2] = channel.of(
                    [[ id: 'a', experiment: null, bioreplicate: null, data_type: 'DDA', group: '' ], spectra[0]],
                    [[ id: 'b', experiment: 'p2', bioreplicate: null, data_type: 'DDA', group: 'p2' ], spectra[1]]
                )
                input[3] = channel.of(annotation)
                input[4] = channel.value(groovy.json.JsonOutput.toJson(tool_configs))
                input[5] = []                  // ch_glyco_masses (no AppendFile)
                input[6] = [ id: 'fragpipe' ]
                """
            }
        }

        then {
            // task dir per process, and the task each pass's staged group dirs come from
            def tasks = [:]
            new File("${launchDir}/work").eachFileRecurse { f ->
                if (f.name == '.command.run') {
                    def name = f.readLines().find { line -> line.startsWith('### name:') }
                    tasks[(name =~ /'([^ ']+)/)[0][1].tokenize(':')[-1]] = f.parentFile.absolutePath
                }
            }
            // the source path Nextflow stages as <staged> (ln -s / cp -fRL line of .command.run)
            def source = { String proc, String staged ->
                def line = new File(tasks[proc], '.command.run').readLines().find { l -> (l.contains('ln -s') || l.contains('cp -fRL ')) && l.trim().endsWith(' ' + staged) }
                assert line : "${proc} does not stage ${staged}"
                line.trim().split(' ')[-2]
            }
            def annotations = workflow.out.experiment_annotation.collect { item -> new File(item[1].toString()).readLines() }
            def tmt_task = tasks['TMTINTEGRATOR']
            assertAll(
                { assert workflow.success },
                { assert source('IONQUANT', 'p2') == "${launchDir}/work/p2".toString() },
                { assert source('IONQUANT_MS1', 'p2').startsWith(tasks['IONQUANT']) },
                { assert source('IONQUANT_MS1', 'workdir-root').startsWith(tasks['IONQUANT']) },
                { assert source('IONQUANT_ISOBARIC', 'p2').startsWith(tasks['IONQUANT_MS1']) },
                { assert source('IONQUANT_ISOBARIC', 'workdir-root').startsWith(tasks['IONQUANT_MS1']) },
                { assert source('TMTINTEGRATOR', 'input_results/p2').startsWith(tasks['IONQUANT_ISOBARIC']) },
                { assert source('TMTINTEGRATOR', 'input_results/workdir-root').startsWith(tasks['IONQUANT_ISOBARIC']) },
                { assert annotations == [['plex\tchannel\tsample\tsample_name\tcondition\treplicate', '\t126\t_126\t_126\t\t126', 'p2\t126\tp2_126\tp2_126\tp2\t126']] },
                // the work dir is named like the results directory (FragPipe's plex name for the blank group)
                { assert new File(tmt_task, new File("$outputDir").name + '/tmt-integrator-conf.yml').exists() },
                { assert snapshot(
                    annotations,
                    workflow.out.tmt_abundance.collect { item -> [item[0], item[1].collect { f -> new File(f.toString()).name }] },
                    // psm.tsv arguments, as the stub logs them (tmtIntegratorCommands)
                    new File(tmt_task, 'tmt-integrator.log').text.trim().tokenize(' ').drop(2).collect { p -> p.replace(tmt_task, '<task>') }
                ).match() }
            )
        }
    }

    // Only named groups: IonQuant emits no root_group (no blank group, and object storage keeps no empty
    // directory), so each pass reads the previous pass's named groups alone (remainder join)
    test("fragpipe_quant - stub TMT IonQuant passes without a blank group") {
        options "-stub"
        tag "stub"

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                def head = '--isotol 20.0 --isolevel 2 --ionmobility 0'
                def groups = ['p1', 'p2'].collect { n ->
                    def g = file("\${workDir}/\${n}")
                    g.mkdirs()
                    file("\${g}/psm.tsv").text = "peptide\\tprotein\\nPEPTIDEK\\tPROT1"
                    file("\${g}/protein.tsv").text = "protein\\nPROT1"
                    g
                }
                def spectra = ['a', 'b'].collect { n -> def f = file("\${workDir}/\${n}.mzML"); f.text = 'mock'; f }
                def annotation = file("\${workDir}/tmt_annotation.tsv")
                annotation.text = "plex\\tchannel\\tsample\\tsample_name\\tcondition\\treplicate\\np1\\t126\\tp1_126\\tp1_126\\tp1_126\\t1\\np2\\t126\\tp2_126\\tp2_126\\tp2_126\\t1\\n"
                def tool_configs = [
                    ionquant: [run: true, args: "--perform-ms1quant 1 --perform-isoquant 0 \${head} --isotype tmt10 --site-reports 1 --msstats 1 --minexps 1 --mbr 0", modmasses: []],
                    ionquant_ms1: [run: true, args: "--perform-ms1quant 1 --perform-isoquant 0 \${head} --isotype tmt10 --site-reports 0 --msstats 0 --minexps 1 --mbr 0", modmasses: []],
                    ionquant_isobaric: [run: true, args: "--perform-ms1quant 0 --perform-isoquant 1 \${head} --isotype TMT-10 --site-reports 0 --msstats 0 --minexps 1 --mbr 0", modmasses: []],
                    tmtintegrator: [run: true, args: file("\${baseDir}/subworkflows/local/fragpipe_quant/tests/tmt10_tmtintegrator_conf.txt", checkIfExists: true).text, extraction_tool: 0, philosopher_msstats: false],
                    freequant: [run: false, args: '']
                ]
                input[0] = channel.of([[ id: 'p1', group: 'p1' ], groups[0]], [[ id: 'p2', group: 'p2' ], groups[1]])
                input[1] = channel.of([[ id: 'a', group: 'p1' ], spectra[0]], [[ id: 'b', group: 'p2' ], spectra[1]])
                input[2] = channel.of(
                    [[ id: 'a', experiment: 'p1', bioreplicate: null, data_type: 'DDA', group: 'p1' ], spectra[0]],
                    [[ id: 'b', experiment: 'p2', bioreplicate: null, data_type: 'DDA', group: 'p2' ], spectra[1]]
                )
                input[3] = channel.of(annotation)
                input[4] = channel.value(groovy.json.JsonOutput.toJson(tool_configs))
                input[5] = []                  // ch_glyco_masses (no AppendFile)
                input[6] = [ id: 'fragpipe' ]
                """
            }
        }

        then {
            def tasks = [:]
            new File("${launchDir}/work").eachFileRecurse { f ->
                if (f.name == '.command.run') {
                    def name = f.readLines().find { line -> line.startsWith('### name:') }
                    tasks[(name =~ /'([^ ']+)/)[0][1].tokenize(':')[-1]] = f.parentFile.absolutePath
                }
            }
            def source = { String proc, String staged ->
                def line = new File(tasks[proc], '.command.run').readLines().find { l -> (l.contains('ln -s') || l.contains('cp -fRL ')) && l.trim().endsWith(' ' + staged) }
                assert line : "${proc} does not stage ${staged}"
                line.trim().split(' ')[-2]
            }
            def tmt_task = tasks['TMTINTEGRATOR']
            assertAll(
                { assert workflow.success },
                { assert !new File(tasks['IONQUANT'], 'ionquant_root').exists() },
                { assert source('IONQUANT_MS1', 'p1').startsWith(tasks['IONQUANT']) },
                { assert source('IONQUANT_MS1', 'p2').startsWith(tasks['IONQUANT']) },
                { assert source('IONQUANT_ISOBARIC', 'p1').startsWith(tasks['IONQUANT_MS1']) },
                { assert source('IONQUANT_ISOBARIC', 'p2').startsWith(tasks['IONQUANT_MS1']) },
                { assert source('TMTINTEGRATOR', 'input_results/p1').startsWith(tasks['IONQUANT_ISOBARIC']) },
                { assert source('TMTINTEGRATOR', 'input_results/p2').startsWith(tasks['IONQUANT_ISOBARIC']) },
                { assert snapshot(
                    workflow.out.tmt_abundance.collect { item -> [item[0], item[1].collect { f -> new File(f.toString()).name }] },
                    new File(tmt_task, 'tmt-integrator.log').text.trim().tokenize(' ').drop(2).collect { p -> p.replace(tmt_task, '<task>') }
                ).match() }
            )
        }
    }

    // FragpipeRun.java:2195-2209: FPOP TMT runs TMT-Integrator a second time on the same PSM tables,
    // with tmt-integrator-conf-unmod.yml into tmt-report-unmod (CmdTmtIntegrator.java:62, :149-152)
    test("fragpipe_quant - stub FPOP TMT runs TMT-Integrator a second time into tmt-report-unmod") {
        options "-stub"
        tag "stub"

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                def head = '--isotol 20.0 --isolevel 2 --ionmobility 0'
                def g1 = file("\${workDir}/p1")
                g1.mkdirs()
                file("\${g1}/psm.tsv").text = "peptide\\tprotein\\nPEPTIDEK\\tPROT1"
                file("\${g1}/protein.tsv").text = "protein\\nPROT1"
                def spectrum = file("\${workDir}/a.mzML")
                spectrum.text = 'mock'
                def annotation = file("\${workDir}/tmt_annotation.tsv")
                annotation.text = "plex\\tchannel\\tsample\\tsample_name\\tcondition\\treplicate\\np1\\t126\\tp1_126\\tp1_126\\tp1_126\\t1\\n"
                def tool_configs = [
                    ionquant: [run: false, args: ''],
                    ionquant_ms1: [run: true, args: "--perform-ms1quant 1 --perform-isoquant 0 \${head} --isotype tmt10 --site-reports 0 --msstats 0 --minexps 1 --mbr 0", modmasses: []],
                    ionquant_isobaric: [run: true, args: "--perform-ms1quant 0 --perform-isoquant 1 \${head} --isotype TMT-10 --site-reports 0 --msstats 0 --minexps 1 --mbr 0", modmasses: []],
                    tmtintegrator: [run: true, args: file("\${baseDir}/subworkflows/local/fragpipe_quant/tests/tmt10_tmtintegrator_conf.txt", checkIfExists: true).text, extraction_tool: 0, philosopher_msstats: false],
                    tmtintegrator_unmod: [run: true, args: file("\${baseDir}/subworkflows/local/fragpipe_quant/tests/tmt10_tmtintegrator_conf.txt", checkIfExists: true).text  /* the plan's unmod text has the same layout */, config_type: 'params_file'],
                    freequant: [run: false, args: '']
                ]
                input[0] = channel.of([[ id: 'p1', group: 'p1' ], g1])
                input[1] = channel.of([[ id: 'a', group: 'p1' ], spectrum])
                input[2] = channel.of([[ id: 'a', experiment: 'p1', bioreplicate: null, data_type: 'DDA', group: 'p1' ], spectrum])
                input[3] = channel.of(annotation)
                input[4] = channel.value(groovy.json.JsonOutput.toJson(tool_configs))
                input[5] = []                  // ch_glyco_masses (no AppendFile)
                input[6] = [ id: 'fragpipe' ]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.tmt_dir.collect { item -> new File(item[1].toString()).name } == ['tmt-report'] },
                { assert workflow.out.tmt_unmod_dir.collect { item -> new File(item[1].toString()).name } == ['tmt-report-unmod'] },
                { assert snapshot(
                    workflow.out.tmt_unmod_dir.collect { item -> [item[0], new File(item[1].toString()).list().sort()] }
                ).match() }
            )
        }
    }
}
