    test("fragpipe_search - stub with all tools") {
        options "-stub"
        tag "stub"

        when {
            workflow {
                """
                def mzml_file = file("\${workDir}/test.mzML")
                mzml_file.text = "<?xml version='1.0'?><mzML></mzML>"
                def fasta_file = file("\${workDir}/test.fasta")
                fasta_file.text = ">PROT1\\nPEPTIDEK"

                // Tool configs: all tools enabled
                def tool_configs = [
                    msfragger: [run: true, args: '--precursor_mass_tolerance 20', calibrate_mass: [DDA: '2']],
                    msbooster: [run: true, args: ''],
                    crystalc:  [run: true, args: 'precursor_charge = 1 6']
                ]

                input[0] = channel.of([[ id: 'test_search_all', group: '', data_type: 'DDA' ], mzml_file])
                input[1] = channel.value(fasta_file)
                input[2] = channel.value(groovy.json.JsonOutput.toJson(tool_configs))
                def fragger_params = file("\${workDir}/fragger.params")
                fragger_params.text = "database_name = test.fasta\\ndata_type = 0\\nprecursor_mass_tolerance = 20\\ncalibrate_mass = 2\\nwrite_calibrated_mzml = 0\\noutput_format = tsv_pepXML_pin\\noutput_report_topN = 1"
                input[3] = channel.value([['DDA', fragger_params]])  // ch_fragger_params, one set per data type
                input[4] = channel.value(fragger_params)             // ch_msbooster_fragger_params
                def msbooster_params = file("\${workDir}/msbooster_params.txt")
                msbooster_params.text = "useIM = true\\nfindBestImModel = false\\nnumThreads = 4\\n"
                input[5] = channel.value(msbooster_params)  // ch_msbooster_params (workflow-derived keys)
                input[6] = channel.value(1)          // ch_num_slices (standard, no split)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.pepxml,
                    workflow.out.pin,
                    workflow.out.pin_rescored,
