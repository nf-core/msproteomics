nextflow_workflow {

    name "Test Subworkflow FRAGPIPE_SEARCH"
    script "../main.nf"
    workflow "FRAGPIPE_SEARCH"
    config "./test.config"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "fragpipe_search"

    test("fragpipe_search - stub with msfragger only") {
        options "-stub"
        tag "stub"

        when {
            workflow {
                """
                def mzml_file = file("\${workDir}/test.mzML")
                mzml_file.text = "<?xml version='1.0'?><mzML></mzML>"
                def fasta_file = file("\${workDir}/test.fasta")
                fasta_file.text = ">PROT1\\nPEPTIDEK"

                // Tool configs: only msfragger enabled
                def tool_configs = [
                    msfragger: [run: true, args: '--precursor_mass_tolerance 20', calibrate_mass: [DDA: '2']],
                    msbooster: [run: false, args: ''],
                    crystalc:  [run: false, args: '']
                ]

                input[0] = channel.of([[ id: 'test_search', data_type: 'DDA' ], mzml_file])
                input[1] = channel.value(fasta_file)
                input[2] = channel.value(groovy.json.JsonOutput.toJson(tool_configs))
                def fragger_params = file("\${workDir}/fragger.params")
                fragger_params.text = "database_name = test.fasta\\ndata_type = 0\\nprecursor_mass_tolerance = 20\\ncalibrate_mass = 2\\nwrite_calibrated_mzml = 0\\noutput_format = tsv_pepXML_pin\\noutput_report_topN = 1"
                input[3] = channel.value([['DDA', fragger_params]])  // ch_fragger_params, one set per data type
                input[4] = channel.value(fragger_params)             // ch_msbooster_fragger_params
                def msbooster_params = file("\${workDir}/msbooster_params.txt")
                msbooster_params.text = "useIM = true\\nfindBestImModel = false\\nnumThreads = 4\\n"
                input[5] = channel.value(msbooster_params)  // ch_msbooster_params (workflow-derived keys)
                input[6] = channel.value(1)          // ch_num_slices (standard, no split)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.pepxml,
                    workflow.out.pin,
                    workflow.out.pin_rescored,
                    workflow.out.tsv,
                    workflow.out.results_dir,
                    workflow.out.lcms,
                    workflow.out.validation_lcms
                ).match() }
            )
        }
    }

    test("fragpipe_search - stub with msbooster") {
        options "-stub"
        tag "stub"

        when {
            workflow {
                """
                def mzml_file = file("\${workDir}/test.mzML")
                mzml_file.text = "<?xml version='1.0'?><mzML></mzML>"
                def fasta_file = file("\${workDir}/test.fasta")
                fasta_file.text = ">PROT1\\nPEPTIDEK"

                // Tool configs: msfragger + msbooster enabled
                def tool_configs = [
                    msfragger: [run: true, args: '--precursor_mass_tolerance 20', calibrate_mass: [DDA: '2']],
                    msbooster: [run: true, args: ''],
                    crystalc:  [run: false, args: '']
                ]

                input[0] = channel.of([[ id: 'test_search_boost', group: '', data_type: 'DDA' ], mzml_file])
                input[1] = channel.value(fasta_file)
                input[2] = channel.value(groovy.json.JsonOutput.toJson(tool_configs))
                def fragger_params = file("\${workDir}/fragger.params")
                fragger_params.text = "database_name = test.fasta\\ndata_type = 0\\nprecursor_mass_tolerance = 20\\ncalibrate_mass = 2\\nwrite_calibrated_mzml = 0\\noutput_format = tsv_pepXML_pin\\noutput_report_topN = 1"
                input[3] = channel.value([['DDA', fragger_params]])  // ch_fragger_params, one set per data type
                input[4] = channel.value(fragger_params)             // ch_msbooster_fragger_params
                def msbooster_params = file("\${workDir}/msbooster_params.txt")
                msbooster_params.text = "useIM = true\\nfindBestImModel = false\\nnumThreads = 4\\n"
                input[5] = channel.value(msbooster_params)  // ch_msbooster_params (workflow-derived keys)
                input[6] = channel.value(1)          // ch_num_slices (standard, no split)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.pepxml,
                    workflow.out.pin,
                    workflow.out.pin_rescored,
                    workflow.out.tsv,
                    workflow.out.results_dir,
                    workflow.out.lcms,
                    workflow.out.validation_lcms
                ).match() }
            )
        }
    }

    test("fragpipe_search - stub with msbooster and a spectral library stages the library") {
        options "-stub"
        tag "stub"

        when {
            workflow {
                """
                def mzml_file = file("\${workDir}/test.mzML")
                mzml_file.text = "<?xml version='1.0'?><mzML></mzML>"
                def fasta_file = file("\${workDir}/test.fasta")
                fasta_file.text = ">PROT1\\nPEPTIDEK"
                def library = file("\${workDir}/user_library.tsv")
                library.text = "mock library"

                def tool_configs = [
                    msfragger: [run: true, args: '--precursor_mass_tolerance 20', calibrate_mass: [DDA: '2']],
                    msbooster: [run: true, args: '', spectral_library: library.toString()],
                    crystalc:  [run: false, args: '']
                ]

                input[0] = channel.of([[ id: 'test_search_boost', group: '', data_type: 'DDA' ], mzml_file])
                input[1] = channel.value(fasta_file)
                input[2] = channel.value(groovy.json.JsonOutput.toJson(tool_configs))
                def fragger_params = file("\${workDir}/fragger.params")
                fragger_params.text = "database_name = test.fasta\\ndata_type = 0\\nprecursor_mass_tolerance = 20\\ncalibrate_mass = 2\\nwrite_calibrated_mzml = 0\\noutput_format = tsv_pepXML_pin\\noutput_report_topN = 1"
                input[3] = channel.value([['DDA', fragger_params]])
                input[4] = channel.value(fragger_params)
                def msbooster_params = file("\${workDir}/msbooster_params.txt")
                msbooster_params.text = "useIM = true\\nfindBestImModel = false\\nspectraPredFile = {SPECTRAL_LIBRARY}\\nRTPredFile = {SPECTRAL_LIBRARY}\\nIMPredFile = {SPECTRAL_LIBRARY}\\nnumThreads = 4\\n"
                input[5] = channel.value(msbooster_params)
                input[6] = channel.value(1)
                """
            }
        }

        then {
            // MSBOOSTER's task directory holds msbooster/msbooster_params.txt
            def params_texts = []
            new File(workDir.toString()).eachFileRecurse { f -> if (f.path.endsWith('/msbooster/msbooster_params.txt')) { params_texts << f } }
            assertAll(
                { assert workflow.success },
                { assert params_texts.size() == 1 },
                { assert snapshot(params_texts[0].readLines().findAll { l -> l.contains('PredFile') }).match() },
                { assert params_texts[0].text.contains('spectraPredFile = <task dir>/spectral_library/user_library.tsv\nRTPredFile = <task dir>/spectral_library/user_library.tsv\nIMPredFile = <task dir>/spectral_library/user_library.tsv\n') }
            )
        }
    }

    test("fragpipe_search - stub with crystalc") {
