/*
 * Golden FRAGPIPE_SPECLIB test: FragPipe 24.0's own tools in the fixed licensed image
 * given by FRAGPIPE_CONTAINER (pinned FragPipe-SpecLib Python set).
 * Threads and RAM equal the golden FragPipe runs (--threads 48 --ram 200).
 *
 *   nf-test test subworkflows/local/fragpipe_speclib/tests/golden.nf.test --tag golden
 * GOLDEN_ROOT (required) holds the captured FragPipe runs; FRAGPIPE_CONTAINER (required) is the image.
 */

params {
    // the licensed FragPipe image (fixed pinned-Python build, by digest); never written into the repo
    fragpipe_container = System.getenv('FRAGPIPE_CONTAINER') ?: { throw new IllegalArgumentException('Set FRAGPIPE_CONTAINER to the licensed FragPipe 24.0 image (by digest) for the golden test') }()
}

docker.enabled    = true
docker.runOptions = '-u $(id -u):$(id -g)'

process {
    resourceLimits = [ cpus: 48, memory: 202.GB, time: 4.h ]
    withName: 'SPECLIBGEN|DIANNFRAGPIPE' {
        cpus   = 48
        memory = 202.GB   // -Xmx200G as FragPipe --ram 200 (ram = memory - 2)
        time   = 4.h
    }
}
