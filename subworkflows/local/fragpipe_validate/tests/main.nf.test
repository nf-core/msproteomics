nextflow_workflow {

    name "Test Subworkflow FRAGPIPE_VALIDATE"
    script "../main.nf"
    workflow "FRAGPIPE_VALIDATE"
    config "./test.config"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "fragpipe_validate"
    tag "percolator"
    tag "peptideprophet"
    tag "ptmprophet"

    test("fragpipe_validate - stub percolator with MSBooster PIN and PTMProphet per rank") {
        options "-stub"
        tag "stub"

        when {
            workflow {
                """
                ['s1.pin', 's1_edited.pin', 's1_rank1.pepXML', 's1_rank2.pepXML', 's1.mzML', 'db.fasta'].each { n -> file("\${workDir}/\${n}").text = 'mock' }
                def meta = [ id: 's1', group: 'A', experiment: 'A', bioreplicate: null, data_type: 'DDA+' ]
                def tool_configs = [
                    database:       [run: true, decoy_tag: 'rev_'],
                    msfragger:      [run: true, has_calibrated_mzml: false],
                    msbooster:      [run: true],
                    percolator:     [run: true, args: '--only-psms', min_prob: '0.7', keep_tsv_files: false],
                    peptideprophet: [run: false],
                    ptmprophet:     [run: true, args: 'KEEPOLD STY:79.966331 MINPROB=0.5'],
                    crystalc:       [run: false],
                    metaproteomics: [run: false]
                ]
                input[0] = channel.of([meta, file("\${workDir}/s1.pin")])
                input[1] = channel.of([meta, file("\${workDir}/s1_edited.pin")])
                input[2] = channel.of([meta, [file("\${workDir}/s1_rank2.pepXML"), file("\${workDir}/s1_rank1.pepXML")]])
                input[3] = channel.of([meta, file("\${workDir}/s1.mzML")])
                input[4] = channel.empty()
                input[5] = channel.empty()
                input[6] = file("\${workDir}/db.fasta")
                input[7] = channel.value(groovy.json.JsonOutput.toJson(tool_configs))
                """
            }
        }

        then {
            def names = { ch -> ch.collect { item -> [item[1]].flatten().collect { f -> new File(f.toString()).name } } }
            assertAll(
                { assert workflow.success },
                // CmdPercolator.java:71-101: one interact file per rank, in rank order
                { assert names(workflow.out.pepxml) == [['interact-s1_rank1.pep.xml', 'interact-s1_rank2.pep.xml']] },
                // CmdPtmProphet.java:107-124: one PTMProphet per interact file, regrouped per LC-MS file
                { assert names(workflow.out.mod_pepxml) == [['interact-s1_rank1.mod.pep.xml', 'interact-s1_rank2.mod.pep.xml']] },
                // pepxml_group mixes the validated and PTMProphet pepXMLs (mix order is arbitrary): sorted by file name
                { assert snapshot(workflow.out.pepxml, workflow.out.pepxml_group.sort { item -> new File(item[1][0].toString()).name }, workflow.out.mod_pepxml).match() }
            )
        }
    }

    test("fragpipe_validate - stub combined PeptideProphet per group in FragPipe order") {
        options "-stub"
        tag "stub"

        when {
            workflow {
                """
                ['b.pepXML', 'a.pepXML', 'c.pepXML', 'a.mzML', 'b.mzML', 'c.mzML', 'b.pin', 'a.pin', 'c.pin', 'db.fasta'].each { n -> file("\${workDir}/\${n}").text = 'mock' }
                def m = { id, group -> [ id: id, group: group, experiment: group, bioreplicate: null, data_type: 'DDA' ] }
                def tool_configs = [
                    database:       [run: true, decoy_tag: 'rev_'],
                    msfragger:      [run: true, has_calibrated_mzml: false],
                    percolator:     [run: false],
                    peptideprophet: [run: true, args: '--nonparam', combine: true],
                    ptmprophet:     [run: false]
                ]
                input[0] = channel.of('b', 'a', 'c').map { id -> [m.call(id, id == 'c' ? 'G2' : 'G1'), file("\${workDir}/\${id}.pin")] }
                input[1] = channel.of('b', 'a', 'c').map { id -> [m.call(id, id == 'c' ? 'G2' : 'G1'), file("\${workDir}/\${id}.pin")] }
                input[2] = channel.of('b', 'a', 'c').map { id -> [m.call(id, id == 'c' ? 'G2' : 'G1'), file("\${workDir}/\${id}.pepXML")] }
                input[3] = channel.of('b', 'a', 'c').map { id -> [m.call(id, id == 'c' ? 'G2' : 'G1'), file("\${workDir}/\${id}.mzML")] }
                input[4] = channel.empty()
                input[5] = channel.empty()
                input[6] = file("\${workDir}/db.fasta")
                input[7] = channel.value(groovy.json.JsonOutput.toJson(tool_configs))
                """
            }
        }

        then {
            def g1 = workflow.out.pepxml.find { item -> item[0].group == 'G1' }
            def log_lines = new File(new File([g1[1]].flatten()[0].toString()).parentFile, 'peptideprophet.log').readLines()
            assertAll(
                { assert workflow.success },
                { assert workflow.out.pepxml.size() == 2 },
                // CmdPeptideProphet.java:302-336: one --combine run per group in its group dir, files in InputLcmsFile order
                { assert log_lines[0].endsWith('--combine a.pepXML b.pepXML') : log_lines[0] },
                { assert log_lines[1].endsWith('RewritePepxml {CWD}/G1/interact.pep.xml {CWD}/a.mzML {CWD}/b.mzML') : log_lines[1] },
                { assert snapshot(workflow.out.pepxml).match() }
            )
        }
    }

    test("fragpipe_validate - stub per-file PeptideProphet writes the uncalibrated mzML path for .d") {
        options "-stub"
        tag "stub"

        when {
            workflow {
                """
                ['s1.pepXML', 's1.pin', 's1_uncalibrated.mzML', 'db.fasta'].each { n -> file("\${workDir}/\${n}").text = 'mock' }
                file("\${workDir}/s1.d").mkdirs()
                def meta = [ id: 's1', group: '', experiment: null, bioreplicate: null, data_type: 'DDA' ]
                def tool_configs = [
                    database:       [run: true, decoy_tag: 'rev_'],
                    msfragger:      [run: true, has_calibrated_mzml: false],
                    percolator:     [run: false],
                    peptideprophet: [run: true, args: '--nonparam', combine: false],
                    ptmprophet:     [run: false]
                ]
                input[0] = channel.of([meta, file("\${workDir}/s1.pin")])
                input[1] = channel.of([meta, file("\${workDir}/s1.pin")])
                input[2] = channel.of([meta, file("\${workDir}/s1.pepXML")])
                input[3] = channel.of([meta, file("\${workDir}/s1.d")])
                input[4] = channel.empty()
                input[5] = channel.of([meta, file("\${workDir}/s1_uncalibrated.mzML")])
                input[6] = file("\${workDir}/db.fasta")
                input[7] = channel.value(groovy.json.JsonOutput.toJson(tool_configs))
                """
            }
        }

        then {
            def log_lines = new File(new File([workflow.out.pepxml[0][1]].flatten()[0].toString()).parentFile, 'peptideprophet.log').readLines()
            assertAll(
                { assert workflow.success },
                // CmdPeptideProphet.java:442-447: .d -> <stem>_uncalibrated.mzML
                { assert log_lines[1].endsWith('RewritePepxml {CWD}/interact-s1.pep.xml {CWD}/s1_uncalibrated.mzML') : log_lines[1] },
                { assert snapshot(workflow.out.pepxml).match() }
            )
        }
    }

    // MSFragger output_format tsv_pepXML writes no PIN (FragPipe's PeptideProphet workflows, e.g. glyco-N-LFQ):
    // Percolator does not run, so its joins must not ask every searched file for a PIN
    test("fragpipe_validate - stub per-file PeptideProphet when MSFragger writes no PIN") {
        options "-stub"
        tag "stub"

        when {
            workflow {
                """
                ['a.pepXML', 'b.pepXML', 'a.mzML', 'b.mzML', 'db.fasta'].each { n -> file("\${workDir}/\${n}").text = 'mock' }
                def m = { id -> [ id: id, group: id.toUpperCase(), experiment: id.toUpperCase(), bioreplicate: null, data_type: 'DDA' ] }
                def tool_configs = [
                    database:       [run: true, decoy_tag: 'rev_'],
                    msfragger:      [run: true, has_calibrated_mzml: false],
                    percolator:     [run: false],
                    peptideprophet: [run: true, args: '--nonparam', combine: false],
                    ptmprophet:     [run: false]
                ]
                input[0] = channel.empty()
                input[1] = channel.empty()
                input[2] = channel.of('a', 'b').map { id -> [m.call(id), file("\${workDir}/\${id}.pepXML")] }
                input[3] = channel.of('a', 'b').map { id -> [m.call(id), file("\${workDir}/\${id}.mzML")] }
                input[4] = channel.empty()
                input[5] = channel.empty()
                input[6] = file("\${workDir}/db.fasta")
                input[7] = channel.value(groovy.json.JsonOutput.toJson(tool_configs))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.pepxml.size() == 2 },
                { assert snapshot(workflow.out.pepxml).match() }
            )
        }
    }
}
