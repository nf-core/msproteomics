// Unit tests for the FragPipe grouping / samplesheet helpers in fragpipe_utils.nf.
// Expected values follow FragPipe 24.0 InputLcmsFile.java:48-51 (experiment sanitising)
// and :131-145 (getGroup()).

nextflow_function {

    name "Test Functions fragpipe_utils"
    script "../fragpipe_utils.nf"

    tag "subworkflows"
    tag "fragpipe_utils"
    tag "stub"

    // InputLcmsFile.guessDataType (InputLcmsFile.java:86-101) reads FragPipe's whole absolute path, not only the file name
    test("guessFragpipeDataType - a file under a DIA directory is DIA") {
        function "guessFragpipeDataType"
        when {
            function {
                """
                input[0] = file('/data/DIA_runs/a.mzML')
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'DIA' }
            )
        }
    }

    // InputLcmsFile.guessDataType (InputLcmsFile.java:86-101) reads FragPipe's whole absolute path, not only the file name
    test("guessFragpipeDataType - dda anywhere in the path wins over DIA") {
        function "guessFragpipeDataType"
        when {
            function {
                """
                input[0] = file('/data/DIA_runs/dda_a.mzML')
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'DDA' }
            )
        }
    }

    // InputLcmsFile.guessDataType (InputLcmsFile.java:86-101) reads FragPipe's whole absolute path, not only the file name
    test("guessFragpipeDataType - WWA in the path is DDA+") {
        function "guessFragpipeDataType"
        when {
            function {
                """
                input[0] = file('/data/WWA/a.mzML')
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'DDA+' }
            )
        }
    }

    // InputLcmsFile.guessDataType (InputLcmsFile.java:86-101) reads FragPipe's whole absolute path, not only the file name
    test("guessFragpipeDataType - no tag is DDA") {
        function "guessFragpipeDataType"
        when {
            function {
                """
                input[0] = file('/data/runs/a.mzML')
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'DDA' }
            )
        }
    }

    // parseSamplesheet applies it once, to the samplesheet's original path; the type then travels in meta.data_type
    test("fragpipeDataType - a blank type is FragPipe's guess on the original path, a DIA directory gives DIA") {
        function "fragpipeDataType"
        when {
            function {
                """
                input[0] = null
                input[1] = file('/data/DIA_runs/a.mzML')
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'DIA' }
            )
        }
    }

    test("fragpipeGroup - experiment and bioreplicate give experiment_bioreplicate") {
        function "fragpipeGroup"
        when {
            function {
                """
                input[0] = 'control'
                input[1] = 2
                input[2] = false
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'control_2' },
                { assert snapshot(function.result).match() }
            )
        }
    }

    test("fragpipeGroup - blank experiment with bioreplicate gives exp_bioreplicate") {
        function "fragpipeGroup"
        when {
            function {
                """
                input[0] = null
                input[1] = 3
                input[2] = false
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'exp_3' },
                { assert snapshot(function.result).match() }
            )
        }
    }

    test("fragpipeGroup - experiment is trimmed and sanitised, no bioreplicate gives experiment") {
        function "fragpipeGroup"
        when {
            function {
                """
                input[0] = ' Ctrl-A.1 '
                input[1] = null
                input[2] = false
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'Ctrl_A_1' },
                { assert snapshot(function.result).match() }
            )
        }
    }

    test("fragpipeGroup - blank experiment and bioreplicate gives the single group") {
        function "fragpipeGroup"
        when {
            function {
                """
                input[0] = null
                input[1] = null
                input[2] = false
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == '' },
                { assert snapshot(function.result).match() }
            )
        }
    }

    test("fragpipeGroup - speclib or DIA-NN run gives the single group") {
        function "fragpipeGroup"
        when {
            function {
                """
                input[0] = 'control'
                input[1] = 1
                input[2] = true
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == '' },
                { assert snapshot(function.result).match() }
            )
        }
    }

    // InputLcmsFile.getGroup() returns "" when SpeclibPanel or DiannPanel isRun()
    // (FP/api/InputLcmsFile.java:131-136); the panels' checkboxes are the workflow keys
    // speclibgen.run-speclibgen (SpeclibPanel.java:136-137) and diann.run-dia-nn.
    test("speclibOrDiannRuns - true for a SpecLibGen/DIA-NN workflow") {
        function "speclibOrDiannRuns"
        when {
            function {
                """
                def props = new java.util.Properties()
                new File("${baseDir}/tests/fixtures/fragpipe_workflows/DIA_SpecLib_Quant.workflow").withReader { reader -> props.load(reader) }
                input[0] = props
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == true }
            )
        }
    }

    test("speclibOrDiannRuns - false for LFQ-MBR") {
        function "speclibOrDiannRuns"
        when {
            function {
                """
                def props = new java.util.Properties()
                new File("${baseDir}/tests/fixtures/fragpipe_workflows/LFQ-MBR.workflow").withReader { reader -> props.load(reader) }
                input[0] = props
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == false }
            )
        }
    }

    test("speclibOrDiannRuns - DIA-NN alone gives the single group") {
        function "speclibOrDiannRuns"
        when {
            function {
                """
                def props = new java.util.Properties()
                props.setProperty('speclibgen.run-speclibgen', 'false')
                props.setProperty('diann.run-dia-nn', 'true')
                input[0] = props
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == true }
            )
        }
    }

    test("generateFragpipeManifest - writes experiment, bioreplicate and data type per file") {
        function "generateFragpipeManifest"
        when {
            function {
                """
                input[0] = [['a.mzML', 'control', 1, 'DIA'], ['b.mzML', null, null, 'DDA+']]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == "a.mzML\tcontrol\t1\tDIA\nb.mzML\t\t\tDDA+" },
                { assert snapshot(function.result).match() }
            )
        }
    }

    // Tower (S3/Fusion): the published manifest keeps the path the user gave (S3Path.toString()
    // drops the scheme, so an S3 input is written as its URI); the manifest a task loads names the
    // staged files, because TabWorkflow.manifestLoad drops files that do not exist in the task.
    test("fragpipeManifestEntries - local path absolute, S3 path as its URI") {
        function "fragpipeManifestEntries"
        when {
            function {
                """
                input[0] = [
                    [[experiment: 'control', bioreplicate: 1, data_type: 'DDA'], file('/data/runs/a.raw')],
                    [[experiment: null, bioreplicate: null, data_type: 'DIA'], file('s3://bucket/runs/b.d')]
                ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == [['/data/runs/a.raw', 'control', 1, 'DDA'], ['s3://bucket/runs/b.d', '', null, 'DIA']] },
                { assert snapshot(function.result).match() }
            )
        }
    }

    test("fragpipeManifestEntries - staged_dir names the files as staged in the task") {
        function "fragpipeManifestEntries"
        when {
            function {
                """
                input[0] = [
                    [[experiment: 'control', bioreplicate: 1, data_type: 'DDA'], file('/data/runs/a.raw')],
                    [[experiment: null, bioreplicate: null, data_type: 'DIA'], file('s3://bucket/runs/b.d')]
                ]
                input[1] = 'spectra'
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == [['spectra/a.raw', 'control', 1, 'DDA'], ['spectra/b.d', '', null, 'DIA']] },
                { assert snapshot(function.result).match() }
            )
        }
    }

    // FragPipe data type per LC-MS file. A manifest type is normalised by the
    // InputLcmsFile constructor (InputLcmsFile.java:53-76); a blank type is guessed from the
    // absolute path by guessDataType() (InputLcmsFile.java:86-101).
    test("fragpipeDataType - explicit type kept, blank type guessed from the path like FragPipe") {
        function "fragpipeDataType"
        when {
            function {
                """
                input[0] = 'DIA-Quant'
                input[1] = file('/data/x_dda.mzML')
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'DIA-Quant' }
            )
        }
    }

    [
        ['/data/x_DIA.mzML', 'DIA'], ['/data/x_dda_DIA.mzML', 'DDA'], ['/data/x_WWA.raw', 'DDA+'],
        ['/data/DIA/plain.raw', 'DIA'], ['/data/plain.mzML', 'DDA'], ['/data/x_dia.mzML', 'DDA'],
        ['/data/x_Q2.mzML', 'DDA'], ['/data/x_diatracer.mzML', 'DDA'], ['/data/WWA_DIA.raw', 'DIA'],
        ['/data/DDA/x_DIA.mzML', 'DDA']
    ].each { path, expected ->
        test("fragpipeDataType - blank type for ${path} is guessed as ${expected} (InputLcmsFile.guessDataType)") {
            function "fragpipeDataType"
            when {
                function {
                    """
                    input[0] = null
                    input[1] = file('${path}')
                    """
                }
            }
            then {
                assertAll(
                    { assert function.success },
                    { assert function.result == expected }
                )
            }
        }
    }

    test("parseSamplesheet - data_type column carried in meta, blank guessed") {
        function "parseSamplesheet"
        when {
            function {
                """
                def fixtures = "${baseDir}/tests/fixtures"
                def ss = new File("${outputDir}/data_types.csv")
                ss.parentFile.mkdirs()
                ss.text = new File("\${fixtures}/samplesheets/data_types.csv").text.replace('\${FIXTURES}', fixtures)
                input[0] = ss.toString()
                input[1] = "${baseDir}/assets/schema_input.json"
                input[2] = false
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result.collect { row -> row[0].data_type } == ['DIA', 'DDA', 'DIA-Quant', 'GPF-DIA'] },
                { assert snapshot(function.result.collect { row -> [row[0], row[1].toString().tokenize('/')[-1]] }).match() }
            )
        }
    }

    test("parseSamplesheet - unknown data_type fails with FragPipe's data types") {
        function "parseSamplesheet"
        when {
            function {
                """
                def fixtures = "${baseDir}/tests/fixtures"
                def ss = new File("${outputDir}/data_type_invalid.csv")
                ss.parentFile.mkdirs()
                ss.text = new File("\${fixtures}/samplesheets/data_type_invalid.csv").text.replace('\${FIXTURES}', fixtures)
                input[0] = ss.toString()
                input[1] = "${baseDir}/assets/schema_input.json"
                input[2] = false
                """
            }
        }
        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains("data_type' (dia)") && ['DDA', 'DDA+', 'DIA', 'DIA-Quant', 'DIA-Lib', 'GPF-DIA'].every { t -> line.contains(t) } } : (function.stdout + function.stderr).join('\n') }
            )
        }
    }

    test("uniqueSpectraFiles - keeps the data type and fails when rows of one file disagree on it") {
        function "uniqueSpectraFiles"
        when {
            function {
                """
                def f = file('/data/plex1.mzML')
                input[0] = [
                    [[group: 'plex1', experiment: 'plex1', bioreplicate: null, fraction: 1, data_type: 'DDA', label: 'TMT126'], f],
                    [[group: 'plex1', experiment: 'plex1', bioreplicate: null, fraction: 1, data_type: 'DDA+', label: 'TMT127N'], f]
                ]
                """
            }
        }
        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains('disagree on experiment/bioreplicate/fraction/data_type') } }
            )
        }
    }

    // CmdMsfragger.java:541-552: DDA -> fragger.params, DIA and DIA-Lib -> fragger_dia.params,
    // GPF-DIA -> fragger_gpfdia.params, DDA+ -> fragger_dda_plus.params; anything else throws.
    [['DDA', 'DDA'], ['DIA', 'DIA'], ['DIA-Lib', 'DIA'], ['GPF-DIA', 'GPF-DIA'], ['DDA+', 'DDA+']].each { data_type, expected ->
        test("fraggerParamsType - ${data_type} files are searched with the ${expected} params") {
            function "fraggerParamsType"
            when {
                function {
                    """
                    input[0] = '${data_type}'
                    """
                }
            }
            then {
                assertAll(
                    { assert function.success },
                    { assert function.result == expected }
                )
            }
        }
    }

    test("fraggerParamsType - DIA-Quant is never searched") {
        function "fraggerParamsType"
        when {
            function {
                """
                input[0] = 'DIA-Quant'
                """
            }
        }
        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains('Unknown data type: DIA-Quant') } }
            )
        }
    }

    // CmdMSBooster.java:134-149: one fragger params file for the whole run.
    [
        ["['DIA', 'DDA+']", false, false, 'DIA'],
        ["['DIA', 'DDA+']", true, false, 'DDA'],
        ["['GPF-DIA', 'DDA+']", false, false, 'GPF-DIA'],
        ["['DDA+', 'DIA-Quant']", false, false, 'DDA+'],
        ["['DIA-Lib']", false, true, 'DDA'],
        ["['DDA', 'DIA']", false, false, 'DDA']
    ].each { types, umpire, diatracer, expected ->
        test("msboosterFraggerParamsType - ${types} umpire=${umpire} diatracer=${diatracer} gives ${expected}") {
            function "msboosterFraggerParamsType"
            when {
                function {
                    """
                    input[0] = ${types}
                    input[1] = ${umpire}
                    input[2] = ${diatracer}
                    """
                }
            }
            then {
                assertAll(
                    { assert function.success },
                    { assert function.result == expected }
                )
            }
        }
    }

    // FragpipeRun.java:1360-1366 and :1397-1402
    test("checkDiaPreprocessing - DIA-Umpire with timsTOF .d files fails like FragPipe") {
        function "checkDiaPreprocessing"
        when {
            function {
                """
                input[0] = [[[id: 'a', data_type: 'DDA'], file('/data/a.d')], [[id: 'b', data_type: 'DIA'], file('/data/b.mzML')]]
                input[1] = true
                input[2] = false
                """
            }
        }
        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains('DIA-Umpire is enabled but there are timsTOF (.d) files. Please double check the parameter settings.') } }
            )
        }
    }

    test("checkDiaPreprocessing - diaTracer with non-.d DIA files fails like FragPipe") {
        function "checkDiaPreprocessing"
        when {
            function {
                """
                input[0] = [[[id: 'a', data_type: 'DIA'], file('/data/a.d')], [[id: 'b', data_type: 'GPF-DIA'], file('/data/b.mzML')]]
                input[1] = false
                input[2] = true
                """
            }
        }
        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains('diaTracer is enabled but there are DIA files not in .d format. Please double check the parameter settings.') } }
            )
        }
    }

    test("checkDiaPreprocessing - accepts DDA mzML with diaTracer and DIA mzML with DIA-Umpire") {
        function "checkDiaPreprocessing"
        when {
            function {
                """
                input[0] = [[[id: 'a', data_type: 'DDA'], file('/data/a.mzML')], [[id: 'b', data_type: 'DIA'], file('/data/b.mzML')]]
                input[1] = true
                input[2] = false
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result.size() == 2 }
            )
        }
    }

    // CmdUmpireSe.java:73 / CmdDiaTracer.java:139: new InputLcmsFile(out, f.getGroup(), f.getReplicate(), "DDA")
    // -> the pseudo-spectra file's experiment is the source file's group.
    [
        ["[id: 'a', group: 'control_1', experiment: 'control', bioreplicate: 1, fraction: 1, data_type: 'DIA']", 'a_Q1', false, ['a_Q1', 'control_1', 1, 'control_1_1', 'DDA']],
        ["[id: 'a', group: '', experiment: null, bioreplicate: null, fraction: 1, data_type: 'GPF-DIA']", 'a_Q2', false, ['a_Q2', '', null, '', 'DDA']],
        ["[id: 'a', group: '', experiment: 'control', bioreplicate: 1, fraction: 1, data_type: 'DIA']", 'a_diatracer', true, ['a_diatracer', '', 1, '', 'DDA']]
    ].each { meta, id, single_group, expected ->
        test("ddaPseudoSpectraMeta - ${id} from ${meta} single_group=${single_group}") {
            function "ddaPseudoSpectraMeta"
            when {
                function {
                    """
                    input[0] = ${meta}
                    input[1] = '${id}'
                    input[2] = ${single_group}
                    """
                }
            }
            then {
                def m = function.result
                assertAll(
                    { assert function.success },
                    { assert [m.id, m.experiment, m.bioreplicate, m.group, m.data_type] == expected }
                )
            }
        }
    }

    test("uniqueSpectraFiles - fails when rows of one file disagree on the group") {
        function "uniqueSpectraFiles"
        when {
            function {
                """
                def f = file('/data/plex1.mzML')
                input[0] = [
                    [[group: 'plex1', experiment: 'plex1', bioreplicate: null, fraction: 1, label: 'TMT126'], f],
                    [[group: 'plex2', experiment: 'plex2', bioreplicate: null, fraction: 1, label: 'TMT127N'], f]
                ]
                """
            }
        }
        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains('disagree on experiment/bioreplicate/fraction') } }
            )
        }
    }

    test("tmtAnnotationLines - user annotation per group and FragPipe default for a group without labels") {
        function "tmtAnnotationLines"
        when {
            function {
                """
                def f1 = file('/data/plex1.mzML')
                def f2 = file('/data/plex2.mzML')
                def channels = ['TMT126', 'TMT127N', 'TMT128C', 'TMT129N', 'TMT130C', 'TMT131N']
                def rows = channels.withIndex().collect { label, i ->
                    [[group: 'plex1', label: label, sample: i == 5 ? 'NA' : "S\${i}".toString(), condition: i % 2 ? 'treated' : 'control'], f1]
                } + [[[group: '', label: null, sample: 'pool2', condition: 'pool2'], f2]]
                def spectra = [[[group: 'plex1'], f1], [[group: ''], f2]]
                def props = new java.util.Properties()
                props.setProperty('tmtintegrator.run-tmtintegrator', 'true')
                props.setProperty('tmtintegrator.channel_num', 'TMT-6')
                props.setProperty('tmtintegrator.add_Ref', '1')
                input[0] = rows
                input[1] = spectra
                input[2] = props
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result[0] == "plex\tchannel\tsample\tsample_name\tcondition\treplicate" },
                { assert function.result.drop(1).findAll { line -> line.startsWith('\t') }.collect { line -> line.split('\t')[3] } == ['_126', '_127N', '_128C', '_129N', '_130C', '_131N'] },
                { assert function.result.contains("plex1\t131N\tNA\tNA\ttreated\t1") },
                { assert snapshot(function.result).match() }
            )
        }
    }

    test("tmtAnnotationLines - empty when TMT-Integrator does not run") {
        function "tmtAnnotationLines"
        when {
            function {
                """
                def props = new java.util.Properties()
                props.setProperty('tmtintegrator.run-tmtintegrator', 'false')
                input[0] = [[[group: 'plex1', label: 'TMT126', sample: 'S1', condition: 'c'], file('/data/plex1.mzML')]]
                input[1] = [[[group: 'plex1'], file('/data/plex1.mzML')]]
                input[2] = props
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == [] }
            )
        }
    }

    test("tmtAnnotationLines - fails like FragPipe when a plex misses channels") {
        function "tmtAnnotationLines"
        when {
            function {
                """
                def f1 = file('/data/plex1.mzML')
                def props = new java.util.Properties()
                props.setProperty('tmtintegrator.run-tmtintegrator', 'true')
                props.setProperty('tmtintegrator.channel_num', 'TMT-6')
                props.setProperty('tmtintegrator.add_Ref', '1')
                input[0] = [[[group: 'plex1', label: 'TMT126', sample: 'S1', condition: 'c'], f1]]
                input[1] = [[[group: 'plex1'], f1]]
                input[2] = props
                """
            }
        }
        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains("Number of the samples in the annotation file does not match the number of channels in the 'label type' of the Quant (Isobaric) tab.") } }
            )
        }
    }

    test("tmtAnnotationLines - fails when two samples share one plex channel") {
        function "tmtAnnotationLines"
        when {
            function {
                """
                def f1 = file('/data/plex1.mzML')
                def f2 = file('/data/plex1_f2.mzML')
                def props = new java.util.Properties()
                props.setProperty('tmtintegrator.run-tmtintegrator', 'true')
                props.setProperty('tmtintegrator.channel_num', 'TMT-6')
                props.setProperty('tmtintegrator.add_Ref', '1')
                input[0] = [
                    [[group: 'plex1', label: 'TMT126', sample: 'S1', condition: 'c'], f1],
                    [[group: 'plex1', label: 'TMT126', sample: 'S2', condition: 'c'], f2]
                ]
                input[1] = [[[group: 'plex1'], f1], [[group: 'plex1'], f2]]
                input[2] = props
                """
            }
        }
        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains("channel 126 is assigned to more than one sample") } }
            )
        }
    }

    test("tmtAnnotationLines - fails like FragPipe on duplicate sample names across plexes") {
        function "tmtAnnotationLines"
        when {
            function {
                """
                def f1 = file('/data/plex1.mzML')
                def f2 = file('/data/plex2.mzML')
                def channels = ['TMT126', 'TMT127N', 'TMT128C', 'TMT129N', 'TMT130C', 'TMT131N']
                def rows = ['plex1': f1, 'plex2': f2].collectMany { plex, f ->
                    channels.withIndex().collect { label, i -> [[group: plex, label: label, sample: i == 0 ? 'Bridge' : "\${plex}_\${i}".toString(), condition: 'c'], f] }
                }
                def props = new java.util.Properties()
                props.setProperty('tmtintegrator.run-tmtintegrator', 'true')
                props.setProperty('tmtintegrator.channel_num', 'TMT-6')
                props.setProperty('tmtintegrator.add_Ref', '1')
                input[0] = rows
                input[1] = [[[group: 'plex1'], f1], [[group: 'plex2'], f2]]
                input[2] = props
                """
            }
        }
        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains("Duplicate samples found in annotation files. The sample names must be unique among all experiments.") } }
            )
        }
    }

