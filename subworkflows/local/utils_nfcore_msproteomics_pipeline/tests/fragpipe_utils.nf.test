            function {
                """
                input[0] = groovy.json.JsonOutput.toJson([fpop: [run: true], tmtintegrator_unmod: [run: false], ionquant: [run: false]])
                input[1] = ['DDA']
                """
            }
        }
        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains("Label-free FPOP Quant reads IonQuant's combined_modified_peptide.tsv") } }
            )
        }
    }

    test("checkFpopTools - FPOP.workflow settings pass on DDA data") {
        function "checkFpopTools"
        when {
            function {
                """
                input[0] = groovy.json.JsonOutput.toJson([fpop: [run: false], fpop_coadaptr: [run: true], ionquant: [run: true], diann: [run: false]])
                input[1] = ['DDA']
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert snapshot(function.result).match() }
            )
        }
    }

    // FragPipe edits DIA-NN's report.tsv with FPOP_DiannReport_Editor (CmdFPOPcoadaptr.java:429-433);
    // pipeline mode runs DIA-NN (FRAGPIPE_SPECLIB) and passes its report to FRAGPIPE_EXPORT
    test("checkFpopTools - FPOP coADAPTr with DIA-NN passes (DIA-NN runs in pipeline mode)") {
        function "checkFpopTools"
        when {
            function {
                """
                input[0] = groovy.json.JsonOutput.toJson([fpop_coadaptr: [run: true], diann: [run: true]])
                input[1] = ['DIA']
                """
            }
        }
        then {
            assertAll(
                { assert function.success }
            )
        }
    }

    test("matchedFragmentsManifest - FragPipe's work-dir manifest: sanitised experiment, bioreplicate, data type") {
        function "matchedFragmentsManifest"
        when {
            function {
                """
                input[0] = [
                    [[experiment: ' Ctrl-A 1 ', data_type: 'DDA'], file('/data/C02.mzML')],
                    [[experiment: ' Ctrl-A 1 ', data_type: 'DDA'], file('/data/C02.mzML')],
                    [[experiment: null, bioreplicate: 2, data_type: 'DIA'], file('/data/run1.raw')],
                    [[experiment: 'x', data_type: 'DDA'], file('/data/run2.raw')],
                    [[experiment: 'e', bioreplicate: 3, data_type: 'DDA+'], file('/data/b.d')]
                ]
                input[1] = ['run2_uncalibrated.mzML', 'b_uncalibrated.mzML']
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == '../spectra/C02.mzML\tCtrl_A_1\t\tDDA\n../spectra/b.d\te\t3\tDDA+\n../spectra/run1.mzML\t\t2\tDIA\n../spectra/run2.raw\tx\t\tDDA' },
                { assert snapshot(function.result).match() }
            )
        }
    }

    // CmdCrystalc.java:176-185: one params-file index over the whole run, LC-MS files in InputLcmsFile
    // order (group2, data type, path), then each file's pepXMLs by rank
    test("crystalcRunIndex - index counts over the run in FragPipe's LC-MS order, then by rank") {
        function "crystalcRunIndex"
        when {
            function {
                """
                input[0] = [
                    [[id: 'B', experiment: 'b', bioreplicate: null, data_type: 'DDA', spectra_name: 'A.mzML'], 'B.pepXML', 'A.mzML', 0],
                    [[id: 'A', experiment: 'a', bioreplicate: null, data_type: 'DIA', spectra_name: 'Z.mzML'], 'Z_rank2.pepXML', 'Z.mzML', 1],
                    [[id: 'A', experiment: 'a', bioreplicate: null, data_type: 'DIA', spectra_name: 'Z.mzML'], 'Z_rank1.pepXML', 'Z.mzML', 0]
                ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result.collect { item -> [item[0].id, item[1], item[0].crystalc_index] } == [['A', 'Z_rank1.pepXML', 0], ['A', 'Z_rank2.pepXML', 1], ['B', 'B.pepXML', 2]] },
                { assert snapshot(function.result).match() }
            )
        }
    }
    // CmdMsfragger.java:612-630 and CmdPercolator.java:185-201: <stem>_percolator.weights below a _sub.mzML input's dir
    test("subMzmlWeights - second-pass weights found below the input's directory") {
        function "subMzmlWeights"
        when {
            function {
                """
                def d = java.nio.file.Files.createTempDirectory('submzml')
                java.nio.file.Files.createDirectories(d.resolve('grp'))
                ['a_sub.mzML', 'b.mzML', 'q_sub.mzML', 'grp/a_percolator.weights', 'grp/b_percolator.weights'].each { n -> d.resolve(n).text = 'x' }
                input[0] = [
                    [[ id: 'a', data_type: 'DDA' ], d.resolve('a_sub.mzML')],
                    [[ id: 'b', data_type: 'DDA' ], d.resolve('b.mzML')],
                    [[ id: 'q', data_type: 'DIA-Quant' ], d.resolve('q_sub.mzML')]
                ]
                """
            }
        }
        then {
            def r = function.result
            assertAll(
                { assert function.success },
                { assert r[0][0].sub_mzml_weights.size() == 1 && r[0][0].sub_mzml_weights[0].toString().endsWith('/grp/a_percolator.weights') },
                // one command per data-type params set: every DDA file gets the flag (CmdMsfragger.java:539-630)
                { assert r[0][0].no_ptm_score_in_pin == true && r[1][0].no_ptm_score_in_pin == true },
                { assert !r[1][0].containsKey('sub_mzml_weights') },
                // DIA-Quant files are not searched; q has no weights
                { assert r[2][0] == [ id: 'q', data_type: 'DIA-Quant' ] }
            )
        }
    }

    test("subMzmlWeights - first-pass inputs are unchanged") {
        function "subMzmlWeights"
        when {
            function {
                """
                def d = java.nio.file.Files.createTempDirectory('submzml')
                d.resolve('a.mzML').text = 'x'
                d.resolve('a_percolator.weights').text = 'x'
                input[0] = [ [[ id: 'a', data_type: 'DDA' ], d.resolve('a.mzML')] ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result[0][0] == [ id: 'a', data_type: 'DDA' ] }
            )
        }
    }

    // CmdPercolator.java:192-193: more than one match stops the run
    test("percolatorInitWeights - two weights files fail like FragPipe") {
        function "percolatorInitWeights"
        when {
            function {
                """
                input[0] = [ id: 'a', sub_mzml_weights: ['/x/a_percolator.weights', '/y/a_percolator.weights'] ]
                """
            }
        }
        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { l -> l.contains('Found more than one weights file: /x/a_percolator.weights, /y/a_percolator.weights') } }
            )
        }
    }

    test("percolatorInitWeights - none without weights") {
        function "percolatorInitWeights"
        when {
            function {
                """
                input[0] = [ id: 'a' ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == [] }
            )
        }
    }
    // The published layout of a Write sub mzML run (conf/modules.config): fragpipe/<stem>_sub.mzML and
    // fragpipe/<group>/<stem>_percolator.weights; a second run on the _sub.mzML files finds each weights file once
    test("subMzmlWeights - finds the weights in the published fragpipe/ layout") {
        function "subMzmlWeights"
        when {
            function {
                """
                def out = java.nio.file.Files.createTempDirectory('outdir').resolve('fragpipe')
                ['control_1', 'treated_1'].each { g -> java.nio.file.Files.createDirectories(out.resolve(g)) }
                ['ctrl_1_sub.mzML', 'trt_1_sub.mzML', 'fragpipe-files-second-pass.fp-manifest', 'fragpipe-second-pass.workflow',
                 'control_1/ctrl_1_percolator.weights', 'treated_1/trt_1_percolator.weights'].each { n -> out.resolve(n).text = 'x' }
                input[0] = [
                    [[ id: 'ctrl_1_sub', data_type: 'DDA' ], out.resolve('ctrl_1_sub.mzML')],
                    [[ id: 'trt_1_sub', data_type: 'DDA' ], out.resolve('trt_1_sub.mzML')]
                ]
                """
            }
        }
        then {
            def r = function.result
            assertAll(
                { assert function.success },
                { assert r[0][0].sub_mzml_weights.size() == 1 && r[0][0].sub_mzml_weights[0].toString().endsWith('/fragpipe/control_1/ctrl_1_percolator.weights') },
                { assert r[1][0].sub_mzml_weights.size() == 1 && r[1][0].sub_mzml_weights[0].toString().endsWith('/fragpipe/treated_1/trt_1_percolator.weights') },
                { assert r.every { item -> item[0].no_ptm_score_in_pin == true } }
            )
        }
    }
    // pmultiqc 0.0.48 fragpipe_io.py:50-124: an IonQuant work dir gives its root tables (the blank group's psm.tsv,
    // combined_*.tsv) and its group directories, never the root's other *.tsv (a Percolator *_psms.tsv would
    // match the plugin's "psm" rule)
    test("pmultiqcFragpipeInputs - IonQuant work dir: root tables by name, then group directories") {
        function "pmultiqcFragpipeInputs"
        when {
            function {
                """
                def wd = java.nio.file.Files.createTempDirectory('pmultiqc').resolve('fragpipe')
                ['treated', 'control', 'tmt-report'].each { g -> java.nio.file.Files.createDirectories(wd.resolve(g)) }
                ['psm.tsv', 'ion.tsv', 'combined_protein.tsv', 'combined_peptide.tsv', 'combined_ion.tsv',
                 'combined_modified_peptide.tsv', 'reprint.spc.tsv', 'a_percolator_target_psms.tsv',
                 'control/psm.tsv', 'control/ion.tsv', 'treated/psm.tsv', 'tmt-report/abundance_protein_MD.tsv'].each { n -> wd.resolve(n).text = 'x' }
                def saved = java.nio.file.Files.createTempDirectory('saved')
                ['fragpipe.workflow', 'fragpipe-files.fp-manifest'].each { n -> saved.resolve(n).text = 'x' }
                input[0] = wd
                input[1] = [saved.resolve('fragpipe.workflow'), saved.resolve('fragpipe-files.fp-manifest')]
                input[2] = []
                """
            }
        }
        then {
            def names = function.result.collect { f -> f.toString().tokenize("/")[-1] }
            assertAll(
                { assert function.success },
                { assert names == ['combined_ion.tsv', 'combined_peptide.tsv', 'combined_protein.tsv', 'fragpipe-files.fp-manifest',
                                   'fragpipe.workflow', 'ion.tsv', 'psm.tsv', 'control', 'treated'] },
                { assert function.result[-2].toString().endsWith('/fragpipe/control') },
                { assert snapshot(names).match() }
            )
        }
    }

    // Without IonQuant: each group's final Report directory, plus fragpipe.workflow and the manifest
    test("pmultiqcFragpipeInputs - Report group directories without a work dir") {
        function "pmultiqcFragpipeInputs"
        when {
            function {
                """
                def base = java.nio.file.Files.createTempDirectory('report')
                ['grp_b', 'grp_a'].each { g -> java.nio.file.Files.createDirectories(base.resolve(g)); base.resolve("\${g}/psm.tsv").text = 'x' }
                base.resolve('fragpipe.workflow').text = 'x'
                base.resolve('fragpipe-files.fp-manifest').text = 'x'
                input[0] = null
                input[1] = [base.resolve('fragpipe.workflow'), base.resolve('fragpipe-files.fp-manifest')]
                input[2] = [base.resolve('grp_b'), base.resolve('grp_a'), base.resolve('grp_a')]
                """
            }
        }
        then {
            def names = function.result.collect { f -> f.toString().tokenize("/")[-1] }
            assertAll(
                { assert function.success },
                { assert names == ['fragpipe-files.fp-manifest', 'fragpipe.workflow', 'grp_a', 'grp_b'] },
                { assert snapshot(names).match() }
            )
        }
    }
}
