                """
                input[0] = [
                    [[id: 'dia_b_Q2', group: 'b', data_type: 'DDA'], 'b_q2.log'],
                    [[id: 'tims_diatracer', group: 'a', data_type: 'DDA'], 'tims.log'],
                    [[id: 'dia_b_Q1', group: 'b', data_type: 'DDA'], 'b_q1.log'],
                    [[id: 'dia_a_Q3', group: 'a', data_type: 'DDA'], 'a_q3.log'],
                    [[id: 'dia_a_Q1', group: 'a', data_type: 'DDA'], 'a_q1.log'],
                    [[id: 'dda_b', group: 'b', data_type: 'DDA'], 'dda_b.log']
                ]
                input[1] = [
                    [[id: 'dda_b', group: 'b'], file('/r/dda_b.mzML')],
                    [[id: 'dia_b', group: 'b'], file('/r/dia_b.mzML')],
                    [[id: 'tims', group: 'a'], file('/r/tims.d')],
                    [[id: 'dia_a', group: 'a'], file('/r/dia_a.raw')]
                ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == ['tims.log', 'a_q1.log', 'a_q3.log', 'dda_b.log', 'b_q1.log', 'b_q2.log'] }
            )
        }
    }

