    // cptac-DIA-Umpire: MSFragger searches the DIA-Umpire Q1-Q3 files (DDA), which replace their DIA file in
    // FragPipe's LC-MS list (CmdUmpireSe.java:64-75); diaTracer's _diatracer.mzML replaces its .d (CmdDiaTracer.java:138-139)
    test("msfraggerConsoleLogs - DIA-Umpire and diaTracer outputs take their source file's place") {
        function "msfraggerConsoleLogs"
        when {
