            )
        }
    }

    // CmdWriteSubMzml.java:82-130 argv; class path a HashSet of the batmass-io jar and <install>/lib/* (:93-95)
    test("writeSubMzmlArgv - named group, FragPipe argv order") {
        function "writeSubMzmlArgv"
        when {
            function {
                """
                def tools = [batmass_io_jar: '/fp/fragpipe-24.0/tools/batmass-io-1.36.6.jar', fragpipe_lib: '/fp/fragpipe-24.0/lib',
                             bruker_dir: '/fp/fragpipe-24.0/tools/MSFragger-4.4.1/ext/bruker', thermo_dir: '/fp/fragpipe-24.0/tools/MSFragger-4.4.1/ext/thermo']
                input[0] = 'A01.mzML'
                input[1] = 'lcms'
                input[2] = [group: 'A01']
                input[3] = '0.5'
                input[4] = 8
                input[5] = tools
                """
            }
        }
        then {
            def r = function.result
            assertAll(
                { assert function.success },
                // the task orders the class path as FragPipe's HashSet (hashSetClassPathLines), insertion order:
                { assert r.classpath_words == ['/fp/fragpipe-24.0/tools/batmass-io-1.36.6.jar', '/fp/fragpipe-24.0/lib/*'] },
                { assert r.argv == ['java', '-Duser.home={TASK_DIR}', '-Xmx8G',
                                    '-Dlibs.bruker.dir=/fp/fragpipe-24.0/tools/MSFragger-4.4.1/ext/bruker',
                                    '-Dlibs.thermo.dir=/fp/fragpipe-24.0/tools/MSFragger-4.4.1/ext/thermo',
                                    '-cp', '{FRAGPIPE_HASHSET_CP}', 'org.nesvilab.fragpipe.util.WriteSubMzml',
                                    '{TASK_DIR}/lcms/A01.mzML', '{TASK_DIR}/A01/psm.tsv', '{TASK_DIR}/A01_sub.mzML', '0.5', '1'] },
                { assert r.group_dir == 'A01' },
                { assert r.psm == 'A01/psm.tsv' },
                { assert r.sub_mzml == 'A01_sub.mzML' },
                { assert snapshot(r).match() }
            )
        }
    }

    // CmdWriteSubMzml.java:93-95 joins a java.util.HashSet: the shell order must be the JVM's for any paths
    test("hashSetClassPathLines - same order as java.util.HashSet") {
        function "hashSetClassPathLines"
        when {
            function {
                """
                input[0] = ['/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/tools/batmass-io-1.36.5.jar', '/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/lib/*']
                """
            }
        }
        then {
            def order = { List words ->
                def lines = function.result.readLines()
                def script = [lines[0], "FP_CP_WORDS=(${words.collect { w -> "'${w}'" }.join(' ')})", lines[2], 'printf "%s" "$FRAGPIPE_HASHSET_CP"'].join('\n')
                def proc = new ProcessBuilder('bash', '-euo', 'pipefail', '-c', script).redirectErrorStream(true).start()
                def out = proc.inputStream.text
                proc.waitFor()
                out
            }
            def expected = { List words -> def set = new java.util.HashSet<String>(); words.each { w -> set.add(w) }; set.join(':') }
            def cases = ['/fragpipe_bin/fragpipe-24.0/fragpipe-24.0', '/fp/fragpipe-24.0', '/opt/fragpipe-24.0', '/x'].collectMany { root ->
                ['1.36.5', '1.36.6'].collect { v -> ["${root}/tools/batmass-io-${v}.jar".toString(), "${root}/lib/*".toString()] }
            }
            assertAll(
                { assert function.success },
                { assert function.result.contains('FP_CP_WORDS=("/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/tools/batmass-io-1.36.5.jar" "/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/lib/*")') },
                { assert cases.collect { c -> order(c) } == cases.collect { c -> expected(c) } }
            )
        }
    }

    // Blank group: cwd and psm.tsv are the work dir (wd.resolve("")); the threshold prints as a float ("" + 1.0f)
    test("writeSubMzmlArgv - blank group and float threshold") {
        function "writeSubMzmlArgv"
        when {
            function {
                """
                input[0] = 'run.raw'
                input[1] = 'lcms'
                input[2] = [group: '']
                input[3] = '1'
                input[4] = 4
                input[5] = [batmass_io_jar: '/t/batmass-io-1.36.6.jar', fragpipe_lib: '/l', bruker_dir: '/b', thermo_dir: '/th']
                """
            }
        }
        then {
            def r = function.result
            assertAll(
                { assert function.success },
                { assert r.argv[-5..-1] == ['{TASK_DIR}/lcms/run.raw', '{TASK_DIR}/psm.tsv', '{TASK_DIR}/run_sub.mzML', '1.0', '1'] },
                { assert r.group_dir == '.' },
                { assert r.psm == 'psm.tsv' }
            )
        }
    }
}
