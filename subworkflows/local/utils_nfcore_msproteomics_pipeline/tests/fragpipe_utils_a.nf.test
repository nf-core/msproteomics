    // ccRCC-DIA-SpecLib FragPipe 24.0 run: PINs added in LC-MS order (NAT_1..NAT_5, T_1..T_5);
    // 01882_NAT and 00606_T share a bucket, so the line depends on that order
    test("msboosterParamsText - PINs in LC-MS order give FragPipe's pinPepXMLDirectory line") {
        function "msboosterParamsText"
        when {
            function {
                """
                def p = 'CPTAC_CCRCC_W_JHU_20190112_LUMOS_'
                input[0] = 'numThreads = 1\\nuseIM = false\\nfindBestImModel = false\\n'
                input[1] = false
                input[2] = 1
                input[3] = [diann: 'd', unimod_obo: 'u']
                input[4] = 'f.params'
                input[5] = ['C3L-00418_NAT', 'C3L-00606_NAT', 'C3L-01882_NAT', 'C3N-00577_NAT', 'C3N-00733_NAT',
                    'C3L-00418_T', 'C3L-00606_T', 'C3L-01882_T', 'C3N-00577_T', 'C3N-00733_T'].collect { s -> p + s + '.pin' }
                input[6] = []
                """
            }
        }
        then {
            def p = 'CPTAC_CCRCC_W_JHU_20190112_LUMOS_'
            def expected = 'pinPepXMLDirectory = ' + ['C3L-00418_NAT', 'C3L-00418_T', 'C3N-00577_T', 'C3L-00606_NAT', 'C3L-01882_T',
                'C3N-00733_T', 'C3L-01882_NAT', 'C3L-00606_T', 'C3N-00577_NAT', 'C3N-00733_NAT'].collect { s -> p + s + '.pin' }.join(' ')
            assertAll(
                { assert function.success },
                { assert function.result.readLines().last() == expected }
            )
        }
    }

    // FragPipe's set is filled by add() (16 buckets up to 12 entries); new HashSet(Collection) has 32 for 12 on JDK 17
    test("msboosterParamsText - 12 PINs iterate as an add()-filled HashSet") {
        function "msboosterParamsText"
        when {
            function {
                """
                input[0] = 'numThreads = 1\\nuseIM = false\\nfindBestImModel = false\\n'
                input[1] = false
                input[2] = 1
                input[3] = [diann: 'd', unimod_obo: 'u']
                input[4] = 'f.params'
                input[5] = (12..1).collect { i -> String.format('run%02d.pin', i) }
                input[6] = []
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result.readLines().last() == 'pinPepXMLDirectory = run06.pin run01.pin run11.pin run02.pin run12.pin run10.pin run09.pin run04.pin run03.pin run05.pin run08.pin run07.pin' }
            )
        }
    }

