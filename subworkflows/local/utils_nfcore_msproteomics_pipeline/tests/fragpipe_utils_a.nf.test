                input[0] = ['raw_files/A1.mzML', 'raw_files/XA1.mzML']
                input[1] = [['XA1.mzML', 'x', 1, 'DDA', 'x_1'], ['A1.mzML', 'a', 1, 'DDA', 'a_1']]
                input[2] = []
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == true }
            )
        }
    }

