                dir.mkdirs()
                def small = file("\${dir}/small.mzML"); small.text = 'x'
                def tie1 = file("\${dir}/tie1.mzML"); tie1.text = 'xxx'
                def tie2 = file("\${dir}/tie2.mzML"); tie2.text = 'yyy'
                def d = file("\${dir}/run.d"); d.mkdirs()
                file("\${d}/a.tdf").text = 'xx'; file("\${d}/b.tdf_bin").text = 'xxx'
                input[0] = [small, tie1, d, tie2]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result.collect { f -> new File(f.toString()).name } == ['run.d', 'tie1.mzML', 'tie2.mzML', 'small.mzML'] }
            )
        }
    }

