// Unit tests for fragpipe_utils_a.nf: FragPipe 24.0 tool paths (golden FragPipe argv), in-place params
// values (Props.java:240-273 layout) and the here-document body the modules write files with.

nextflow_function {

    name "Test Functions fragpipe_utils_a"
    script "../fragpipe_utils_a.nf"

    tag "subworkflows"
    tag "fragpipe_utils"
    tag "stub"

    // Paths as the golden FragPipe 24.0 argv ({FRAGPIPE} = /fp/fragpipe-24.0)
    test("fragpipeTools - FragPipe 24.0 names under the tools directory") {
        function "fragpipeTools"
        when {
            function {
                """
                input[0] = [ext: [fragpipe_tools_dir: '/fp/fragpipe-24.0/tools/']]
                """
            }
        }
        then {
            def t = function.result
            assertAll(
                { assert function.success },
                { assert t.fragpipe_version == '24.0' },
                { assert t.fragpipe_jar == '/fp/fragpipe-24.0/lib/fragpipe-24.0.jar' },
                { assert t.license == '/fp/fragpipe-24.0/license.dat' },
                // FragPipe writes getDirTools() into argv unnormalised (FragpipeLocations.java:105)
                { assert t.argv_tools_dir == '/fp/fragpipe-24.0/lib/../tools' },
                // the distribution-named jars are found in the task (fragpipeJarLines)
                { assert t.msfragger_jar == '{MSFRAGGER_JAR}' },
                { assert t.thermo_dir == '{MSFRAGGER_DIR}/ext/thermo' },
                { assert t.batmass_io_jar == '{BATMASS_IO_JAR}' },
                { assert t.msbooster_jar == '{MSBOOSTER_JAR}' },
                { assert snapshot(function.result).match() }
            )
        }
    }

    test("fragpipeTools - a relative or missing tools directory fails") {
        function "fragpipeTools"
        when {
            function {
                """
                input[0] = [ext: [fragpipe_tools_dir: null]]
                """
            }
        }
        then {
            assert function.failed
        }
    }

    // The jar tokens become the task's shell variables in double-quoted words
    test("shellArgs - jar tokens become shell variables") {
        function "shellArgs"
        when {
            function {
                """
                input[0] = ['{MSFRAGGER_JAR}', '-Dlibs.thermo.dir={MSFRAGGER_DIR}/ext/thermo', '{IONQUANT_JAR}:{DIATRACER_JAR}']
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == '"${MSFRAGGER_JAR}" "-Dlibs.thermo.dir=${MSFRAGGER_DIR}/ext/thermo" "${IONQUANT_JAR}:${DIATRACER_JAR}"' }
            )
        }
    }

    // FragPipe's lookup (TabConfig.java:176-178, :188-209): <tool>-<version>.jar anywhere under the tools folder,
    // case-insensitive, highest version; the academic and the FragPipePlus names both resolve
    test("fragpipeJarLines - finds academic and edition-named jar names, highest version, MSFragger dir") {
        function "fragpipeJarLines"
        when {
            function {
                """
                input[0] = [tools_dir: '/fp/fragpipe-24.0/tools']
                input[1] = ['msfragger', 'ionquant', 'diatracer']
                """
            }
        }
        then {
            def run = { String layout ->
                def tmp = java.nio.file.Files.createTempDirectory('fpjars').toFile()
                def tools = new File(tmp, 'fragpipe-24.0/tools')
                layout.split(' ').each { rel -> def f = new File(tools, rel); f.parentFile.mkdirs(); f.text = '' }
                def script = function.result.replace('/fp/fragpipe-24.0/tools', tools.path) +
                    '\nprintf "%s|%s|%s|%s|%s\\n" "${MSFRAGGER_JAR#' + tools.path + '/}" "${MSFRAGGER_DIR#' + tools.path + '/}" "${IONQUANT_JAR#' + tools.path + '/}" "${DIATRACER_JAR#' + tools.path + '/}" "$(cat .msfragger_version)"\n'
                def proc = new ProcessBuilder('bash', '-euo', 'pipefail', '-c', script).directory(tmp).redirectErrorStream(true).start()
                def out = proc.inputStream.text.trim()
                [proc.waitFor(), out]
            }
            assertAll(
                { assert function.success },
                { assert run('MSFragger-4.4.1/MSFragger-4.4.1.jar IonQuant-1.11.20.jar diaTracer-2.2.1.jar') ==
                    [0, 'MSFragger-4.4.1/MSFragger-4.4.1.jar|MSFragger-4.4.1|IonQuant-1.11.20.jar|diaTracer-2.2.1.jar|4.4.1'] },
                // a distribution-specific name (FragPipePlus adds an edition word before the version)
                { assert run('MSFragger-4.4.1/MSFragger-Plus-4.4.1.jar IonQuant-Plus-1.11.20.jar diaTracer-Plus-2.2.1.jar') ==
                    [0, 'MSFragger-4.4.1/MSFragger-Plus-4.4.1.jar|MSFragger-4.4.1|IonQuant-Plus-1.11.20.jar|diaTracer-Plus-2.2.1.jar|4.4.1'] },
                { assert run('MSFragger-4.3/MSFragger-4.3.jar MSFragger-4.4.1/msfragger-4.4.1.jar IonQuant-1.11.20.jar diaTracer-2.2.1.jar')[1].startsWith('MSFragger-4.4.1/msfragger-4.4.1.jar|MSFragger-4.4.1|') }
            )
        }
    }

    // batmass-io and MSBooster: the names the FragPipe build compiled in (ToolingUtils.BATMASS_IO_JAR,
    // CmdMSBooster.JAR_MSBOOSTER_NAME), read from lib/fragpipe-<version>.jar, not the highest jar in tools/
    test("fragpipeJarLines - batmass-io and MSBooster are the jars the FragPipe build names") {
        function "fragpipeJarLines"
        when {
            function {
                """
                input[0] = [tools_dir: '/fp/fragpipe-24.0/tools', fragpipe_jar: '/fp/fragpipe-24.0/lib/fragpipe-24.0.jar']
                input[1] = ['batmass_io', 'msbooster']
                """
            }
        }
        then {
            def tmp = java.nio.file.Files.createTempDirectory('fpjars').toFile()
            def root = new File(tmp, 'fragpipe-24.0')
            ['tools/batmass-io-1.36.5.jar', 'tools/batmass-io-1.36.6.jar', 'tools/MSBooster-1.4.14.jar', 'tools/MSBooster-1.4.17.jar'].each { rel ->
                def f = new File(root, rel); f.parentFile.mkdirs(); f.text = ''
            }
            def jar = new File(root, 'lib/fragpipe-24.0.jar')
            jar.parentFile.mkdirs()
            new java.util.zip.ZipOutputStream(new FileOutputStream(jar)).withCloseable { z ->
                [['org/nesvilab/fragpipe/cmd/ToolingUtils.class', '\u0001\u0000\u0015batmass-io-1.36.5.jar\u0001'],
                 ['org/nesvilab/fragpipe/cmd/CmdMSBooster.class', '\u0001\u0000\u0014MSBooster-1.4.14.jar\u0001']].each { e ->
                    z.putNextEntry(new java.util.zip.ZipEntry(e[0])); z.write(e[1].getBytes('ISO-8859-1')); z.closeEntry()
                }
            }
            def script = function.result.replace('/fp/fragpipe-24.0', root.path) +
                '\nprintf "%s|%s|%s" "${BATMASS_IO_JAR#' + root.path + '/}" "${MSBOOSTER_JAR#' + root.path + '/}" "$(cat .msbooster_version)"'
            def proc = new ProcessBuilder('bash', '-euo', 'pipefail', '-c', script).directory(tmp).redirectErrorStream(true).start()
            def out = proc.inputStream.text
            assertAll(
                { assert function.success },
                { assert proc.waitFor() == 0 : out },
                { assert out == 'tools/batmass-io-1.36.5.jar|tools/MSBooster-1.4.14.jar|1.4.14' }
            )
        }
    }

    test("fragpipeJarLines - a required jar that is missing stops the task, an optional one is left empty") {
        // bash -euo pipefail as the tasks run (nextflow.config process.shell): a missing tools folder still reaches the error
        function "fragpipeJarLines"
        when {
            function {
                """
                input[0] = [tools_dir: '/fp/fragpipe-24.0/tools']
                input[1] = ['ionquant']
                input[2] = ['msfragger']
                """
            }
        }
        then {
            def tmp = java.nio.file.Files.createTempDirectory('fpjars').toFile()
            def tools = new File(tmp, 'fragpipe-24.0/tools')
            tools.mkdirs()
            def script = function.result.replace('/fp/fragpipe-24.0/tools', tools.path)
            def proc = new ProcessBuilder('bash', '-euo', 'pipefail', '-c', script).directory(tmp).redirectErrorStream(true).start()
            def out = proc.inputStream.text
            def code = proc.waitFor()
            def optional = new ProcessBuilder('bash', '-euo', 'pipefail', '-c', script.readLines().findAll { l -> !l.contains('IONQUANT') }.join('\n') + '\nprintf "[%s][%s]" "$MSFRAGGER_JAR" "$MSFRAGGER_DIR"').directory(tmp).redirectErrorStream(true).start()
            assertAll(
                { assert function.success },
                { assert code == 1 },
                { assert out.contains("ERROR: no IonQuant-*.jar under ${tools.path}") : out },
                { assert optional.inputStream.text == '[][]' },
                { assert optional.waitFor() == 0 }
            )
        }
    }

    test("fragpipeTools - a tools directory without fragpipe-<version> fails") {
        function "fragpipeTools"
        when {
            function {
                """
                input[0] = [ext: [fragpipe_tools_dir: '/opt/fragpipe/tools']]
                """
            }
        }
        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains('names no fragpipe-<version> directory') } }
            )
        }
    }

    test("setFragpipeParamValues - values replaced in place, tab comments kept") {
        function "setFragpipeParamValues"
        when {
            function {
                """
                input[0] = 'database_name = /old/db.fasta\\t\\t\\t# FASTA\\nnum_threads = 0\\nnum_threads_x = 3\\t# other key\\ncalibrate_mass = 2\\t\\t# keep\\n'
                input[1] = [database_name: '{TASK_DIR}/db.fasta', num_threads: 8]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'database_name = {TASK_DIR}/db.fasta\t\t\t# FASTA\nnum_threads = 8\nnum_threads_x = 3\t# other key\ncalibrate_mass = 2\t\t# keep\n' }
            )
        }
    }

    test("setFragpipeParamValues - text without a final newline gets one") {
        function "setFragpipeParamValues"
        when {
            function {
                """
                input[0] = 'a = 1\\nb = 2'
                input[1] = [b: 3]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'a = 1\nb = 3\n' }
            )
        }
    }

    // Behaviour check: bash writes the original text back, with {TASK_DIR} as the shell's PWD
    test("heredocText - bash here-document reproduces the text, {TASK_DIR} becomes PWD") {
        function "heredocText"
        when {
            function {
                """
                input[0] = 'fasta = {TASK_DIR}/db.fasta\\tx\\nre = ^a\\\\d\$HOME `x` \\\\\$\\n'
                """
            }
        }
        then {
            def dir = new File(System.getProperty('java.io.tmpdir')).canonicalPath
            def proc = ['bash', '-c', "cd '${dir}' && cat <<FP_EOF\n${function.result}\nFP_EOF"].execute()
            def out = new StringBuffer(); def err = new StringBuffer()
            proc.waitForProcessOutput(out, err)
            assertAll(
                { assert function.success },
                { assert proc.exitValue() == 0 : err.toString() },
                { assert out.toString() == "fasta = ${dir}/db.fasta\tx\nre = ^a\\d\$HOME `x` \\\$\n".toString() }
            )
        }
    }

    // CmdCrystalc.java:190-196 runtime keys; extension case kept (StringUtils.afterLastDot)
    test("crystalcRuntimeParams - runtime keys after an empty line") {
        function "crystalcRuntimeParams"
        when {
            function {
                """
                input[0] = 32
                input[1] = 'db.fasta'
                input[2] = 'EXP_A01.mzML'
                input[3] = 'A01'
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == '\nthread = 32\nfasta = {TASK_DIR}/db.fasta\nraw_file_location = {TASK_DIR}\nraw_file_extension = mzML\noutput_location = {TASK_DIR}/A01\n' }
            )
        }
    }

    test("rawSymlinksToFiles - only .raw files (any case) are copied over their links") {
        function "rawSymlinksToFiles"
        when {
            function {
                """
                input[0] = ['a.RAW', 'b.mzML', 'c.raw']
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == "[ ! -L 'a.RAW' ] || cp --remove-destination \"\$(readlink -f 'a.RAW')\" 'a.RAW'\n[ ! -L 'c.raw' ] || cp --remove-destination \"\$(readlink -f 'c.raw')\" 'c.raw'" }
            )
        }
    }

    test("rawSymlinksToFiles - no .raw file gives no line") {
        function "rawSymlinksToFiles"
        when {
            function {
                """
                input[0] = 'run.mzML'
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == '' }
            )
        }
    }

    // TabWorkflow.java:1241-1250: path, experiment, bioreplicate, data type; null cells empty; no final newline
    test("fragpipeManifestText - manifest lines under the spectra directory") {
        function "fragpipeManifestText"
        when {
            function {
                """
                input[0] = [ ['run_A.mzML', 'cancer', null, 'DDA'], ['run_B.mzML', 'saliva', 1, 'DDA'] ]
                input[1] = '{TASK_DIR}/spectra'
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == '{TASK_DIR}/spectra/run_A.mzML\tcancer\t\tDDA\n{TASK_DIR}/spectra/run_B.mzML\tsaliva\t1\tDDA' }
            )
        }
    }

    test("fillArgvTokens - every token in every word") {
        function "fillArgvTokens"
        when {
            function {
                """
                input[0] = ['--psm', '@PSM@', '--threads', '@THREADS@', '@TOOLS_DIR@/x:@TOOLS_DIR@/y']
                input[1] = ['@PSM@': '{TASK_DIR}/g/psm.tsv', '@THREADS@': 4, '@TOOLS_DIR@': '/t']
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == ['--psm', '{TASK_DIR}/g/psm.tsv', '--threads', '4', '/t/x:/t/y'] }
            )
        }
    }

    // Behaviour checks through bash: the file holds the text byte for byte, the words arrive unchanged
    test("writeTextFile and shellArgs - bash writes the exact text and words") {
        function "writeTextFile"
        when {
            function {
                """
                input[0] = 'm.txt'
                input[1] = 'a\\t\$x `y` \\\\\\n{TASK_DIR}/z'
                """
            }
        }
        then {
            def dir = new File(System.getProperty('java.io.tmpdir'), "wtf_${System.nanoTime()}")
            dir.mkdirs()
            def canon = dir.canonicalPath
            def proc = ['bash', '-c', "cd '${canon}' && ${function.result}"].execute()
            proc.waitForProcessOutput(System.out, System.err)
            assertAll(
                { assert function.success },
                { assert proc.exitValue() == 0 },
                { assert new File(dir, 'm.txt').text == "a\t\$x `y` \\\n${canon}/z".toString() }
            )
        }
    }

    test("shellArgs - words with quotes, dollars and spaces survive bash") {
        function "shellArgs"
        when {
            function {
                """
                input[0] = ['a b', 'q"\$HOME`x`\\\\', '{TASK_DIR}/f']
                """
            }
        }
        then {
            def dir = new File(System.getProperty('java.io.tmpdir')).canonicalPath
            def proc = ['bash', '-c', "cd '${dir}' && printf '%s\\n' ${function.result}"].execute()
            def out = new StringBuffer(); proc.waitForProcessOutput(out, System.err)
            assertAll(
                { assert function.success },
                { assert out.toString() == "a b\nq\"\$HOME`x`\\\n${dir}/f\n".toString() }
            )
        }
    }

    test("writeTextFile - empty text truncates the file") {
        function "writeTextFile"
        when {
            function {
                """
                input[0] = 'e.txt'
                input[1] = ''
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == ": > 'e.txt'" }
            )
        }
    }

    test("setFragpipeParamValues - a key with no line fails") {
        function "setFragpipeParamValues"
        when {
            function {
                """
                input[0] = 'RPmax = 25\\n'
                input[1] = [Thread: 4]
                """
            }
        }
        then {
            assert function.failed
        }
    }

    test("requireFragpipeLicenseAgreement - agreement gives the record text") {
        function "requireFragpipeLicenseAgreement"
        when {
            function {
                """
                input[0] = [ext: [agree_fragpipe_license_agreement: true]]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'User agreed to FragPipe license agreement (agree_fragpipe_license_agreement=true)\n' }
            )
        }
    }

    test("requireFragpipeLicenseAgreement - no agreement fails") {
        function "requireFragpipeLicenseAgreement"
        when {
            function {
                """
                input[0] = [ext: [agree_fragpipe_license_agreement: null]]
                """
            }
        }
        then {
            assert function.failed
        }
    }

    test("fragpipeParamValue - value up to the tab comment, null when absent") {
        function "fragpipeParamValue"
        when {
            function {
                """
                input[0] = 'output_report_topN = 3\\t\\t# N\\noutput_report_topN_dia1 = 5\\nx=1 # c\\n'
                input[1] = 'x'
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == '1' }
            )
        }
    }

    // msfragger_pep_split.py:76-80 regexes and defaults
    test("msfraggerSplitMergeSettings - defaults for extension and max expect") {
        function "msfraggerSplitMergeSettings"
        when {
            function {
                """
                input[0] = 'output_report_topN = 1\\t\\t\\t# Reports top N\\noutput_report_topN_dia1 = 5\\n'
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == [output_file_extension: 'pepXML', output_report_topN: '1', output_max_expect: '50.0'] }
            )
        }
    }

    test("msfraggerSplitMergeSettings - values from the params, topN required") {
        function "msfraggerSplitMergeSettings"
        when {
            function {
                """
                input[0] = 'output_file_extension = pepXML\\noutput_report_topN = 2\\noutput_max_expect = 20\\t# max\\n'
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == [output_file_extension: 'pepXML', output_report_topN: '2', output_max_expect: '20'] }
            )
        }
    }

    test("msfraggerSplitMergeSettings - no output_report_topN fails") {
        function "msfraggerSplitMergeSettings"
        when {
            function {
                """
                input[0] = 'output_max_expect = 20\\n'
                """
            }
        }
        then {
            assert function.failed
        }
    }

    // CmdMsfragger.java:103-126 output names; .raw gets _uncalibrated.mzML; calibration with write_calibrated_mzml
    test("msfraggerStubFiles - ranked DIA pepXMLs, raw side files, two pepindex sets") {
        function "msfraggerStubFiles"
        when {
            function {
                """
                input[0] = ['a.raw', 'b.mzML']
                input[1] = 'db.fasta'
                input[2] = 'data_type = 1\\noutput_report_topN = 2\\ncalibrate_mass = 2\\nwrite_calibrated_mzml = 1\\noutput_format = tsv_pepXML_pin\\n'
                input[3] = 'out'
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == ['out/a_rank1.pepXML', 'out/a_rank2.pepXML', 'out/a.pin', 'out/a_scores_histogram.tsv', 'a_uncalibrated.mzML', 'a_calibrated.mzML',
                                             'out/b_rank1.pepXML', 'out/b_rank2.pepXML', 'out/b.pin', 'out/b_scores_histogram.tsv', 'b_calibrated.mzML',
                                             'db.fasta.1.pepindex', 'db.fasta.2.pepindex'] }
            )
        }
    }

    test("msfraggerStubFiles - DDA without calibration") {
        function "msfraggerStubFiles"
        when {
            function {
                """
                input[0] = 'run.mzML'
                input[1] = 'db.fasta'
                input[2] = 'data_type = 0\\t# DDA\\noutput_report_topN = 1\\ncalibrate_mass = 0\\nwrite_calibrated_mzml = 0\\noutput_format = tsv_pepXML_pin\\n'
                input[3] = 'out'
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == ['out/run.pepXML', 'out/run.pin', 'out/run_scores_histogram.tsv', 'db.fasta.1.pepindex'] }
            )
        }
    }

    // CmdMSBooster.java:151-212: IM keys moved after the workflow lines and ANDed with timsTOF, then runtime keys
    test("msboosterParamsText - IM keys off without timsTOF, keys in CmdMSBooster's order") {
        function "msboosterParamsText"
        when {
            function {
                """
                input[0] = 'useRT = true\\nuseIM = true\\nfindBestImModel = true\\nFragmentationType = auto\\nnumThreads = 8\\n'
                input[1] = false
                input[2] = 8
                input[3] = [diann: '/t/diann', unimod_obo: '/t/unimod.obo']
                input[4] = 'fragger.params'
                input[5] = ['a.pin', 'b.pin']
                input[6] = []  // no spectral library
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'numThreads = 8\nDiaNN = /t/diann\nuseRT = true\nuseIM = false\nfragger = {TASK_DIR}/fragger.params\nfindBestImModel = false\nFragmentationType = auto\nunimodObo = /t/unimod.obo\nmzmlDirectory = {TASK_DIR} \npinPepXMLDirectory = b.pin a.pin\n' }
            )
        }
    }

    test("msboosterParamsText - timsTOF keeps the workflow's IM values") {
        function "msboosterParamsText"
        when {
            function {
                """
                input[0] = 'useIM = true\\nfindBestImModel = false\\nnumThreads = 1\\n'
                input[1] = true
                input[2] = 1
                input[3] = [diann: 'd', unimod_obo: 'u']
                input[4] = 'f.params'
                input[5] = 'a.pin'
                input[6] = []  // no spectral library
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result.readLines().findAll { l -> l.startsWith('useIM') || l.startsWith('findBestIm') } == ['useIM = true', 'findBestImModel = false'] }
            )
        }
    }

    // CmdMSBooster.java:180-184: the three prediction files name the library when libraryPath is not empty
    test("msboosterParamsText - staged spectral library names spectraPredFile, RTPredFile and IMPredFile") {
        function "msboosterParamsText"
        when {
            function {
                """
                input[0] = 'useRT = true\\nuseIM = false\\nfindBestImModel = false\\nspectraPredFile = {SPECTRAL_LIBRARY}\\nRTPredFile = {SPECTRAL_LIBRARY}\\nIMPredFile = {SPECTRAL_LIBRARY}\\nnumThreads = 1\\n'
                input[1] = false
                input[2] = 1
                input[3] = [diann: 'd', unimod_obo: 'u']
                input[4] = 'f.params'
                input[5] = 'a.pin'
                input[6] = 'spectral_library/my_library.tsv'
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
