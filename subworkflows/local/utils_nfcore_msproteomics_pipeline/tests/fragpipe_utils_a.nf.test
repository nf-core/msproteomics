    // MSFragger writes the PIN only for an output_format that names it (FragPipe's tsv_pepXML for PeptideProphet)
    test("msfraggerStubFiles - output_format without pin writes no PIN") {
        function "msfraggerStubFiles"
        when {
            function {
                """
                input[0] = 'run.mzML'
                input[1] = 'db.fasta'
                input[2] = 'data_type = 0\\noutput_report_topN = 1\\ncalibrate_mass = 0\\nwrite_calibrated_mzml = 0\\noutput_format = tsv_pepXML\\n'
                input[3] = 'out'
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == ['out/run.pepXML', 'out/run_scores_histogram.tsv', 'db.fasta.1.pepindex'] }
            )
        }
    }

    test("msfraggerStubFiles - write_mzbin_all writes <stem>.mzBIN_all next to the LC-MS file") {
        function "msfraggerStubFiles"
        when {
            function {
                """
                input[0] = 'run.mzML'
                input[1] = 'db.fasta'
                input[2] = 'data_type = 0\\noutput_report_topN = 1\\ncalibrate_mass = 0\\nwrite_calibrated_mzml = 0\\nwrite_mzbin_all = 1\\noutput_format = tsv_pepXML_pin\\n'
                input[3] = 'out'
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
