                { assert function.success },
                { assert function.result == 'a=1\ndatabase.db-path={TASK_DIR}/db.fasta\n' }
            )
        }
    }

    // DIA-NN 1.8.2 Beta 8 aborts on a run path of 256+ characters: the task dir when it fits, else a short /tmp link
    test("diannInputDirLines - task dir when the paths fit, a short link for a long work dir") {
        function "diannInputDirLines"
        when {
            function {
                """
                input[0] = ['r' * 40 + '.mzML']
                """
            }
        }
        then {
            def run_in = { String dir ->
                new File(dir).mkdirs()
                def proc = ['bash', '-c', "cd '${dir}' && ${function.result}\necho \"\$DIANN_INPUT_DIR\"\nreadlink -f \"\$DIANN_INPUT_DIR\""].execute()
                def out = new StringBuffer(); proc.waitForProcessOutput(out, System.err)
                out.toString().trim().readLines()
            }
            def tmp = new File(System.getProperty('java.io.tmpdir')).canonicalPath
            def short_dir = new File(tmp, "short_${System.nanoTime()}").path
            def long_dir = new File(tmp, "long_${System.nanoTime()}/" + ('d' * 100) + '/' + ('e' * 100)).path
            def got_short = run_in.call(short_dir)
            def got_long = run_in.call(long_dir)
            assertAll(
                { assert function.success },
                { assert got_short[0] == short_dir },
                { assert got_long[0] ==~ /\/tmp\/diann\.\w{6}\/s/ },
                // the link points at the task dir while the script runs and is gone after it exits
                { assert got_long[1] == new File(long_dir).canonicalPath },
                { assert !new File(got_long[0]).parentFile.exists() },
                { assert got_long[0].length() + 1 + 45 <= 255 }
            )
        }
    }
    // CmdMsfragger.java:586, :628-630: --no-ptm-score-in-pin after the LC-MS files when Write sub mzML is on
    // (write_mzbin_all = 1 in the params, FragpipeRun.java:1481, CmdMsfragger.java:443)
    test("msfraggerTrailingArgv - --no-ptm-score-in-pin follows write_mzbin_all") {
        function "msfraggerTrailingArgv"
        when {
            function {
                """
                input[0] = 'write_mzbin_all = 1\\t\\t\\t# write mzBIN_all\\n'
                input[1] = [id: 'x']
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == ['--no-ptm-score-in-pin'] }
            )
        }
    }

