    // CmdTmtIntegrator / labelquant: no annotation file at all
    test("labelquantAnnotationText - no annotation fails like FragPipe") {
        function "labelquantAnnotationText"
        when {
            function {
                """
                input[0] = []
                input[1] = 'g1'
                """
            }
        }
        then {
            assertAll(
                { assert !function.success },
                { assert (function.stdout + function.stderr).any { l -> l.contains('Need to specify TMT file annotations in TMT-Integrator configuration.') } }
            )
        }
    }

    // CmdTmtIntegrator.java:144-170, 288-296: blank group at the work-dir top, named groups sorted
    test("tmtIntegratorCommands - blank group first, named groups by name") {
        function "tmtIntegratorCommands"
        when {
            function {
                """
                input[0] = [ file('input_results/workdir-root'), file('input_results/g2'), file('input_results/g1') ]
                input[1] = 'workdir-root'
                input[2] = 'tmtintegrator:\\n  channel_num: 10\\n  output: @TMT_REPORT_DIR@\\n  ref_tag: Bridge'
                input[3] = 'fragpipe'
                input[4] = 'tmt-report'
                input[5] = [ cpus: 4, ext: [ fragpipe_tools_dir: '/opt/fragpipe-24.0/tools' ] ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result.config == 'tmtintegrator:\n  channel_num: 10\n  output: {TASK_DIR}/fragpipe/tmt-report\n  ref_tag: Bridge' },
                { assert snapshot(function.result).match() }
            )
        }
    }

