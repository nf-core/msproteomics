// Unit tests for the command builders in fragpipe_utils_b.nf (FragPipe 24.0 argv the modules run).
// `task` is a map with the fields the builders read (cpus, memory, ext.fragpipe_tools_dir).

nextflow_function {

    name "Test Functions fragpipe_utils_b"
    script "../fragpipe_utils_b.nf"

    tag "subworkflows"
    tag "fragpipe_utils_b"
    tag "stub"

    test("shellQuote - one bash word, single quotes escaped") {
        function "shellQuote"
        when {
            function {
                """
                input[0] = "it's a/b c"
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == "'it'\\''s a/b c'" }
            )
        }
    }

    // a jar token (fragpipeJarLines finds the jar in the task) becomes its double-quoted variable inside the word
    test("shellQuote - jar tokens become shell variables") {
        function "shellQuote"
        when {
            function {
                """
                input[0] = '-Dlibs.thermo.dir={MSFRAGGER_DIR}/ext/thermo'
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == "'-Dlibs.thermo.dir='\"\${MSFRAGGER_DIR}\"'/ext/thermo'" }
            )
        }
    }

    // CmdPercolator.java:152-213 (Percolator) and :280-300 (PercolatorOutputToPepXML), MSBooster PIN, DDA
    test("percolatorCommands - MSBooster edited PIN, DDA") {
        function "percolatorCommands"
        when {
            function {
                """
                input[0] = [ id: 'C02', group: 'C02_1', data_type: 'DDA' ]
                input[1] = file('run_C02.pin')
                input[2] = file('run_C02_edited.pin')
                input[3] = [ file('run_C02.pepXML') ]
                input[4] = '--only-psms --no-terminate --post-processing-tdc'
                input[5] = ''
                input[6] = '0.5'
                input[7] = false
                input[8] = 'rev_'
                input[9] = false
                input[10] = []
                input[11] = [ cpus: 32, ext: [ fragpipe_tools_dir: '/opt/fragpipe-24.0/tools' ] ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert snapshot(function.result).match() }
            )
        }
    }

    // DDA+ rank pepXMLs share one basename; Crystal-C drops the _c suffix from PIN/TSV names (CmdPercolator.java:133-150)
    test("percolatorCommands - rank pepXMLs after Crystal-C, DIA") {
        function "percolatorCommands"
        when {
            function {
                """
                input[0] = [ id: 'A01', group: '', data_type: 'DIA' ]
                input[1] = file('run_A01.pin')
                input[2] = []
                input[3] = [ file('run_A01_c_rank1.pepXML'), file('run_A01_c_rank2.pepXML') ]
                input[4] = '--no-terminate'
                input[5] = '--seed 1'
                input[6] = '0.5'
                input[7] = true
                input[8] = 'rev_'
                input[9] = false
                input[10] = []
                input[11] = [ cpus: 8, ext: [ fragpipe_tools_dir: '/opt/fragpipe-24.0/tools/' ] ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                // blank group: FragPipe's work dir itself (checked here: nf-test snapshots a string naming an existing path as that path)
                { assert function.result.group_dir == '.' },
                { assert snapshot(function.result.findAll { k, _v -> k != 'group_dir' }).match() }
            )
        }
    }

    // CmdPercolator.java:180-183: --weights <stripped>_percolator.weights after the decoy pattern, before the PIN (Write sub mzML)
    test("percolatorCommands - Write sub mzML saves the weights") {
        function "percolatorCommands"
        when {
            function {
                """
                input[0] = [ id: 'C02', group: 'C02', data_type: 'DDA' ]
                input[1] = file('run_C02.pin')
                input[2] = []
                input[3] = [ file('run_C02.pepXML') ]
                input[4] = '--only-psms'
                input[5] = ''
                input[6] = '0.5'
                input[7] = false
                input[8] = 'rev_'
                input[9] = true
                input[10] = []
                input[11] = [ cpus: 4, ext: [ fragpipe_tools_dir: '/opt/fragpipe-24.0/tools' ] ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result.percolator.drop(1) == ['--only-psms', '--num-threads', '4',
                    '--results-psms', 'run_C02_percolator_target_psms.tsv', '--decoy-results-psms', 'run_C02_percolator_decoy_psms.tsv',
                    '--protein-decoy-pattern', 'rev_', '--weights', 'run_C02_percolator.weights', 'run_C02.pin'] }
            )
        }
    }

    // CmdPercolator.java:185-201: second pass, --init-weights <weights> --static --override after the decoy pattern, before the PIN
    test("percolatorCommands - second pass reads the first pass's weights") {
        function "percolatorCommands"
        when {
            function {
                """
                input[0] = [ id: 'C02', group: 'C02', data_type: 'DDA' ]
                input[1] = file('run_C02_sub.pin')
                input[2] = file('run_C02_sub_edited.pin')
                input[3] = [ file('run_C02_sub.pepXML') ]
                input[4] = '--only-psms'
                input[5] = ''
                input[6] = '0.5'
                input[7] = false
                input[8] = 'rev_'
                input[9] = false
                input[10] = file('run_C02_percolator.weights')
                input[11] = [ cpus: 4, ext: [ fragpipe_tools_dir: '/opt/fragpipe-24.0/tools' ] ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result.percolator.drop(1) == ['--only-psms', '--num-threads', '4',
                    '--results-psms', 'run_C02_sub_percolator_target_psms.tsv', '--decoy-results-psms', 'run_C02_sub_percolator_decoy_psms.tsv',
                    '--protein-decoy-pattern', 'rev_', '--init-weights', '{TASK_DIR}/weights/run_C02_percolator.weights', '--static', '--override', 'run_C02_sub_edited.pin'] }
            )
        }
    }

    // CmdPercolator.java:214,228 run in the pepXML's group dir: the searched file's group is required
    test("percolatorCommands - missing meta.group fails") {
        function "percolatorCommands"
        when {
            function {
                """
                input[0] = [ id: 'C02', data_type: 'DDA' ]
                input[1] = file('run_C02.pin')
                input[2] = []
                input[3] = [ file('run_C02.pepXML') ]
                input[4] = ''
                input[5] = ''
                input[6] = '0.5'
                input[7] = false
                input[8] = 'rev_'
                input[9] = false
                input[10] = []
                input[11] = [ cpus: 8, ext: [ fragpipe_tools_dir: '/opt/fragpipe-24.0/tools' ] ]
                """
            }
        }
        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains('meta.group is missing') } : (function.stdout + function.stderr).join('\n') }
            )
        }
    }

    // CmdPhilosopherAbacus.java:106-135: two groups, TMT plex
    test("abacusCommand - two groups with TMT plex") {
        function "abacusCommand"
        when {
            function {
                """
                input[0] = [ file('group_meta1'), file('group_meta2') ]
                input[1] = [ 'C02', 'D02' ]
                input[2] = [ file('combined.prot.xml') ]
                input[3] = '--razor --reprint --tag rev_ --protein --peptide'
                input[4] = ''
                input[5] = '16'
                input[6] = [ cpus: 32, memory: nextflow.util.MemoryUnit.of('64 GB'), ext: [ fragpipe_tools_dir: '/opt/fragpipe-24.0/tools' ] ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert snapshot(function.result).match() }
            )
        }
    }

    // CmdPhilosopherAbacus.java:76-87: one group is not a multi-experiment report
    test("abacusCommand - one group fails") {
        function "abacusCommand"
        when {
            function {
                """
                input[0] = [ file('group_meta1') ]
                input[1] = [ 'C02' ]
                input[2] = [ file('combined.prot.xml') ]
                input[3] = '--razor'
                input[4] = ''
                input[5] = '0'
                input[6] = [ cpus: 32, memory: nextflow.util.MemoryUnit.of('64 GB'), ext: [ fragpipe_tools_dir: '/opt/fragpipe-24.0/tools' ] ]
                """
            }
        }
        then {
            assertAll(
                { assert !function.success },
                { assert (function.stdout + function.stderr).any { l -> l.contains('requires more than one experiment/group') } }
            )
        }
    }

    // CmdIprophet.java:41-58: threads after the workflow options
    test("iprophetCommand - pepXMLs at their group locations") {
        function "iprophetCommand"
        when {
            function {
                """
                input[0] = [ file('interact-a.pep.xml'), file('interact-b.pep.xml') ]
