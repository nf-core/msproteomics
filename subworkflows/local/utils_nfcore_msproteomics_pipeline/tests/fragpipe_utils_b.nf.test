        }
    }

    // blank group is the work dir itself, no protXML
    test("philosopherFilterCommands - blank first group without protXML") {
        function "philosopherFilterCommands"
        when {
            function {
                """
                input[0] = [ id: 'all', group: '' ]
                input[1] = [ file('interact-a.pep.xml') ]
                input[2] = []
                input[3] = []
                input[4] = ''
                input[5] = '--psm 0.01'
                input[6] = ''
                input[7] = true
                input[8] = ''
                input[9] = file('human.fasta')
                input[10] = 'rev_'
                input[11] = [ cpus: 32, memory: nextflow.util.MemoryUnit.of('64 GB'), ext: [ fragpipe_tools_dir: '/opt/fragpipe-24.0/tools' ] ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                // '.' (the work dir) is checked here: nf-test snapshots a string naming an existing path as that path
                { assert function.result.group_dir == '.' },
                { assert function.result.first_dir == '.' },
                { assert snapshot(function.result.findAll { k, _v -> !(k in ['group_dir', 'first_dir']) }).match() }
            )
        }
    }

    // {WORKDIR} token becomes "$PWD" plus the quoted rest
    test("workdirWord - work-dir token") {
        function "workdirWord"
        when {
            function {
                """
                input[0] = '{WORKDIR}/C02'
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert snapshot(function.result).match() }
            )
        }
    }

    // GOMEMLIMIT is task memory minus 2 GiB (CmdPhilosopherFilter.java:117)
    test("goMemLimitGb - 64 GB task") {
        function "goMemLimitGb"
        when {
            function {
                """
                input[0] = [ cpus: 32, memory: nextflow.util.MemoryUnit.of('64 GB'), ext: [ fragpipe_tools_dir: '/opt/fragpipe-24.0/tools' ] ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert snapshot(function.result).match() }
            )
        }
    }

    // CmdPeptideProphet.java:86-150: per-file run dir and interact name
    test("peptideProphetCommands - per-file pepXML") {
        function "peptideProphetCommands"
        when {
            function {
                """
                input[0] = [ id: 'A01', group: 'A_1' ]
                input[1] = [ file('A01.pepXML') ]
                input[2] = [ 'A01_calibrated.mzML' ]
                input[3] = '--nonparam --expectscore --decoyprobs --ppm --accmass'
                input[4] = ''
                input[5] = false
                input[6] = file('human.fasta')
                input[7] = 'rev_'
                input[8] = [ cpus: 32, memory: nextflow.util.MemoryUnit.of('64 GB'), ext: [ fragpipe_tools_dir: '/opt/fragpipe-24.0/tools' ] ]
                """
