    }

    // CmdPeptideProphet.java: --combine over the group's pepXMLs
    test("peptideProphetCommands - combined group") {
        function "peptideProphetCommands"
        when {
            function {
                """
                input[0] = [ id: 'saliva', group: 'saliva' ]
                input[1] = [ file('a.pepXML'), file('b.pepXML') ]
                input[2] = [ 'a.mzML', 'b.mzML' ]
                input[3] = '--nonparam --expectscore'
                input[4] = ''
                input[5] = true
                input[6] = file('human.fasta')
                input[7] = 'rev_'
                input[8] = [ cpus: 32, memory: nextflow.util.MemoryUnit.of('64 GB'), ext: [ fragpipe_tools_dir: '/opt/fragpipe-24.0/tools' ] ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                // CmdPeptideProphet.java:316-332: --combine runs in the group dir, which holds interact.pep.xml
                { assert function.result.run_dir == 'saliva' && function.result.interact_path == 'saliva/interact.pep.xml' },
                // run_sub '.' names an existing path, which nf-test would snapshot as the md5 of every file under it
                { assert function.result.run_sub == '.' },
                { assert snapshot(function.result.findAll { key, _value -> key != 'run_sub' }).match() }
            )
        }
    }

    // InteractParser joins -a<pepXML dir> with a run's base name in a 256-byte buffer (measured: 206-character
    // dir + 48-character base name passes, 207 crashes): the lines keep <task>/<group> while the path fits and
    // read the group dir through a short /tmp link otherwise. Run in bash from a short and a long task dir.
    test("peptideProphetDirLines - group dir when it fits, /tmp link for a long one") {
        function "peptideProphetDirLines"
        when {
            function {
                """
                input[0] = 'G'
                input[1] = [ '20250101_LAB_INSTR_TMT18_SAMPLE_PLEX0001_C02s011.pepXML', 'a.mzML' ]
                """
            }
        }
        then {
            def run = { int len ->
                def base = java.nio.file.Files.createTempDirectory('ppdir').toFile()
                def dir = new File(base, 'x' * Math.max(1, len - base.path.length() - 1))
                new File(dir, 'G').mkdirs()
                def pb = new ProcessBuilder('bash', '-c', function.result + '\necho "$PP_GROUP_DIR"; [ "$PP_GROUP_DIR" = "$PWD/G" ] || (cd "$PP_GROUP_DIR" && pwd -P)')
                pb.directory(dir)
                def out = pb.start().text.readLines()
                base.deleteDir()
                [dir.path, out]
            }
            // task dir + '/G' + '/' + 55-character name: the group dir is linked from a 198-character task dir
            def fits = run(150)
            def longdir = run(230)
            assertAll(
                { assert function.success },
                { assert fits[1] == [fits[0] + '/G'] },
                { assert longdir[1].size() == 2 && longdir[1][0] ==~ /\/tmp\/pp\.[A-Za-z0-9]{6}\/g/ && longdir[1][1] == longdir[0] + '/G' },
                { assert snapshot(function.result).match() }
            )
        }
    }

    // CmdProteinProphet: --output combined is added when the options name none
    test("proteinProphetCommand - default output") {
        function "proteinProphetCommand"
        when {
            function {
                """
                input[0] = [ file('interact-a.pep.xml'), file('interact-b.pep.xml') ]
                input[1] = [ 'A01/interact-a.pep.xml', 'B01/interact-b.pep.xml' ]
                input[2] = '--maxppmdiff 2000000'
                input[3] = ''
                input[4] = [ cpus: 32, memory: nextflow.util.MemoryUnit.of('64 GB'), ext: [ fragpipe_tools_dir: '/opt/fragpipe-24.0/tools' ] ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert snapshot(function.result).match() }
            )
        }
    }

    // Combined PeptideProphet writes interact.pep.xml in every group (CmdPeptideProphet.java:302-336): the
    // pepXMLs are staged one per numbered directory and linked to their group locations
    test("proteinProphetCommand - groups that share the pepXML name interact.pep.xml") {
        function "proteinProphetCommand"
        when {
            function {
                """
                input[0] = [ file('a/interact.pep.xml'), file('b/interact.pep.xml') ]
                input[1] = [ 'A/interact.pep.xml', 'B/interact.pep.xml' ]
                input[2] = ''
                input[3] = ''
                input[4] = [ cpus: 32, memory: nextflow.util.MemoryUnit.of('64 GB'), ext: [ fragpipe_tools_dir: '/opt/fragpipe-24.0/tools' ] ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result.links == [['pepxml_inputs/1/interact.pep.xml', 'A/interact.pep.xml'], ['pepxml_inputs/2/interact.pep.xml', 'B/interact.pep.xml']] }
            )
        }
    }

