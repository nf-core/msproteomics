                """
                input[0] = 'stce'
                input[1] = [ 'run_calibrated.mzML' ]
                input[2] = [ '-b 20.0', '-f @TOOLS_DIR@/opair/Glycan_Mods/oxonium_filter.txt', '-t @THREADS@', '-r @FILELIST@', '-s @PSM@', '-o @OUTDIR@', '-z ' ]
                input[3] = []
                input[4] = [ cpus: 48, ext: [ fragpipe_tools_dir: '/opt/fragpipe-24.0/tools/' ] ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert snapshot(function.result).match() }
            )
        }
    }

    // CmdOPair.java:178-180: "-f " + the user's oxonium file, here its staged copy (not listed as a tools-dir file)
    test("opairCommands - user oxonium file names the staged copy") {
        function "opairCommands"
        when {
            function {
                """
                input[0] = 'stce'
                input[1] = [ 'run_calibrated.mzML' ]
                input[2] = [ '-b 20.0', '-f @OXONIUM_FILE@', '-m 0.05', '-t @THREADS@' ]
                input[3] = 'oxonium/my_oxonium.txt'
                input[4] = [ cpus: 48, ext: [ fragpipe_tools_dir: '/opt/fragpipe-24.0/tools/' ] ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result.argv == ['-b 20.0', '-f {TASK_DIR}/oxonium/my_oxonium.txt', '-m 0.05', '-t 48'] },
                { assert function.result.tool_files == [] },
                { assert snapshot(function.result).match() }
            )
        }
    }

