    // PtmshepherdPanel.toPtmsParamsMap (PtmshepherdPanel.java:229-232): the custom annotation file is staged, the config names the copy
    test("ptmShepherdCommands - custom annotation file fills @ANNOTATION_FILE@") {
        function "ptmShepherdCommands"
        when {
            function {
                """
                input[0] = [ ['workdir-root', 'dataset01'] ]
                input[1] = 'annotation_file = @ANNOTATION_FILE@\\nthreads = @THREADS@\\n'
                input[2] = 'human_decoys.fasta'
                input[3] = [ 'annotation/my_annotations.tsv' ]
                input[4] = [ cpus: 32, ext: [ fragpipe_tools_dir: '/opt/fragpipe-24.0/tools' ] ]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result.config.contains('annotation_file = {TASK_DIR}/annotation/my_annotations.tsv') },
                { assert snapshot(function.result).match() }
            )
        }
    }

    // CmdOPair.java:100-190: run-time tokens filled, tools-dir files listed for the existence check
    test("opairCommands - filelist and argv of one group") {
