                input[4] = 'C02'
                input[5] = '--sequential --picked --prot 0.01'
                input[6] = ''
                input[7] = false
                input[8] = '--msstats'
                input[9] = file('human.fasta')
                input[10] = 'rev_'
                input[11] = [ cpus: 32, memory: nextflow.util.MemoryUnit.of('64 GB'), ext: [ fragpipe_tools_dir: '/opt/fragpipe-24.0/tools' ] ]
