    test("taskDirWord - task-dir token") {
        function "taskDirWord"
        when {
            function {
                """
                input[0] = '{TASK_DIR}/fragpipe/g1/psm.tsv'
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == '"\$TASK_DIR"' + "'/fragpipe/g1/psm.tsv'" }
            )
        }
    }

    // here-doc body escaped ($, backticks, backslashes) with {TASK_DIR} expanded; printf keeps a missing final newline
    [['final newline', "'a \$x `y` \\\\\\\\ {TASK_DIR}/r\\n'"], ['no final newline', "'out: {TASK_DIR}/r'"]].each { label, text ->
        test("taskFileCommand - ${label}") {
            function "taskFileCommand"
            when {
                function {
                    """
                    input[0] = 'fragpipe/conf.yml'
                    input[1] = ${text}
                    """
                }
            }
            then {
                assertAll(
                    { assert function.success },
                    { assert snapshot(function.result).match() }
                )
            }
        }
    }

