    "tmtIntegratorCommands - blank group first, named groups by name": {
        "content": [
            {
                "config": "tmtintegrator:\n  channel_num: 10\n  output: {TASK_DIR}/fragpipe/tmt-report\n  ref_tag: Bridge",
                "psm_files": [
                    "{TASK_DIR}/fragpipe/psm.tsv",
                    "{TASK_DIR}/fragpipe/g1/psm.tsv",
                    "{TASK_DIR}/fragpipe/g2/psm.tsv"
                ],
                "stage": [
                    "mkdir -p 'fragpipe/tmt-report'",
                    "[ -f 'input_results/workdir-root/psm.tsv' ] || { echo 'ERROR: group directory workdir-root has no psm.tsv' >&2; exit 1; }",
                    "[ -f 'input_results/g1/psm.tsv' ] || { echo 'ERROR: group directory g1 has no psm.tsv' >&2; exit 1; }",
                    "[ -f 'input_results/g2/psm.tsv' ] || { echo 'ERROR: group directory g2 has no psm.tsv' >&2; exit 1; }",
                    "for f in 'input_results/workdir-root'/*; do ln -s \"$(realpath \"$f\")\" 'fragpipe'/\"$(basename \"$f\")\"; done",
                    "ln -s \"$(realpath 'input_results/g1')\" 'fragpipe/g1'",
                    "ln -s \"$(realpath 'input_results/g2')\" 'fragpipe/g2'"
                ],
                "jar": "/opt/fragpipe-24.0/tools/TMT-Integrator-6.1.3.jar",
                "fragpipe_version": "24.0"
            }
