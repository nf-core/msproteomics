    test("resolveFragPipeDatabase - --add_philosopher_decoy updates the plain iProteome fasta") {
        function "resolveFragPipeDatabase"
        when {
            function {
                """
                def store = "\${projectDir}/tests/fixtures/iproteomes"
                def entry = [organism: 'Mus musculus', fasta: 'test.fasta', fragpipe_fasta: 'test_decoys_contam.fasta', diann_speclib: 'test.predicted.speclib']
                def base = [proteome: 'mouse', iproteomes_base: store, iproteomes: [mouse: entry]]
                def resolved = [key: 'mouse', organism: 'Mus musculus', fasta: "\${store}/test.fasta", fragpipe_fasta: "\${store}/test_decoys_contam.fasta", diann_speclib: "\${store}/test.predicted.speclib"]
                def run = [enzyme: 'Trypsin/P', fixed_mods: null, variable_mods: 'Oxidation (M)', max_mods: 3, allowed_missed_cleavages: 1, min_peptide_length: 7, max_peptide_length: 30, min_precursor_charge: 1, max_precursor_charge: 4, met_excision: true, diann_min_pr_mz: 350, diann_max_pr_mz: 1050, diann_min_fr_mz: 200, diann_max_fr_mz: 1800, diann_library_mass_acc: 18, diann_library_ms1_acc: 5, additional_insilico_args: null, database: null, diann_speclib: null, proteome: 'mouse', iproteomes_base: store, add_philosopher_decoy: false, add_philosopher_contaminants: false]
                input[0] = resolved
                input[1] = run + [add_philosopher_decoy: true]
