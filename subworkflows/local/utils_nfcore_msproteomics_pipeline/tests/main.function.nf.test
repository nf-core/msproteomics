    // Second-pass workflow: db-path is FragPipe's databases folder (FragpipeRun.java:671-672); FragPipe stops
    // with "FASTA file path is empty or the file is corrupted" (TabDatabase.java:274-276, FragpipeRun.java:1046-1049)
    test("checkWorkflowDatabase - FragPipe's databases folder stops like FragPipe") {
        function "checkWorkflowDatabase"
        when {
            function {
                """
                def props = new Properties()
                props.setProperty('database.db-path', '/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/databases')
                input[0] = props
                input[1] = ['/data/human.fasta']
                """
            }
        }
        then {
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { l -> l.contains('FASTA file path is empty or the file is corrupted (database.db-path=/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/databases') } }
            )
        }
    }

    // desktop installs: C:\\...\\FragPipe-24.0\\databases, /opt/fragpipe/Databases/ - the last segment, any case
    [['windows', 'C:\\\\Users\\\\me\\\\FragPipe-24.0\\\\databases'], ['unix', '/opt/fragpipe/Databases/']].each { kind, db ->
        test("checkWorkflowDatabase - ${kind} databases folder stops") {
            function "checkWorkflowDatabase"
            when {
                function {
                    """
                    def props = new Properties()
                    props.setProperty('database.db-path', '${db}')
                    input[0] = props
                    input[1] = ['/data/human.fasta']
                    """
                }
            }
            then {
                assertAll(
                    { assert function.failed },
                    { assert (function.stdout + function.stderr).any { l -> l.contains('FASTA file path is empty or the file is corrupted') } }
                )
            }
        }
    }

    // --database replaces the workflow's db-path: renamed copies warn and pass
    test("checkWorkflowDatabase - another file name warns and passes") {
        function "checkWorkflowDatabase"
        when {
            function {
                """
                def props = new Properties()
                props.setProperty('database.db-path', '/repro/db/2024-04-06-decoys-reviewed-contam.fas.fas')
                input[0] = props
                input[1] = ['s3://bucket/renamed_human_decoys_contam.fasta']
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                // log.warn goes to the run log
                { assert new File("${outputDir}/../meta/nextflow.log").text.contains("names another file than the FASTA the run searches (renamed_human_decoys_contam.fasta); --database replaces the workflow's db-path") }
            )
        }
    }

    test("checkWorkflowDatabase - the same file name or an empty db-path passes") {
        function "checkWorkflowDatabase"
        when {
            function {
                """
                def same = new Properties()
                same.setProperty('database.db-path', 'C:\\\\fp\\\\human.fasta')
                def empty = new Properties()
                empty.setProperty('database.db-path', '')
                [same, empty].each { props -> checkWorkflowDatabase(props, ['s3://bucket/ref/human.fasta']) }
                input[0] = new Properties()
                input[1] = ['/data/human.fasta']
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert !new File("${outputDir}/../meta/nextflow.log").text.contains('names another file') }
            )
        }
    }
}
