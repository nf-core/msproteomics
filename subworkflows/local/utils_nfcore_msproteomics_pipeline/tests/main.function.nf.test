// Unit tests for the pipeline helper functions ported from lib/WorkflowUtils.groovy
// (lib/ Groovy classes are not resolved by `nextflow lint`, so the helpers live here).

nextflow_function {

    name "Test Functions utils_nfcore_msproteomics_pipeline"
    script "../main.nf"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "utils_nfcore_msproteomics_pipeline"
    tag "stub"

    test("convertOrganismToStandardName - aliases map to binomial names") {
        function "convertOrganismToStandardName"
        when {
            function {
                """
                input[0] = ' Mouse '
                """
            }
        }
        then {
            def store = "${projectDir}/tests/fixtures/iproteomes"
            assertAll(
                { assert function.success },
                { assert function.result == 'Mus musculus' },
                { assert snapshot(function.result).match() }
            )
        }
    }

    test("convertOrganismToStandardName - unknown organism is returned unchanged") {
        function "convertOrganismToStandardName"
        when {
            function {
                """
                input[0] = 'Erwinia carotovora'
                """
            }
        }
        then {
            def store = "${projectDir}/tests/fixtures/iproteomes"
            assertAll(
                { assert function.success },
                { assert function.result == 'Erwinia carotovora' },
                { assert snapshot(function.result).match() }
            )
        }
    }

    test("resolveProteome - no --proteome gives no entry") {
        function "resolveProteome"
        when {
            function {
                """
                def store = "\${projectDir}/tests/fixtures/iproteomes"
                def entry = [organism: 'Mus musculus', fasta: 'test.fasta', fragpipe_fasta: 'test_decoys_contam.fasta', diann_speclib: 'test.predicted.speclib']
                def base = [proteome: 'mouse', iproteomes_base: store, iproteomes: [mouse: entry]]
                def resolved = [key: 'mouse', organism: 'Mus musculus', fasta: "\${store}/test.fasta", fragpipe_fasta: "\${store}/test_decoys_contam.fasta", diann_speclib: "\${store}/test.predicted.speclib"]
                def run = [enzyme: 'Trypsin/P', fixed_mods: null, variable_mods: 'Oxidation (M)', max_mods: 3, allowed_missed_cleavages: 1, min_peptide_length: 7, max_peptide_length: 30, min_precursor_charge: 1, max_precursor_charge: 4, met_excision: true, diann_min_pr_mz: 350, diann_max_pr_mz: 1050, diann_min_fr_mz: 200, diann_max_fr_mz: 1800, diann_library_mass_acc: 18, diann_library_ms1_acc: 5, additional_insilico_args: null, database: null, diann_speclib: null, proteome: 'mouse', iproteomes_base: store, add_philosopher_decoy: false, add_philosopher_contaminants: false]
                input[0] = [proteome: null]
                """
            }
        }
        then {
            def store = "${projectDir}/tests/fixtures/iproteomes"
            assertAll(
                { assert function.success },
                { assert function.result == null }
            )
        }
    }

    test("resolveProteome - entry paths are joined with --iproteomes_base at run time") {
        function "resolveProteome"
        when {
            function {
                """
                def store = "\${projectDir}/tests/fixtures/iproteomes"
                def entry = [organism: 'Mus musculus', fasta: 'test.fasta', fragpipe_fasta: 'test_decoys_contam.fasta', diann_speclib: 'test.predicted.speclib']
                def base = [proteome: 'mouse', iproteomes_base: store, iproteomes: [mouse: entry]]
                def resolved = [key: 'mouse', organism: 'Mus musculus', fasta: "\${store}/test.fasta", fragpipe_fasta: "\${store}/test_decoys_contam.fasta", diann_speclib: "\${store}/test.predicted.speclib"]
                def run = [enzyme: 'Trypsin/P', fixed_mods: null, variable_mods: 'Oxidation (M)', max_mods: 3, allowed_missed_cleavages: 1, min_peptide_length: 7, max_peptide_length: 30, min_precursor_charge: 1, max_precursor_charge: 4, met_excision: true, diann_min_pr_mz: 350, diann_max_pr_mz: 1050, diann_min_fr_mz: 200, diann_max_fr_mz: 1800, diann_library_mass_acc: 18, diann_library_ms1_acc: 5, additional_insilico_args: null, database: null, diann_speclib: null, proteome: 'mouse', iproteomes_base: store, add_philosopher_decoy: false, add_philosopher_contaminants: false]
                input[0] = base
                """
            }
        }
        then {
            def store = "${projectDir}/tests/fixtures/iproteomes"
            assertAll(
                { assert function.success },
                { assert function.result.subMap(['fasta', 'fragpipe_fasta', 'diann_speclib']) == [fasta: "${store}/test.fasta", fragpipe_fasta: "${store}/test_decoys_contam.fasta", diann_speclib: "${store}/test.predicted.speclib"] }
            )
        }
    }

    test("resolveProteome - a trailing slash of --iproteomes_base is dropped") {
        function "resolveProteome"
        when {
            function {
                """
                def store = "\${projectDir}/tests/fixtures/iproteomes"
                def entry = [organism: 'Mus musculus', fasta: 'test.fasta', fragpipe_fasta: 'test_decoys_contam.fasta', diann_speclib: 'test.predicted.speclib']
                def base = [proteome: 'mouse', iproteomes_base: store, iproteomes: [mouse: entry]]
                def resolved = [key: 'mouse', organism: 'Mus musculus', fasta: "\${store}/test.fasta", fragpipe_fasta: "\${store}/test_decoys_contam.fasta", diann_speclib: "\${store}/test.predicted.speclib"]
                def run = [enzyme: 'Trypsin/P', fixed_mods: null, variable_mods: 'Oxidation (M)', max_mods: 3, allowed_missed_cleavages: 1, min_peptide_length: 7, max_peptide_length: 30, min_precursor_charge: 1, max_precursor_charge: 4, met_excision: true, diann_min_pr_mz: 350, diann_max_pr_mz: 1050, diann_min_fr_mz: 200, diann_max_fr_mz: 1800, diann_library_mass_acc: 18, diann_library_ms1_acc: 5, additional_insilico_args: null, database: null, diann_speclib: null, proteome: 'mouse', iproteomes_base: store, add_philosopher_decoy: false, add_philosopher_contaminants: false]
                input[0] = base + [iproteomes_base: store + '/']
                """
            }
        }
        then {
            def store = "${projectDir}/tests/fixtures/iproteomes"
            assertAll(
                { assert function.success },
                { assert function.result.fasta == "${store}/test.fasta" }
            )
        }
    }

    test("resolveProteome - a declared empty path stays empty for the index check") {
        function "resolveProteome"
        when {
            function {
                """
                def store = "\${projectDir}/tests/fixtures/iproteomes"
                def entry = [organism: 'Mus musculus', fasta: 'test.fasta', fragpipe_fasta: 'test_decoys_contam.fasta', diann_speclib: 'test.predicted.speclib']
                def base = [proteome: 'mouse', iproteomes_base: store, iproteomes: [mouse: entry]]
                def resolved = [key: 'mouse', organism: 'Mus musculus', fasta: "\${store}/test.fasta", fragpipe_fasta: "\${store}/test_decoys_contam.fasta", diann_speclib: "\${store}/test.predicted.speclib"]
                def run = [enzyme: 'Trypsin/P', fixed_mods: null, variable_mods: 'Oxidation (M)', max_mods: 3, allowed_missed_cleavages: 1, min_peptide_length: 7, max_peptide_length: 30, min_precursor_charge: 1, max_precursor_charge: 4, met_excision: true, diann_min_pr_mz: 350, diann_max_pr_mz: 1050, diann_min_fr_mz: 200, diann_max_fr_mz: 1800, diann_library_mass_acc: 18, diann_library_ms1_acc: 5, additional_insilico_args: null, database: null, diann_speclib: null, proteome: 'mouse', iproteomes_base: store, add_philosopher_decoy: false, add_philosopher_contaminants: false]
                input[0] = base + [iproteomes: [mouse: entry + [diann_speclib: '']]]
                """
            }
        }
        then {
            def store = "${projectDir}/tests/fixtures/iproteomes"
            assertAll(
                { assert function.success },
                { assert function.result.diann_speclib == '' }
            )
        }
    }

    test("resolveProteome - unknown --proteome fails") {
        function "resolveProteome"
        when {
            function {
                """
                def store = "\${projectDir}/tests/fixtures/iproteomes"
                def entry = [organism: 'Mus musculus', fasta: 'test.fasta', fragpipe_fasta: 'test_decoys_contam.fasta', diann_speclib: 'test.predicted.speclib']
                def base = [proteome: 'mouse', iproteomes_base: store, iproteomes: [mouse: entry]]
                def resolved = [key: 'mouse', organism: 'Mus musculus', fasta: "\${store}/test.fasta", fragpipe_fasta: "\${store}/test_decoys_contam.fasta", diann_speclib: "\${store}/test.predicted.speclib"]
                def run = [enzyme: 'Trypsin/P', fixed_mods: null, variable_mods: 'Oxidation (M)', max_mods: 3, allowed_missed_cleavages: 1, min_peptide_length: 7, max_peptide_length: 30, min_precursor_charge: 1, max_precursor_charge: 4, met_excision: true, diann_min_pr_mz: 350, diann_max_pr_mz: 1050, diann_min_fr_mz: 200, diann_max_fr_mz: 1800, diann_library_mass_acc: 18, diann_library_ms1_acc: 5, additional_insilico_args: null, database: null, diann_speclib: null, proteome: 'mouse', iproteomes_base: store, add_philosopher_decoy: false, add_philosopher_contaminants: false]
                input[0] = base + [proteome: 'rat']
                """
            }
        }
        then {
            def store = "${projectDir}/tests/fixtures/iproteomes"
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains("is not an iProteome") } }
            )
        }
    }

    test("resolveProteome - missing --iproteomes_base fails") {
        function "resolveProteome"
        when {
            function {
                """
                def store = "\${projectDir}/tests/fixtures/iproteomes"
                def entry = [organism: 'Mus musculus', fasta: 'test.fasta', fragpipe_fasta: 'test_decoys_contam.fasta', diann_speclib: 'test.predicted.speclib']
                def base = [proteome: 'mouse', iproteomes_base: store, iproteomes: [mouse: entry]]
                def resolved = [key: 'mouse', organism: 'Mus musculus', fasta: "\${store}/test.fasta", fragpipe_fasta: "\${store}/test_decoys_contam.fasta", diann_speclib: "\${store}/test.predicted.speclib"]
                def run = [enzyme: 'Trypsin/P', fixed_mods: null, variable_mods: 'Oxidation (M)', max_mods: 3, allowed_missed_cleavages: 1, min_peptide_length: 7, max_peptide_length: 30, min_precursor_charge: 1, max_precursor_charge: 4, met_excision: true, diann_min_pr_mz: 350, diann_max_pr_mz: 1050, diann_min_fr_mz: 200, diann_max_fr_mz: 1800, diann_library_mass_acc: 18, diann_library_ms1_acc: 5, additional_insilico_args: null, database: null, diann_speclib: null, proteome: 'mouse', iproteomes_base: store, add_philosopher_decoy: false, add_philosopher_contaminants: false]
                input[0] = base + [iproteomes_base: null]
                """
            }
        }
        then {
            def store = "${projectDir}/tests/fixtures/iproteomes"
            assertAll(
                { assert function.failed },
                { assert (function.stdout + function.stderr).any { line -> line.contains("needs --iproteomes_base") } }
            )
        }
    }

    test("resolveProteome - --iproteomes_ignore fails") {
        function "resolveProteome"
        when {
            function {
                """
                def store = "\${projectDir}/tests/fixtures/iproteomes"
