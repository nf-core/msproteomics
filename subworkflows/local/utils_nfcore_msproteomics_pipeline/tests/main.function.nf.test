    test("DIA-NN enzyme and modification flags equal quantms-utils 0.0.23 dianncfg") {
        function "diannLibrarySettings"
        when {
            function {
                """
                def run = [enzyme: 'Trypsin/P', fixed_mods: 'Carbamidomethyl (C)', variable_mods: 'Oxidation (M),Phospho (STY),Acetyl (Protein N-term)']
                input[0] = run
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result.enzyme == 'K*,R*' },
                { assert function.result.fixed_mods == '57.021464@C' },
                { assert function.result.variable_mods == '15.994915@M;42.010565@*n;79.966331@STY' }
            )
        }
    }

    test("DIA-NN cut rules equal quantms-utils 0.0.23 for Trypsin, Lys-C") {
        function "diannLibrarySettings"
        when {
            function {
                """
                input[0] = [enzyme: 'Trypsin', fixed_mods: null, variable_mods: null]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result.enzyme == '!*P,K*,R*' }
            )
        }
    }

    test("DIA-NN cut rule of Lys-C equals quantms-utils 0.0.23") {
        function "diannLibrarySettings"
        when {
            function {
                """
                input[0] = [enzyme: 'Lys-C', fixed_mods: null, variable_mods: null]
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result.enzyme == '!*P,K*' }
            )
        }
    }

    test("generateSdrfBookkeeping - fragpipe mode gives DDA JSON") {
        function "generateSdrfBookkeeping"
        when {
            function {
                """
                input[0] = [mode: 'fragpipe', precursor_mass_tolerance: 10, precursor_mass_tolerance_unit: 'ppm', fragment_mass_tolerance: 20, fragment_mass_tolerance_unit: 'ppm']
                input[1] = 'Mus musculus'
                """
            }
        }
        then {
            def store = "${projectDir}/tests/fixtures/iproteomes"
            assertAll(
                { assert function.success },
                { assert new groovy.json.JsonSlurper().parseText(function.result).acquisition_method == 'DDA' },
                { assert snapshot(function.result).match() }
            )
        }
    }

    test("getTmtLabelcheckWorkflow - TMT16 selects the 304 workflow") {
        function "getTmtLabelcheckWorkflow"
        when {
            function {
                """
                input[0] = 'tmt16'
                input[1] = '/pipeline'
                """
            }
        }
        then {
