nextflow_workflow {

    name "Test Subworkflow DIA_PROTEOMICS_ANALYSIS"
    script "../main.nf"
    workflow "DIA_PROTEOMICS_ANALYSIS"
    config "./nextflow.config"

    // Sorted "<process> (<tag>)" list of the DIA-NN analysis tasks in the trace.
    // The tag is meta.id = "<run id>_<fasta id>"; the experiment tasks have the experiment id.
    def diannTasks = { trace ->
        trace.tasks()
            .collect { task -> task.name.tokenize(':').last() }
            .findAll { name -> name =~ /^DIANN_(PRELIMINARYANALYSIS|ASSEMBLEEMPIRICALLIBRARY|INDIVIDUALANALYSIS|FINALQUANTIFICATION) / }
            .sort()
    }

    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/dia_proteomics_analysis"
    tag "diann"
    tag "quantmsutils/dianncfg"
    tag "quantmsutils/mzmlstatistics"
    tag "quantmsutils/diann2mztab"
    tag "proteomics"
    tag "dia_proteomics_analysis"
    tag "untar"

    test("proteomics - complete DIA analysis pipeline") {

        setup {
            run("UNTAR") {
                script "../../../../modules/nf-core/untar/main.nf"
                process {
                    """
                    input[0] = [
                        [id:'test_sample'],
                        file(params.modules_testdata_base_path + 'proteomics/diann/RD139_Narrow_UPS1_0_1fmol_inj1.mzML.tar.gz', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            workflow {
                """
                ch_input  = UNTAR.out.untar.map{ meta, dir ->
                    def mzmlFile = dir.resolve('RD139_Narrow_UPS1_0_1fmol_inj1.mzML')
                    [meta, mzmlFile, 'Trypsin', 'Carbamidomethyl (C)', 'Oxidation (M)', 20, 20, 'ppm', 'ppm']
                }
                ch_fasta = Channel.of(
                    [
                        [id:'ecoli'],
                        file(params.modules_testdata_base_path + 'proteomics/diann/REF_EColi_K12_UPS1_combined_subset_100.fasta', checkIfExists: true)
                    ]
                )
                ch_expdesign = Channel.of(
                    [
                        [id:'RD139_Narrow_UPS1_design'],
                        file(params.modules_testdata_base_path + 'proteomics/diann/RD139_Narrow_UPS1_design.tsv', checkIfExists: true)
                    ]
                )
                input[0] = ch_input
                input[1] = ch_fasta
                input[2] = ch_expdesign
                input[3] = [true, 1, 42]
                input[4] = 20
                input[5] = false
                input[6] = false
                input[7] = false
                input[8] = 1  // pg_level: 1 = protein groups
                input[9] = Channel.empty()
                input[10] = Channel.empty()
                input[11] = Channel.empty()
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(
                    sanitizeOutput(workflow.out, unstableKeys: ["diann_report", "out_triqler", "final_result", "mzml_statistics"])
                ).match() }
            )
        }
    }

    test("proteomics - library_run false skips library steps - stub") {

        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of(
                    [[id:'run_a', library_run:true], file(params.modules_testdata_base_path + 'proteomics/msspectra/HepG2_rep1_small.mzML', checkIfExists: true), 'Trypsin', 'Carbamidomethyl (C)', 'Oxidation (M)', 20, 20, 'ppm', 'ppm'],
                    [[id:'run_b'], file(params.modules_testdata_base_path + 'proteomics/msspectra/OVEMB150205_12.mzML', checkIfExists: true), 'Trypsin', 'Carbamidomethyl (C)', 'Oxidation (M)', 20, 20, 'ppm', 'ppm'],
                    [[id:'run_c', library_run:false], file(params.modules_testdata_base_path + 'proteomics/msspectra/peakpicker_tutorial_1.mzML', checkIfExists: true), 'Trypsin', 'Carbamidomethyl (C)', 'Oxidation (M)', 20, 20, 'ppm', 'ppm']
                )
                input[1] = Channel.of(
                    [
                        [id:'ecoli'],
                        file(params.modules_testdata_base_path + 'proteomics/diann/REF_EColi_K12_UPS1_combined_subset_100.fasta', checkIfExists: true)
                    ]
                )
                input[2] = Channel.of(
                    [
                        [id:'RD139_Narrow_UPS1_design'],
                        file(params.modules_testdata_base_path + 'proteomics/diann/RD139_Narrow_UPS1_design.tsv', checkIfExists: true)
                    ]
                )
                input[3] = [false, 1, 42]
                input[4] = 20
                input[5] = true
                input[6] = true
                input[7] = false
                input[8] = 1
                input[9] = Channel.empty()
                input[10] = Channel.empty()
                input[11] = Channel.empty()
                """
            }
        }

        then {
            def tasks = diannTasks(workflow.trace)
            assertAll(
                { assert workflow.success },
                { assert tasks.findAll { t -> t.startsWith('DIANN_PRELIMINARYANALYSIS ') } == [
                    'DIANN_PRELIMINARYANALYSIS (run_a_ecoli)',
                    'DIANN_PRELIMINARYANALYSIS (run_b_ecoli)'
                ] },
                { assert tasks.count { t -> t.startsWith('DIANN_ASSEMBLEEMPIRICALLIBRARY ') } == 1 },
                { assert tasks.findAll { t -> t.startsWith('DIANN_INDIVIDUALANALYSIS ') } == [
                    'DIANN_INDIVIDUALANALYSIS (run_a_ecoli)',
                    'DIANN_INDIVIDUALANALYSIS (run_b_ecoli)',
                    'DIANN_INDIVIDUALANALYSIS (run_c_ecoli)'
                ] },
                { assert tasks.count { t -> t.startsWith('DIANN_FINALQUANTIFICATION ') } == 1 },
                { assert workflow.out.diann_report.size() == 1 },
                { assert snapshot(tasks).match() }
            )
        }
    }

    test("proteomics - no library_run key uses all runs - stub") {

        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of(
                    [[id:'run_a'], file(params.modules_testdata_base_path + 'proteomics/msspectra/HepG2_rep1_small.mzML', checkIfExists: true), 'Trypsin', 'Carbamidomethyl (C)', 'Oxidation (M)', 20, 20, 'ppm', 'ppm'],
                    [[id:'run_b'], file(params.modules_testdata_base_path + 'proteomics/msspectra/OVEMB150205_12.mzML', checkIfExists: true), 'Trypsin', 'Carbamidomethyl (C)', 'Oxidation (M)', 20, 20, 'ppm', 'ppm'],
                    [[id:'run_c'], file(params.modules_testdata_base_path + 'proteomics/msspectra/peakpicker_tutorial_1.mzML', checkIfExists: true), 'Trypsin', 'Carbamidomethyl (C)', 'Oxidation (M)', 20, 20, 'ppm', 'ppm']
                )
                input[1] = Channel.of(
                    [
                        [id:'ecoli'],
                        file(params.modules_testdata_base_path + 'proteomics/diann/REF_EColi_K12_UPS1_combined_subset_100.fasta', checkIfExists: true)
                    ]
                )
                input[2] = Channel.of(
                    [
                        [id:'RD139_Narrow_UPS1_design'],
                        file(params.modules_testdata_base_path + 'proteomics/diann/RD139_Narrow_UPS1_design.tsv', checkIfExists: true)
                    ]
                )
                input[3] = [false, 1, 42]
                input[4] = 20
                input[5] = true
                input[6] = true
                input[7] = false
                input[8] = 1
                input[9] = Channel.empty()
                input[10] = Channel.empty()
                input[11] = Channel.empty()
                """
            }
        }

        then {
            def tasks = diannTasks(workflow.trace)
            assertAll(
                { assert workflow.success },
                { assert tasks.count { t -> t.startsWith('DIANN_PRELIMINARYANALYSIS ') } == 3 },
                { assert tasks.count { t -> t.startsWith('DIANN_ASSEMBLEEMPIRICALLIBRARY ') } == 1 },
                { assert tasks.count { t -> t.startsWith('DIANN_INDIVIDUALANALYSIS ') } == 3 },
                { assert tasks.count { t -> t.startsWith('DIANN_FINALQUANTIFICATION ') } == 1 },
                { assert workflow.out.diann_report.size() == 1 },
                { assert snapshot(tasks).match() }
            )
        }
    }

    test("proteomics - all runs library_run false fails - stub") {

        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of(
                    [[id:'run_a', library_run:false], file(params.modules_testdata_base_path + 'proteomics/msspectra/HepG2_rep1_small.mzML', checkIfExists: true), 'Trypsin', 'Carbamidomethyl (C)', 'Oxidation (M)', 20, 20, 'ppm', 'ppm'],
                    [[id:'run_b', library_run:false], file(params.modules_testdata_base_path + 'proteomics/msspectra/OVEMB150205_12.mzML', checkIfExists: true), 'Trypsin', 'Carbamidomethyl (C)', 'Oxidation (M)', 20, 20, 'ppm', 'ppm'],
                    [[id:'run_c', library_run:false], file(params.modules_testdata_base_path + 'proteomics/msspectra/peakpicker_tutorial_1.mzML', checkIfExists: true), 'Trypsin', 'Carbamidomethyl (C)', 'Oxidation (M)', 20, 20, 'ppm', 'ppm']
                )
                input[1] = Channel.of(
                    [
                        [id:'ecoli'],
                        file(params.modules_testdata_base_path + 'proteomics/diann/REF_EColi_K12_UPS1_combined_subset_100.fasta', checkIfExists: true)
                    ]
                )
                input[2] = Channel.of(
                    [
                        [id:'RD139_Narrow_UPS1_design'],
                        file(params.modules_testdata_base_path + 'proteomics/diann/RD139_Narrow_UPS1_design.tsv', checkIfExists: true)
                    ]
                )
                input[3] = [false, 1, 42]
                input[4] = 20
                input[5] = true
                input[6] = true
                input[7] = false
                input[8] = 1
                input[9] = Channel.empty()
                input[10] = Channel.empty()
                input[11] = Channel.empty()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains('no run with meta.library_run != false') } },
                { assert diannTasks(workflow.trace).findAll { t -> !t.startsWith('DIANN_INSILICOLIBRARYGENERATION') }.isEmpty() }
            )
        }
    }

}
