// Adds the resolved container to the task trace for tests/fragpipe_container.nf.test
// (default trace fields first: nf-test reads name/status/exit from the same trace).
trace.fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,process,container'
