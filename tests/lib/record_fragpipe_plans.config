/*
 * tests/lib/record_fragpipe_plans.nf.test: FRAGPIPEPLAN with the licensed image given at runtime
 * (FRAGPIPE_CONTAINER), each plan's FragPipe options as the stub test runs it (meta.ext_args).
 */

process {
    container      = System.getenv('FRAGPIPE_CONTAINER')
    resourceLimits = [cpus: 2, memory: 16.GB, time: 1.h]

    withName: 'FRAGPIPEPLAN' {
        cpus     = 2
        memory   = 16.GB
        ext.args      = { meta.ext_args }
        // a plan FragPipe refuses is recorded as its failed task (the refusal), the others still run
        errorStrategy = 'ignore'
    }
}
