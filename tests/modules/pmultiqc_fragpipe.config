// ext.args of PMULTIQC_FRAGPIPE (conf/modules.config) for the PMULTIQC process under test
process {
    withName: 'PMULTIQC' {
        ext.args = '--fragpipe-plugin --contaminant-affix CONT --cl-config "sp: {pmultiqc/tsv: {fn_re: \'^(psm|ion|combined_protein|combined_peptide|combined_ion)[.]tsv\\$\', num_lines: 0}}" --config ./results/multiqc_config.yml'
    }
}
