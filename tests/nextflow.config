/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
    Test data come from params.pipelines_testdata_base_path (nextflow.config).
    modules_testdata_base_path is the nf-core/modules test data used by the nf-core module tests.
*/

params {
    // Module and subworkflow tests never run PIPELINE_INITIALISATION; give the
    // reports and publishDir a real output directory (nf-test's outputDir).
    outdir = "${launchDir}/output"

    // conf/test.config (nf-test's default profile) turns on FragPipe's "Add decoys" database update
    // because its FASTA has no decoys; component tests choose the database update themselves.
    add_philosopher_decoy        = false
    add_philosopher_contaminants = false

    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners

// The parser refuses a workflow that runs MSBooster without a thread count (the bundled and fixture
// workflow files do not set workflow.threads); the pipeline passes --threads from params.fragpipe_threads
// in conf/modules.config, component tests pass it here.
process {
    // The CI runners' limits (conf/test.config's) for every test, also those that run their own profile
    // (e.g. test_tmtq): nf-test adds this file with -c, after all profiles. The test profile itself is not
    // appended after a test's profile, because the strict config parser (default since Nextflow 26.04)
    // applies profiles in command-line order (docs/config.mdx), so `test` would replace its params.
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]


    withName: 'PARSEFRAGPIPEWORKFLOW' {
        ext.args = '--threads 4'
    }
}
