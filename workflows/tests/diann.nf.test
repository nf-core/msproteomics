                mode            = 'diann'
                input           = ss.toString()
                database        = null
                proteome        = 'mouse'
                iproteomes_base = store
                outdir          = "$outputDir"
                iproteomes      = [mouse: entry.findAll { k, v -> k != 'diann_speclib' }]
            }
        }

        then {
            def scripts = taskScripts(outputDir)
            assertAll(
                { assert workflow.success },
                { assert scripts['DIANN_INSILICOLIBRARYGENERATION'].size() == 1 },
                { assert scripts['DIANN_INSILICOLIBRARYGENERATION'][0].contains('touch test_Trypsin_P__Oxidation__M_.predicted.speclib') : scripts['DIANN_INSILICOLIBRARYGENERATION'] }
            )
        }
    }

