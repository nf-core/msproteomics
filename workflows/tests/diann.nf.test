    test("--diann_speclib skips in-silico library generation") {
        options "-stub"
        tag "stub"

        when {
            params {
                def fixtures = "${baseDir}/tests/fixtures"
                def ss = new File("${outputDir}/samplesheet.csv")
                ss.parentFile.mkdirs()
                ss.text = new File("${fixtures}/samplesheets/dda_experiment_bioreplicate.csv").text.replace('${FIXTURES}', fixtures)
                def lib = new File("${outputDir}/prebuilt_lib.tsv")
                lib.text = "PrecursorMz\tProductMz\tLibraryIntensity\tModifiedPeptide\tPrecursorCharge\tProteinId\n"
                mode          = 'diann'
                input         = ss.toString()
                database      = "${fixtures}/test.fasta"
                diann_speclib = lib.toString()
                outdir        = "$outputDir"
            }
        }

        then {
            def scripts = taskScripts(outputDir)
            assertAll(
                { assert workflow.success },
                { assert !scripts.containsKey('QUANTMSUTILS_DIANNCFG') },
                { assert !scripts.containsKey('DIANN_INSILICOLIBRARYGENERATION') },
                { assert scripts['DIANN_PRELIMINARYANALYSIS'].size() == 4 },
                { assert scripts['DIANN_PRELIMINARYANALYSIS'].every { cmd -> cmd.contains('--lib prebuilt_lib.tsv') } : scripts['DIANN_PRELIMINARYANALYSIS'] },
                { assert scripts['DIANN_FINALQUANTIFICATION'].size() == 1 }
            )
        }
    }
}
