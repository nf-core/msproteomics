// qpx export of MSPROTEOMICS_DIANN (stub): QPXDIANN gets the final quantification's report,
// pg_matrix and log with the samplesheet SDRF, and publishes diann.* to <outdir>/qpx.
// conf/test.config (nf-test's profile) skips the export, so these tests turn it on.

nextflow_workflow {

    name "Test Workflow MSPROTEOMICS_DIANN - qpx export"
    script "../diann.nf"
    workflow "MSPROTEOMICS_DIANN"

    tag "workflows"
    tag "msproteomics_diann"
    tag "qpxdiann"

    // .command.sh of the single task of a process in this test run (via the trace file)
    def taskScript = { String output_dir, String process ->
        def line = new File("${output_dir}/../meta/trace.csv").readLines().drop(1).find { l -> l.split('\t')[3].endsWith(":${process}") || l.split('\t')[3].contains(":${process} ") }
        def (prefix, suffix) = line.split('\t')[1].tokenize('/')
        new File(new File("${output_dir}/../work", prefix).listFiles().find { d -> d.name.startsWith(suffix) }, '.command.sh').text
    }

    test("qpx export - QPXDIANN converts the final quantification") {
        options "-stub"
        tag "stub"

        when {
            params {
                def fixtures = "${baseDir}/tests/fixtures"
                def ss = new File("${outputDir}/samplesheet.csv")
                ss.parentFile.mkdirs()
                ss.text = new File("${fixtures}/samplesheets/dda_experiment_bioreplicate.csv").text.replace('${FIXTURES}', fixtures)
                mode            = 'diann'
                input           = ss.toString()
                database        = "${fixtures}/test.fasta"
                skip_qpx_export = false
                outdir          = "$outputDir"
            }
        }

        then {
            def script = taskScript(outputDir, 'QPXDIANN')
            def qpx = new File("${outputDir}/qpx").list().sort()
            assertAll(
                { assert workflow.success },
                { assert script.contains('--report-path diann_report.tsv') : script },
                { assert script.contains('--pg-matrix-path diann_report.pg_matrix.tsv') : script },
                { assert script.contains('--sdrf-file samplesheet.sdrf.tsv') : script },
                { assert script.contains('--output-prefix diann') : script },
                { assert script.contains('--qvalue-threshold 0.01') : script },
                { assert snapshot(qpx, workflow.trace.succeeded()*.name.collect { name -> name.replaceAll(/ \(.*\)$/, '') }.unique().sort()).match() }
            )
        }
    }

    test("qpx export - --skip_qpx_export runs no QPXDIANN") {
        options "-stub"
        tag "stub"

        when {
            params {
                def fixtures = "${baseDir}/tests/fixtures"
                def ss = new File("${outputDir}/samplesheet.csv")
                ss.parentFile.mkdirs()
                ss.text = new File("${fixtures}/samplesheets/dda_experiment_bioreplicate.csv").text.replace('${FIXTURES}', fixtures)
                mode            = 'diann'
                input           = ss.toString()
                database        = "${fixtures}/test.fasta"
                skip_qpx_export = true
                outdir          = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert !new File("${outputDir}/qpx").exists() },
                { assert snapshot(workflow.trace.succeeded()*.name.collect { name -> name.replaceAll(/ \(.*\)$/, '') }.unique().sort()).match() }
            )
        }
    }
}
