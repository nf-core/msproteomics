// --fragpipe_workflow has no default: a FragPipe run without it stops with an error, --tmt_mode quant included;
// only --tmt_mode labelcheck selects a shipped workflow, from --tmt_type (nf-core/msproteomics#2)
nextflow_workflow {

    name "Test Workflow MSPROTEOMICS_FRAGPIPE - default --fragpipe_workflow"
    script "../fragpipe.nf"
    workflow "MSPROTEOMICS_FRAGPIPE"

    tag "workflows"
    tag "msproteomics_fragpipe"
    tag "fragpipe_default_workflow"

    test("no --fragpipe_workflow fails") {
        tag "stub"
        options "-stub"

        when {
            params {
                def fixtures = "${baseDir}/tests/fixtures"
                def ss = new File("${outputDir}/samplesheet.csv")
                ss.parentFile.mkdirs()
                ss.text = new File("${fixtures}/samplesheets/dda_experiment_bioreplicate.csv").text.replace('${FIXTURES}', fixtures)
                input             = ss.toString()
                database          = "${fixtures}/test.fasta"
                fragpipe_workflow = null
                tmt_mode          = null
                outdir            = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.trace.tasks().size() == 0 },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains('--mode fragpipe requires --fragpipe_workflow') } : workflow.stdout }
            )
        }
    }

    test("--tmt_mode without --fragpipe_workflow fails") {
        tag "stub"
        options "-stub"

        when {
            params {
                def fixtures = "${baseDir}/tests/fixtures"
                def ss = new File("${outputDir}/samplesheet.csv")
                ss.parentFile.mkdirs()
                ss.text = new File("${fixtures}/samplesheets/dda_experiment_bioreplicate.csv").text.replace('${FIXTURES}', fixtures)
                input             = ss.toString()
                database          = "${fixtures}/test.fasta"
                fragpipe_workflow = null
                tmt_mode          = 'quant'
                outdir            = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.trace.tasks().size() == 0 },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains('--mode fragpipe requires --fragpipe_workflow') } : workflow.stdout }
            )
        }
    }
}
