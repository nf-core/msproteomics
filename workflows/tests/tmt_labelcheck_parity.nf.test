// FragPipe 24.0 parity acceptance test for MSPROTEOMICS_TMT_LABELCHECK.
// Every expectation is derived from FragPipe's source, cited per test.
//
// FragPipe source root (FP): FragPipe-GUI/src/main/java/org/nesvilab/fragpipe/
//
// Snapshots record workflow.out plus the sorted names of all succeeded tasks
// (process + tag), which fixes the per-group / per-file task layout.

nextflow_workflow {

    name "Test Workflow MSPROTEOMICS_TMT_LABELCHECK - FragPipe parity"
    script "../tmt_labelcheck.nf"
    workflow "MSPROTEOMICS_TMT_LABELCHECK"

    tag "workflows"
    tag "msproteomics_tmt_labelcheck"
    tag "parity"

    // FP/FragpipeRun.java:1258-1262 builds sharedLcmsFilesAll from the unique LC-MS file
    // table (one InputLcmsFile per file), so a per-channel samplesheet (one row per TMT channel)
    // still yields exactly one MSFragger search input per raw file.
    test("TMT per-channel samplesheet - one MSFRAGGER task per raw file") {
        options "-stub"
        tag "stub"

        when {
            params {
                def fixtures = "${baseDir}/tests/fixtures"
                def ss = new File("${outputDir}/samplesheet.csv")
                ss.parentFile.mkdirs()
                ss.text = new File("${fixtures}/samplesheets/tmt_per_channel_two_plex.csv").text.replace('${FIXTURES}', fixtures)
                input    = ss.toString()
                database = "${fixtures}/test.fasta"
                tmt_type = 'TMT10'
                tmt_mode = 'labelcheck'  // main.nf routes here only with --tmt_mode labelcheck
                // nf-test's default profile (conf/test.config) sets fragpipe_workflow, which the label check refuses
                fragpipe_workflow = null
                outdir   = "$outputDir"
            }
        }

        then {
            def msfragger_tasks = workflow.trace.tasks().findAll { it.name ==~ /.*:MSFRAGGER \(.*\)$/ }.collect { it.name }
            assertAll(
                { assert workflow.success },
                { assert msfragger_tasks.size() == 2 : "expected one MSFRAGGER task per raw file (2), got ${msfragger_tasks.size()}: ${msfragger_tasks}" },
                // FP/FragpipeRun.java:582-587 saves sdrf.tsv when workflow.misc.save-sdrf=true (default on, FP/tabs/TabRun.java:429-430;
                // assets/TMT-labelcheck-229.workflow omits the key)
                { assert new File("${outputDir}/fragpipe/sdrf.tsv").exists() },
                { assert snapshot(workflow.out, workflow.trace.succeeded().collect { task -> task.name }.sort()).match() }
            )
        }
    }
}
